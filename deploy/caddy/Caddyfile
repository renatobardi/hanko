# TLS automático para o domínio de HANKO_DOMAIN (profile "edge" do compose).
#
# Para HANKO_MODE=trusted (padrão): o Hanko não autentica humanos, então o basic_auth abaixo é a
# única barreira de quem chega pela internet. HANKO_EDGE_USER e HANKO_EDGE_PASSWORD_HASH
# são obrigatórios. Gere o hash com `caddy hash-password` (ver docs/RUNBOOK.md).
# Com HANKO_MODE=authenticated use Caddyfile.authenticated (HANKO_CADDYFILE no .env).
{$HANKO_DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$HANKO_EDGE_USER} {$HANKO_EDGE_PASSWORD_HASH}
	}

	# flush_interval -1: SSE (logs de run ao vivo) não pode ser bufferizado.
	reverse_proxy hanko:7420 {
		flush_interval -1
		# O Authorization do basic_auth é da borda; o Hanko só entende Bearer de run token.
		header_up -Authorization
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
