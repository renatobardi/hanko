# TLS automático para o domínio de HANKO_DOMAIN (profile "edge" do compose) com o Hanko em
# HANKO_MODE=authenticated: quem autentica é o próprio Hanko (login Firebase/local, sessão,
# API keys), então a borda NÃO usa basic_auth e repassa o Authorization (Bearer hk_… e run tokens).
# Selecione com HANKO_CADDYFILE=Caddyfile.authenticated no .env (ver docs/RUNBOOK.md §5).
{$HANKO_DOMAIN} {
	encode zstd gzip

	# flush_interval -1: SSE (logs de run ao vivo) não pode ser bufferizado.
	reverse_proxy hanko:7420 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
