package views

import (
	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

// Ambientes de execução (ADR-0037).

templ envFieldErr(vm EnvFormVM, field string) {
	if e := vm.FieldErr[field]; e != "" {
		<span class="err">{ e }</span>
	}
}

templ EnvProbeReport(p *ProbeVM) {
	<div id="probe-result" class="env-probe" aria-live="polite">
		if p != nil {
			<div class="env-probe-head">
				if p.OK {
					<span class="badge done">{ i18n.T(ctx, "Conexão ok") }</span>
				} else {
					<span class="badge danger">{ i18n.T(ctx, "Falhou") }</span>
				}
				if p.System != "" {
					<span class="mono muted">{ p.System }</span>
				}
				if p.When != "" {
					<span class="muted">{ p.When }</span>
				}
				if p.Duration != "" {
					<span class="faint">{ p.Duration }</span>
				}
			</div>
			if p.Error != "" {
				<div class="err">{ p.Error }</div>
			}
			<ul class="env-checks compact">
				for _, st := range p.Steps {
					@envCheckRow(EnvCheck{OK: st.OK, Label: st.Label, Detail: st.Detail})
				}
			</ul>
			for _, w := range p.Warnings {
				<p class="note warn-text">{ w }</p>
			}
		}
	</div>
}

templ envVarsField(vm EnvFormVM) {
	<div class="field">
		<label for="e-env">{ i18n.T(ctx, "Variáveis do harness no ambiente, uma por linha: NOME=valor") }</label>
		<textarea class="textarea mono" id="e-env" name="env" rows="3" spellcheck="false" autocomplete="off" placeholder="ANTHROPIC_API_KEY=..."></textarea>
		<span class="hint">{ i18n.T(ctx, "Os valores são segredos: ficam cifrados e nunca voltam para a tela. HANKO_*, PATH e HOME são reservados.") }</span>
		if len(vm.EnvNames) > 0 {
			<span class="hint">{ i18n.T(ctx, "Guardadas:") } <code>{ joinNames(vm.EnvNames) }</code></span>
		}
		@envFieldErr(vm, "env")
	</div>
	if vm.Edit {
		<div class="field">
			<label for="e-dropenv">{ i18n.T(ctx, "Remover variáveis (nomes separados por vírgula)") }</label>
			<input class="input mono" id="e-dropenv" name="drop_env" value={ vm.DropEnv } autocomplete="off" spellcheck="false"/>
		</div>
	}
}

templ EnvironmentForm(vm EnvFormVM) {
	<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.Action) } hx-boost="true" id="env-form">
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<input type="hidden" name="driver" value={ vm.Driver }/>
		<div class="form-grid">
			<div class="field">
				<label for="e-name">{ i18n.T(ctx, "Nome") }</label>
				<input class="input" id="e-name" name="name" value={ vm.Name } required maxlength="120"/>
				@envFieldErr(vm, "name")
			</div>
			<div class="field">
				<label for="e-desc">{ i18n.T(ctx, "Descrição") }</label>
				<input class="input" id="e-desc" name="description" value={ vm.Description } maxlength="500"/>
				@envFieldErr(vm, "description")
			</div>
		</div>
		if vm.Driver == "ssh" {
			<div class="form-grid">
				<div class="field">
					<label for="e-host">{ i18n.T(ctx, "Host") }</label>
					<input class="input mono" id="e-host" name="host" value={ vm.Host } maxlength="253" autocomplete="off" spellcheck="false" placeholder="build.exemplo.com"/>
					<span class="hint">{ i18n.T(ctx, "Precisa estar na lista do operador (HANKO_ENV_SSH_ALLOW_HOSTS).") }</span>
					@envFieldErr(vm, "host")
				</div>
				<div class="field">
					<label for="e-port">{ i18n.T(ctx, "Porta") }</label>
					<input class="input mono" id="e-port" name="port" value={ vm.Port } inputmode="numeric" maxlength="5" placeholder="22"/>
					@envFieldErr(vm, "port")
				</div>
				<div class="field">
					<label for="e-user">{ i18n.T(ctx, "Usuário") }</label>
					<input class="input mono" id="e-user" name="username" value={ vm.User } maxlength="32" autocomplete="off" spellcheck="false"/>
					@envFieldErr(vm, "username")
				</div>
				<div class="field">
					<label for="e-root">{ i18n.T(ctx, "Pasta remota") }</label>
					<input class="input mono" id="e-root" name="root" value={ vm.Root } maxlength="512" autocomplete="off" spellcheck="false" placeholder="/srv/hanko"/>
					<span class="hint">{ i18n.T(ctx, "Cada execução ganha uma cópia do workspace em <pasta>/<empresa>/<workspace>/<execução>.") }</span>
					@envFieldErr(vm, "remote_workspace_root")
				</div>
			</div>
			<div class="field">
				<label for="e-key">{ i18n.T(ctx, "Chave privada") }</label>
				<textarea class="textarea mono" id="e-key" name="private_key" rows="4" spellcheck="false" autocomplete="off" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
				<span class="hint">
					{ i18n.T(ctx, "Sem senha. Fica cifrada e nunca volta para a tela.") }
					if vm.KeySet {
						{ i18n.T(ctx, "Há uma chave guardada; em branco ela fica.") }
					}
				</span>
				@envFieldErr(vm, "private_key")
			</div>
			<div class="field">
				<label for="e-kh">known_hosts</label>
				<textarea class="textarea mono" id="e-kh" name="known_hosts" rows="3" spellcheck="false" autocomplete="off" placeholder="build.exemplo.com ssh-ed25519 AAAA...">{ vm.KnownHosts }</textarea>
				<span class="hint">{ i18n.T(ctx, "Obrigatório: as linhas com a chave do host (ssh-keyscan -H host). Uma chave desconhecida nunca é aceita.") }</span>
				@envFieldErr(vm, "known_hosts")
			</div>
		} else {
			<div class="form-grid">
				<div class="field">
					<label for="e-image">{ i18n.T(ctx, "Imagem") }</label>
					<input class="input mono" id="e-image" name="image" value={ vm.Image } maxlength="255" autocomplete="off" spellcheck="false" placeholder="ghcr.io/acme/agente@sha256:..."/>
					<span class="hint">{ i18n.T(ctx, "Prefira fixar por digest (@sha256:); com tag o conteúdo pode mudar entre execuções.") }</span>
					@envFieldErr(vm, "image")
				</div>
				<div class="field">
					<label for="e-net">{ i18n.T(ctx, "Rede") }</label>
					@Select("network", "e-net", vm.NetworkOptions, false)
					<span class="hint">{ i18n.T(ctx, "none isola por completo (sem MCP do Hanko nem API do modelo); bridge dá rede ao contêiner.") }</span>
					@envFieldErr(vm, "network")
				</div>
				<div class="field">
					<label for="e-mem">{ i18n.T(ctx, "Memória (MiB)") }</label>
					<input class="input mono" id="e-mem" name="memory" value={ vm.Memory } inputmode="numeric" placeholder="2048"/>
					@envFieldErr(vm, "memory_mib")
				</div>
				<div class="field">
					<label for="e-cpus">{ i18n.T(ctx, "CPUs") }</label>
					<input class="input mono" id="e-cpus" name="cpus" value={ vm.CPUs } inputmode="decimal" placeholder="2"/>
					@envFieldErr(vm, "cpus")
				</div>
				<div class="field">
					<label for="e-pids">{ i18n.T(ctx, "Processos (PIDs)") }</label>
					<input class="input mono" id="e-pids" name="pids" value={ vm.PIDs } inputmode="numeric" placeholder="512"/>
					@envFieldErr(vm, "pids_limit")
				</div>
			</div>
		}
		@envVarsField(vm)
		<div class="form-actions">
			<a class="btn ghost" href={ templ.SafeURL(vm.CancelHref) }>{ i18n.T(ctx, "Cancelar") }</a>
			if vm.ProbeAction != "" {
				<button class="btn outline" type="button" hx-post={ vm.ProbeAction } hx-include="#env-form" hx-target="#probe-result" hx-swap="outerHTML">
					@Icon("play")
					{ i18n.T(ctx, "Testar conexão") }
				</button>
			}
			<button class="btn primary" type="submit">
				if vm.Edit {
					{ i18n.T(ctx, "Salvar alterações") }
				} else {
					{ i18n.T(ctx, "Cadastrar ambiente") }
				}
			</button>
		</div>
		if vm.ProbeAction != "" {
			@EnvProbeReport(nil)
		}
	</form>
}

templ envRow(r EnvRow) {
	<tr class={ "row", templ.KV("is-off", r.Status == "archived") }>
		<td class="ttl">
			<span class="p-name">
				<span class="mini-avatar">@Icon(r.DriverIcon)</span>
				<span class="pn">
					<b><a href={ templ.SafeURL(r.Href) }>{ r.Name }</a></b>
					<span class="mono">{ r.Target }</span>
				</span>
			</span>
			if r.Description != "" {
				<div class="note">{ r.Description }</div>
			}
			if r.Unavailable != "" {
				<div class="note warn-text">{ r.Unavailable }</div>
			}
		</td>
		<td class="hide-sm"><span class="badge outline">{ r.Driver }</span></td>
		<td>
			@BadgeEl(r.Badge)
			if r.Default {
				<span class="badge soft">{ i18n.T(ctx, "Padrão") }</span>
			}
		</td>
		<td class="hide-sm muted">
			if r.HasProbe {
				if r.LastProbeOK {
					<span class="ok-text">{ i18n.T(ctx, "ok") }</span>
				} else {
					<span class="warn-text">{ i18n.T(ctx, "falhou") }</span>
				}
				{ " " + r.LastProbe }
			} else {
				{ i18n.T(ctx, "nunca testado") }
			}
		</td>
		<td class="hide-sm muted">{ i18n.Tf(ctx, "%d personas · %d em uso", r.Personas, r.InUse) }</td>
		<td class="act-col">
			if canAdmin(ctx) && r.TestAction != "" {
				<form method="post" action={ templ.SafeURL(r.TestAction) }>
					<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Testar") }</button>
				</form>
			}
		</td>
	</tr>
}

templ EnvironmentsHubPage(sh Shell, vm EnvHubVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Ambientes de execução"), i18n.T(ctx, "Onde as personas rodam: neste servidor, num host SSH ou num contêiner descartável por execução.")) {
			if sh.CanAdmin() {
				if vm.SSHOff == "" {
					<a class="btn outline" href={ templ.SafeURL(vm.NewSSHHref) }>
						@Icon("plus")
						{ i18n.T(ctx, "Ambiente SSH") }
					</a>
				}
				if vm.SandboxOff == "" {
					<a class="btn primary" href={ templ.SafeURL(vm.NewSandboxHref) }>
						@Icon("plus")
						{ i18n.T(ctx, "Sandbox") }
					</a>
				}
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<section class="card pad mb-6 env-default">
			<div class="card-head"><div><h2>{ i18n.T(ctx, "Ambiente padrão") }</h2><p class="sub">{ i18n.T(ctx, "Vale para as personas que não escolheram um ambiente próprio.") }</p></div></div>
			if canAdmin(ctx) {
				<form method="post" action={ templ.SafeURL(vm.DefaultAction) } class="inline-form">
					@Select("environment", "env-default", vm.DefaultOptions, false)
					<button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar padrão") }</button>
				</form>
			} else {
				for _, o := range vm.DefaultOptions {
					if o.Selected {
						<p><b>{ o.Label }</b></p>
					}
				}
			}
		</section>
		<div class="grid-2 items-start">
			<section class="card pad">
				<div class="card-head">
					<div><h2>{ i18n.T(ctx, "Local · este servidor") }</h2><p class="sub">{ i18n.T(ctx, "Roda neste servidor do Hanko.") } { i18n.Tf(ctx, "%d de %d verificações ok", vm.Local.OK, vm.Local.Total) }</p></div>
					if vm.Local.OK == vm.Local.Total {
						<span class="badge done">{ i18n.T(ctx, "Pronto") }</span>
					} else {
						<span class="badge danger">{ i18n.T(ctx, "Com pendências") }</span>
					}
				</div>
				<ul class="env-checks">
					for _, c := range vm.Local.Checks {
						@envCheckRow(c)
					}
				</ul>
			</section>
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Configuração") }</h2></div>
				<dl class="kv">
					for _, f := range vm.Local.Facts {
						<dt>{ f.K }</dt><dd>{ f.V }</dd>
					}
				</dl>
				<p class="muted mt-4 text-xs">{ i18n.T(ctx, "Os valores vêm das variáveis HANKO_* do servidor; mude no .env e reinicie.") }</p>
			</section>
		</div>
		<h2 class="side-h sec-h">{ i18n.T(ctx, "Ambientes remotos") }</h2>
		if vm.SSHOff != "" || vm.SandboxOff != "" {
			<ul class="env-checks compact mb-4">
				@envCheckRow(EnvCheck{OK: vm.SSHOff == "", Label: "SSH", Detail: dashOr(vm.SSHOff, i18n.T(ctx, "liberado pelo operador"))})
				@envCheckRow(EnvCheck{OK: vm.SandboxOff == "", Label: "Sandbox", Detail: dashOr(vm.SandboxOff, i18n.T(ctx, "liberado pelo operador"))})
			</ul>
		}
		if len(vm.Rows) == 0 {
			@EmptyCard("server", i18n.T(ctx, "Nenhum ambiente remoto."), i18n.T(ctx, "Cadastre um host SSH ou um sandbox para tirar as execuções deste servidor. O operador liga cada driver na configuração da instalação."), false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Ambiente") }</th>
							<th class="hide-sm">Driver</th>
							<th>{ i18n.T(ctx, "Estado") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Último teste") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Uso") }</th>
							<th class="act-col"></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							@envRow(r)
						}
					</tbody>
				</table>
			</div>
		}
		if len(vm.Archived) > 0 {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Arquivados") }</h2>
			<div class="table-wrap">
				<table class="table">
					<tbody>
						for _, r := range vm.Archived {
							@envRow(r)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ NewEnvironmentPage(sh Shell, vm EnvFormVM) {
	@Layout(sh) {
		if vm.Driver == "ssh" {
			@PageHead(i18n.T(ctx, "Novo ambiente SSH"), i18n.T(ctx, "O Hanko copia o workspace para o host, roda o harness lá pelo ssh do sistema e traz o trabalho de volta.")) {
			}
		} else {
			@PageHead(i18n.T(ctx, "Novo sandbox"), i18n.T(ctx, "Cada execução roda num contêiner descartável, sem privilégios, com o workspace montado e limites de memória, CPU e processos.")) {
			}
		}
		if len(vm.DriverTabs) > 0 {
			<div class="mb-6">@Tabs(vm.DriverTabs)</div>
		}
		if sh.CanAdmin() {
			@EnvironmentForm(vm)
		} else {
			@NeedRole(domain.MemberAdmin)
		}
	}
}

templ EnvironmentPage(sh Shell, vm EnvPageVM) {
	@Layout(sh) {
		<div class="mb-6">@Tabs(vm.Sections)</div>
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="flow-head">
			<div>
				<h1>{ vm.Name } @BadgeEl(vm.Badge)</h1>
				<p class="muted mt-2 text-sm">{ vm.DriverLabel } · <span class="mono">{ vm.Target }</span></p>
				if vm.Description != "" {
					<p class="mt-2">{ vm.Description }</p>
				}
			</div>
			<div class="flow-acts">
				if canAdmin(ctx) && !vm.Archived {
					<form method="post" action={ templ.SafeURL(vm.TestAction) } hx-post={ vm.TestAction } hx-target="#probe-result" hx-swap="outerHTML">
						<button class="btn primary" type="submit">
							@Icon("play")
							{ i18n.T(ctx, "Testar conexão") }
						</button>
					</form>
				}
			</div>
		</div>
		if vm.Unavailable != "" {
			@Alert("danger", vm.Unavailable)
		}
		for _, w := range vm.Warnings {
			@Alert("warn", w)
		}
		<div class="grid-2 items-start">
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Resumo") }</h2></div>
				<dl class="kv">
					for _, f := range vm.Facts {
						<dt>{ f.K }</dt><dd>{ f.V }</dd>
					}
				</dl>
			</section>
			<section class="card pad" id="teste">
				<div class="card-head"><div><h2>{ i18n.T(ctx, "Último teste de conexão") }</h2><p class="sub">{ i18n.T(ctx, "Sistema, pasta gravável e os binários git, claude e codex no alvo.") }</p></div></div>
				if vm.Probe == nil {
					<p class="muted">{ i18n.T(ctx, "Ainda não testado.") }</p>
				}
				@EnvProbeReport(vm.Probe)
			</section>
		</div>
		<h2 class="side-h sec-h">{ i18n.T(ctx, "Execuções recentes") }</h2>
		if len(vm.Leases) == 0 {
			@EmptyCard("activity", i18n.T(ctx, "Nenhuma execução usou este ambiente ainda."), i18n.T(ctx, "As execuções aparecem aqui com o diretório remoto e, quando falham, o motivo."), false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Quando") }</th>
							<th>{ i18n.T(ctx, "Execução") }</th>
							<th class="hide-sm">Persona</th>
							<th>{ i18n.T(ctx, "Estado") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Motivo") }</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range vm.Leases {
							<tr class="row">
								<td class="muted">{ l.When }</td>
								<td><a href={ templ.SafeURL(l.RunHref) }>{ l.Run }</a>
									if l.RemoteDir != "" {
										<div class="note mono">{ l.RemoteDir }</div>
									}
								</td>
								<td class="hide-sm">{ l.Persona }</td>
								<td>@BadgeEl(l.Badge)</td>
								<td class="hide-sm muted">{ l.Reason }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2 class="side-h sec-h">{ i18n.T(ctx, "Configuração") }</h2>
		if canAdmin(ctx) && !vm.Archived {
			@EnvironmentForm(vm.Form)
		} else if !canAdmin(ctx) {
			@NeedRole(domain.MemberAdmin)
		}
		if canAdmin(ctx) {
			<section class="card pad mt-6">
				if vm.Archived {
					<div class="card-head"><div><h2>{ i18n.T(ctx, "Ambiente arquivado") }</h2><p class="sub">{ i18n.T(ctx, "Nenhuma persona roda aqui. Reative para usar de novo.") }</p></div></div>
					<form method="post" action={ templ.SafeURL(vm.ReactivateAction) }>
						<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Reativar") }</button>
					</form>
				} else {
					<div class="card-head"><div><h2>{ i18n.T(ctx, "Arquivar ambiente") }</h2><p class="sub">{ i18n.T(ctx, "As execuções em andamento seguem até o fim; as próximas vão para o ambiente escolhido.") }</p></div></div>
					if len(vm.PersonaNames) > 0 {
						<p class="muted">{ i18n.T(ctx, "Personas neste ambiente:") } { joinNames(vm.PersonaNames) }</p>
					}
					<form method="post" action={ templ.SafeURL(vm.ArchiveAction) } class="inline-form" hx-confirm={ i18n.T(ctx, "Arquivar este ambiente?") }>
						<label for="env-move">{ i18n.T(ctx, "Mover as personas para o ambiente…") }</label>
						@Select("move_to", "env-move", vm.MoveOptions, true)
						<button class="btn outline sm danger" type="submit">{ i18n.T(ctx, "Arquivar") }</button>
					</form>
				}
			</section>
		}
	}
}

templ PersonaEnvironmentSlot(vm PersonaVM) {
	<div hx-get={ personaEnvHref(vm) } hx-trigger="load" hx-swap="outerHTML"></div>
}

templ PersonaEnvironmentCard(vm PersonaEnvVM) {
	<section class="card pad mt-6" id="ambiente">
		<div class="card-head"><div><h2>{ i18n.T(ctx, "Ambiente de execução") }</h2><p class="sub">{ i18n.T(ctx, "Onde as execuções desta persona rodam.") }</p></div><a class="more" href={ templ.SafeURL(vm.SettingsHref) }>{ i18n.T(ctx, "Ambientes") }</a></div>
		if vm.Notice != "" {
			<p class="note ok-text">{ vm.Notice }</p>
		}
		if vm.Error != "" {
			<div class="err">{ vm.Error }</div>
		}
		<p><b>{ vm.Current }</b> <span class="muted">{ vm.Source }</span></p>
		if canAdmin(ctx) {
			<form method="post" action={ templ.SafeURL(vm.Action) } hx-post={ vm.Action } hx-target="#ambiente" hx-swap="outerHTML" class="inline-form">
				@Select("environment", "p-env", vm.Options, true)
				<button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar ambiente") }</button>
			</form>
		} else {
			@NeedRole(domain.MemberAdmin)
		}
	</section>
}

templ RunEnvironmentRunSlot(vm RunVM) {
	<dt>{ i18n.T(ctx, "Ambiente") }</dt><dd hx-get={ runEnvHref(vm) } hx-trigger="load" hx-swap="innerHTML">{ i18n.T(ctx, "Local") }</dd>
}

templ RunEnvironmentValue(vm RunEnvVM) {
	if vm.Href != "" {
		<a href={ templ.SafeURL(vm.Href) }>{ vm.Label }</a>
	} else {
		{ vm.Label }
	}
	if vm.Badge != nil {
		{ " " }
		@BadgeEl(*vm.Badge)
	}
	if vm.RemoteDir != "" {
		<div class="note mono">{ vm.RemoteDir }</div>
	}
}

func dashOr(v, fallback string) string {
	if v == "" {
		return fallback
	}
	return v
}
