package views

import (
	"github.com/renatobardi/hanko/internal/i18n"
)

// Layout is the application shell: sidebar, topbar with breadcrumb and the primary action.
templ Layout(sh Shell) {
	<!DOCTYPE html>
	<html lang={ string(i18n.FromContext(ctx)) } if t := themeFrom(ctx); t != "" { data-theme={ t } }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ sh.Title } · Hanko</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			@pwaHead()
			<link rel="preload" href="/static/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ "/static/hanko.css?v=" + sh.Version }/>
			<script src={ "/static/vendor/htmx.min.js" } defer></script>
			<script src={ "/static/vendor/sse.min.js" } defer></script>
			<script src={ "/static/hanko.js?v=" + sh.Version } defer></script>
		</head>
		<body>
			<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu"/>
			<div class="app">
				<aside class="sidebar" id="sidebar">
					<a class="brand" href={ templ.SafeURL(sh.Base() + "/") }>
						@Mark(22)
						<span>Hanko</span>
					</a>
					@companySwitch(sh)
					<nav class="nav" aria-label={ i18n.T(ctx, "Principal") }>
						for _, g := range Nav {
							<div class="nav-group">
								if g.Label != "" {
									<div class="nav-label">{ i18n.T(ctx, g.Label) }</div>
								}
								for _, it := range g.Items {
									<a href={ templ.SafeURL(it.Href(sh.Base())) } aria-current?={ it.Key == sh.Active }>
										@Icon(it.Icon)
										<span>{ i18n.T(ctx, it.Label) }</span>
									</a>
								}
							</div>
						}
					</nav>
					@sidebarFoot(sh)
				</aside>
				<label class="scrim" for="nav-toggle"></label>
				<div class="main">
					<header class="topbar">
						<label class="icon-btn" for="nav-toggle" title={ i18n.T(ctx, "Alternar menu") }>
							@Icon("panel-left")
						</label>
						<nav class="crumbs" aria-label={ i18n.T(ctx, "Trilha") }>
							for i, c := range sh.Crumbs {
								if i > 0 {
									@Icon("chevron-right")
								}
								if i == len(sh.Crumbs)-1 {
									<span class="cur">{ c.Label }</span>
								} else {
									<a href={ templ.SafeURL(c.Href) } class="hide-sm">{ c.Label }</a>
								}
							}
						</nav>
						<span class="spacer"></span>
						if sh.Action != nil {
							<a class="btn primary" href={ templ.SafeURL(sh.Action.Href) }>
								if sh.Action.Icon != "" {
									@Icon(sh.Action.Icon)
								}
								{ sh.Action.Label }
							</a>
						}
					</header>
					<main class={ "content", templ.KV("flush", sh.Flush) } id="content">
						@archivedBanner(sh)
						<div id="flash" aria-live="polite"></div>
						{ children... }
					</main>
				</div>
			</div>
		</body>
	</html>
}

// Bare is a centered page without shell (onboarding, errors outside a company).
templ Bare(title, version string) {
	<!DOCTYPE html>
	<html lang={ string(i18n.FromContext(ctx)) } if t := themeFrom(ctx); t != "" { data-theme={ t } }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title } · Hanko</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			@pwaHead()
			<link rel="preload" href="/static/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ "/static/hanko.css?v=" + version }/>
			<script src="/static/vendor/htmx.min.js" defer></script>
			<script src={ "/static/hanko.js?v=" + version } defer></script>
		</head>
		<body>
			<div class="center-page">
				{ children... }
			</div>
		</body>
	</html>
}

// sidebarFoot is the user block at the bottom of the sidebar. With a signed-in user
// (authenticated mode) it is a menu with settings and sign-out; in trusted mode it
// shows the local owner.
templ sidebarFoot(sh Shell) {
	<div class="foot-prefs">
		@ThemeSwitch()
		@LangSwitch()
	</div>
	if u, ok := userFrom(ctx); ok {
		<details class="usermenu">
			<summary class="sidebar-foot">
				<span class="avatar-sq">{ initial(u.Name) }</span>
				<div class="me"><b>{ u.Name }</b><span>{ u.Email }</span>
					if r := RoleFrom(ctx); r != "" {
						<span class="role-tag" data-role={ string(r) }>{ roleBadge(ctx, r) }</span>
					}
				</div>
				<span class="gear">@Icon("chevron-down")</span>
			</summary>
			<div class="menu" role="menu">
				<a href={ templ.SafeURL(sh.Base() + "/configuracoes") } role="menuitem" aria-current?={ sh.Active == "configuracoes" }>
					@Icon("settings")
					<span>{ i18n.T(ctx, "Configurações") }</span>
				</a>
				<form method="post" action="/sair">
					<button type="submit" role="menuitem">
						@Icon("log-out")
						<span>{ i18n.T(ctx, "Sair") }</span>
					</button>
				</form>
			</div>
		</details>
	} else {
		<a class="sidebar-foot" href={ templ.SafeURL(sh.Base() + "/configuracoes") } aria-current?={ sh.Active == "configuracoes" } title={ i18n.T(ctx, "Configurações") }>
			<span class="avatar-sq">{ initial(i18n.T(ctx, sh.Owner)) }</span>
			<div class="me"><b>{ i18n.T(ctx, sh.Owner) }</b><span>{ i18n.T(ctx, "Owner · admin") }</span></div>
			<span class="gear">@Icon("settings")</span>
		</a>
	}
}

// ThemeSwitch is the light/dark toggle of the Kubo DS sidebar footer: a POST to /tema that stores the
// cookie ("Sistema" clears it and the page follows prefers-color-scheme again).
templ ThemeSwitch() {
	<form class="theme-switch" method="post" action="/tema" aria-label={ i18n.T(ctx, "Tema") }>
		<button type="submit" name="theme" value="light" title={ i18n.T(ctx, "Claro") } aria-label={ i18n.T(ctx, "Claro") } aria-current?={ themeFrom(ctx) == "light" }>@Icon("sun")</button>
		<button type="submit" name="theme" value="dark" title={ i18n.T(ctx, "Escuro") } aria-label={ i18n.T(ctx, "Escuro") } aria-current?={ themeFrom(ctx) == "dark" }>@Icon("moon")</button>
		<button type="submit" name="theme" value="system" title={ i18n.T(ctx, "Sistema") } aria-label={ i18n.T(ctx, "Sistema") } aria-current?={ themeFrom(ctx) == "" }>@Icon("monitor")</button>
	</form>
}

// LangSwitch is the discreet language toggle: a POST to /idioma that stores the cookie and
// comes back to the page the person was on.
templ LangSwitch() {
	<form class="lang-switch" method="post" action="/idioma" aria-label={ i18n.T(ctx, "Idioma") }>
		for _, l := range i18n.Langs {
			<button type="submit" name="lang" value={ string(l) } lang={ string(l) } title={ langName(l) } aria-current?={ l == i18n.FromContext(ctx) }>{ langCode(l) }</button>
		}
	</form>
}

func langCode(l i18n.Lang) string {
	if l == i18n.EN {
		return "EN"
	}
	return "PT"
}

// langName is the language's own name (never translated).
func langName(l i18n.Lang) string {
	if l == i18n.EN {
		return "English"
	}
	return "Português (Brasil)"
}

// companySwitch is the company selector at the top of the sidebar: the current company and a menu
// with the others (same section when it makes sense) and "Nova empresa".
templ companySwitch(sh Shell) {
	<details class="co-switch">
		<summary title={ i18n.T(ctx, "Trocar de empresa") }>
			<span class="avatar-sq">{ initial(sh.Company.Name) }</span>
			<span class="co-name">{ sh.Company.Name }</span>
			<span class="gear">@Icon("chevron-down")</span>
		</summary>
		<div class="menu" role="menu">
			for _, c := range switcherFrom(ctx).Companies {
				if c.Slug == sh.Company.Slug {
					<a href={ templ.SafeURL("/c/" + c.Slug + "/" + switcherFrom(ctx).Section) } role="menuitem" aria-current="true">
						@Icon("check")
						<span>{ c.Name }</span>
					</a>
				} else {
					<a href={ templ.SafeURL("/c/" + c.Slug + "/" + switcherFrom(ctx).Section) } role="menuitem">
						<span class="avatar-sq sm">{ initial(c.Name) }</span>
						<span>{ c.Name }</span>
					</a>
				}
			}
			<a href="/bem-vindo" role="menuitem" class="co-new">
				@Icon("plus")
				<span>{ i18n.T(ctx, "Nova empresa") }</span>
			</a>
		</div>
	</details>
}

// ModelDatalist is the suggestion list of model aliases (the CLI accepts them as is).
templ ModelDatalist(id string) {
	<datalist id={ id }>
		<option value="haiku"></option>
		<option value="sonnet"></option>
		<option value="opus"></option>
	</datalist>
}
