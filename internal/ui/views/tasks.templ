package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ TasksPage(sh Shell, vm TasksVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Tasks"), vm.Subtitle) {
		}
		if vm.Project != "" {
			<p class="filter-chip">
				<span class="chip soft">@Icon("layers") { i18n.T(ctx, "Projeto") } <a href={ templ.SafeURL(vm.ProjectHref) }>{ vm.ProjectName }</a></span>
				<a href={ templ.SafeURL(vm.ClearHref) }>{ i18n.T(ctx, "limpar filtro") }</a>
			</p>
		}
		if vm.Goal != "" {
			<p class="filter-chip">
				<span class="chip soft">@Icon("trending-up") { i18n.T(ctx, "Meta") } <a href={ templ.SafeURL(vm.GoalHref) }>{ vm.GoalTitle }</a></span>
				<a href={ templ.SafeURL(vm.GoalClear) }>{ i18n.T(ctx, "limpar filtro") }</a>
			</p>
		}
		<div class="toolbar">
			@Tabs(vm.Tabs)
			<span class="grow"></span>
			<form method="get" action={ templ.SafeURL(sh.Base() + "/tasks") } class="search" role="search">
				<input type="hidden" name="aba" value={ vm.Tab }/>
				if vm.Project != "" {
					<input type="hidden" name="projeto" value={ vm.Project }/>
				}
				if vm.Goal != "" {
					<input type="hidden" name="meta" value={ vm.Goal }/>
				}
				<input
					class="input"
					type="search"
					name="q"
					value={ vm.Query }
					placeholder={ i18n.T(ctx, "Buscar tasks...") }
					aria-label={ i18n.T(ctx, "Buscar tasks") }
					hx-get={ sh.Base() + "/tasks" }
					hx-include="[name='aba'], [name='projeto'], [name='meta']"
					hx-trigger="input changed delay:300ms, search"
					hx-target="#tasks-list"
					hx-swap="outerHTML"
					hx-push-url="false"
				/>
			</form>
		</div>
		@TaskTable(vm)
	}
}

// ---- task detail ----

templ TaskPage(sh Shell, vm TaskVM, base string) {
	@Layout(sh) {
		<div class="detail">
			<div class="detail-main">
				<div class="eyebrow">
					<span class="mono">{ vm.Key }</span>
					if vm.ProjectName != "" {
						<span>·</span>
						<span>{ i18n.T(ctx, "Projeto") } <a href={ templ.SafeURL(vm.ProjectHref) }>{ vm.ProjectName }</a></span>
					}
					<span>·</span>
					<span>{ i18n.T(ctx, "criada") } { vm.Created }</span>
				</div>
				<h1>{ vm.Title }</h1>
				@TaskChips(vm, false)
				if vm.Notice != "" {
					<div style="margin-top:16px">@Alert("warn", vm.Notice)</div>
				}
				if vm.Error != "" {
					<div style="margin-top:16px">@Alert("danger", vm.Error)</div>
				}
				for _, g := range vm.Gates {
					@GateBanner(g)
				}
				<div class="brief" style="margin-top:20px">
					<div class="side-h">{ i18n.T(ctx, "Pedido") }</div>
					if vm.HasDescription {
						@AnchorBox(AnchorBoxVM{API: vm.IslandAPI, TaskKey: vm.TaskKey, Target: "task_description", Doc: vm.DescDoc, Anchors: vm.DescAnchors, CanComment: canWrite(ctx), Msgs: vm.AnchorMsgs}) {
							<div class="md">@templ.Raw(string(vm.Description))</div>
						}
					} else {
						<p class="muted">{ i18n.T(ctx, "Sem descrição.") }</p>
					}
				</div>
				<h2 class="side-h" style="margin:28px 0 14px">{ i18n.T(ctx, "Conversa") }</h2>
				@Thread(vm, base)
				if vm.ActiveRun != nil {
					<div class="run-sep" style="margin-bottom:16px">
						<span>
							{ i18n.T(ctx, "Execução") } <span class="mono">{ vm.ActiveRun.Short }</span> { i18n.T(ctx, "em andamento") } ·
							<a href={ templ.SafeURL(vm.ActiveRun.Href) } style="text-decoration:underline;text-underline-offset:2px;color:var(--foreground)">{ i18n.T(ctx, "Inspecionar") }</a>
						</span>
					</div>
				}
				@CommentForm(vm, base)
			</div>
			@TaskSide(vm, base)
		</div>
	}
}

templ TaskChips(vm TaskVM, oob bool) {
	<div id="task-chips" class="chips" style="margin-top:2px" hx-swap-oob={ oobAttr(oob) }>
		@BadgeEl(vm.Badge)
		<span class="chip">@PrioIcon(vm.Priority, vm.PriorityLabel)<span>{ vm.PriorityLabel }</span></span>
		if vm.PersonaName != "" {
			<a class="chip" href={ templ.SafeURL(vm.PersonaHref) }>@Icon("bot")<span>{ vm.PersonaName }</span></a>
		} else {
			<span class="chip soft">{ i18n.T(ctx, "Sem dono") }</span>
		}
	</div>
}

templ Thread(vm TaskVM, base string) {
	<div id="thread" class="thread" aria-live="polite">
		if len(vm.Thread) == 0 {
			<p class="thread-empty">{ i18n.T(ctx, "Nenhum comentário ainda. Escreva abaixo para orientar a persona.") }</p>
		}
		for _, m := range vm.Thread {
			if m.Human {
				<div class="msg me">
					<div class="bubble">
						@MsgQuote(m)
						<div class="md">@templ.Raw(string(m.Body))</div>
					</div>
					<div class="meta"><span>{ i18n.T(ctx, "Você ·") } <time class="mono">{ m.When }</time></span></div>
				</div>
			} else {
				<div class="msg">
					<span class="mini-avatar">@Icon("bot")</span>
					<div>
						<div class="meta"><b>{ m.Author }</b><time class="mono">{ m.When }</time>
							if m.RunHref != "" {
								<a href={ templ.SafeURL(m.RunHref) } style="text-decoration:underline">{ i18n.T(ctx, "execução") }</a>
							}
						</div>
						@MsgQuote(m)
						<div class="body md">@templ.Raw(string(m.Body))</div>
					</div>
				</div>
			}
		}
	</div>
}

// MsgQuote shows the passage an anchored comment is about, and flags a lost anchor.
templ MsgQuote(m Msg) {
	if m.Quote != "" {
		<blockquote class={ "msg-quote", templ.KV("is-lost", m.QuoteLost) }>
			{ m.Quote }
			if m.QuoteLost {
				<span class="chip soft">{ i18n.T(ctx, "âncora perdida") }</span>
			}
		</blockquote>
	}
}

templ CommentForm(vm TaskVM, base string) {
	if !canWrite(ctx) {
		<p class="composer-ro">@NeedRole(domain.MemberMember)</p>
	} else {
		<form
			class="composer"
			method="post"
			action={ templ.SafeURL(base + "/tasks/" + vm.Key + "/comentarios") }
			hx-post={ base + "/tasks/" + vm.Key + "/comentarios" }
			hx-target="#thread"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful){this.reset();}"
		>
			<textarea name="body" required placeholder={ i18n.T(ctx, "Escreva um comentário (markdown). Fica na fila se a persona estiver ocupada.") } aria-label={ i18n.T(ctx, "Comentário") }>{ vm.Draft }</textarea>
			<div class="row">
				<span class="hint">{ i18n.T(ctx, "Markdown · HTML é escapado") }</span>
				<button type="submit" class="btn primary sm">
					@Icon("send")
					{ i18n.T(ctx, "Comentar") }
				</button>
			</div>
		</form>
	}
}

templ TaskSide(vm TaskVM, base string) {
	<aside class="detail-side" id="task-side">
		<form
			class="side-sec"
			id="task-props"
			method="post"
			action={ templ.SafeURL(base + "/tasks/" + vm.Key) }
			hx-post={ base + "/tasks/" + vm.Key }
			hx-trigger="change"
			hx-target="#task-side"
			hx-swap="outerHTML"
		>
			<div class="side-h">{ i18n.T(ctx, "Propriedades") }</div>
			<fieldset class="props-fs" disabled?={ !canWrite(ctx) }>
			<div class="props">
				<label class="prop"><span>{ i18n.T(ctx, "Status") }</span>@Select("status", "f-status", vm.StatusOptions, true)</label>
				<label class="prop"><span>{ i18n.T(ctx, "Prioridade") }</span>@Select("priority", "f-priority", vm.PriorityOptions, true)</label>
				<label class="prop"><span>Persona</span>@Select("persona", "f-persona", vm.PersonaOptions, true)</label>
				<label class="prop"><span>{ i18n.T(ctx, "Projeto") }</span>@Select("project", "f-project", vm.ProjectOptions, true)</label>
				if len(vm.GoalOptions) > 1 {
					<label class="prop"><span>{ i18n.T(ctx, "Meta") }</span>@Select("goal", "f-goal", vm.GoalOptions, true)</label>
				}
				<div class="prop"><span>{ i18n.T(ctx, "Criada") }</span><span class="mono" style="font-size:12.5px">{ vm.Created }</span></div>
				<div class="prop"><span>{ i18n.T(ctx, "Atualizada") }</span><span class="mono" style="font-size:12.5px">{ vm.Updated }</span></div>
			</div>
			</fieldset>
			if !canWrite(ctx) {
				@NeedRole(domain.MemberMember)
			}
			<noscript><button class="btn sm" type="submit" style="margin-top:12px">{ i18n.T(ctx, "Salvar") }</button></noscript>
		</form>
		<div class="side-sec">
			<div class="side-h">{ i18n.T(ctx, "Custo") }</div>
			<div class="prop"><span>{ i18n.T(ctx, "Esta task") }</span><span class="mono" style="text-align:right">{ vm.Cost }</span></div>
			if vm.Model != "" {
				<div class="prop"><span>{ i18n.T(ctx, "Modelo (manual)") }</span><span class="mono" style="text-align:right">{ vm.Model }</span></div>
			}
		</div>
		<div class="side-sec">
			<div class="side-h" style="display:flex;justify-content:space-between"><span>{ i18n.T(ctx, "Artefatos") }</span><a href={ templ.SafeURL(vm.ArtifactsHref) } style="text-transform:none;letter-spacing:0;font-weight:400">{ i18n.T(ctx, "Ver todos") }</a></div>
			@ArtifactMiniList(vm.Artifacts, "")
		</div>
		<div class="side-sec">
			<div class="side-h" style="display:flex;justify-content:space-between"><span>{ i18n.T(ctx, "Execuções") }</span><a href={ templ.SafeURL(base + "/execucoes") } style="text-transform:none;letter-spacing:0;font-weight:400">{ i18n.T(ctx, "Ver todas") }</a></div>
			if len(vm.Runs) == 0 {
				<p class="muted" style="font-size:13px">{ i18n.T(ctx, "Nenhuma execução ainda.") }</p>
			}
			for _, r := range vm.Runs {
				<a class="side-run" href={ templ.SafeURL(r.Href) }>
					<span class={ "dot", r.Dot }></span>
					if r.Name != "" {
						<span title={ r.Short }>{ r.Name }</span>
					} else {
						<span class="mono">{ r.Short }</span>
					}
					<span>{ r.Label }</span>
					<span class="d mono">{ r.When }</span>
				</a>
			}
			if vm.CanWake && canWrite(ctx) {
				<form method="post" action={ templ.SafeURL(base + "/tasks/" + vm.Key + "/acordar") } hx-post={ base + "/tasks/" + vm.Key + "/acordar" } hx-swap="none" style="margin-top:12px">
					<button class="btn outline sm block" type="submit">@Icon("zap")
{ " " + i18n.T(ctx, "Acordar") + " " + vm.PersonaName }</button>
				</form>
			}
		</div>
	</aside>
}

// ---- new task ----

templ NewTaskPage(sh Shell, vm NewTaskVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Nova task"), i18n.T(ctx, "Descreva o pedido; se atribuir a uma persona, ela é acordada na hora.")) {
		}
		if sh.CanWrite() {
			<form class="card pad form-card" method="post" action={ templ.SafeURL(sh.Base() + "/tasks/nova") } hx-boost="true">
				if vm.Error != "" {
					@Alert("danger", vm.Error)
				}
				<div class="field">
					<label for="t-title">{ i18n.T(ctx, "Título") }</label>
					<input class="input" id="t-title" name="title" value={ vm.Title } required maxlength="200" placeholder={ i18n.T(ctx, "Ex.: Docslide: AI-first SDLC no banco") } autofocus/>
					if e := vm.FieldErr["title"]; e != "" {
						<span class="err">{ e }</span>
					}
				</div>
				<div class="field">
					<label for="t-desc">{ i18n.T(ctx, "Descrição") }</label>
					<textarea class="textarea" id="t-desc" name="description" rows="8" placeholder={ i18n.T(ctx, "O que precisa ser feito, contexto e critério de pronto. Markdown.") }>{ vm.Description }</textarea>
					<span class="hint">{ i18n.T(ctx, "Markdown. HTML é escapado.") }</span>
				</div>
				<div class="form-grid">
					<div class="field">
						<label for="t-persona">Persona</label>
						@Select("persona", "t-persona", vm.PersonaOptions, false)
					</div>
					<div class="field">
						<label for="t-prio">{ i18n.T(ctx, "Prioridade") }</label>
						@Select("priority", "t-prio", vm.PriorityOptions, false)
					</div>
					<div class="field">
						<label for="t-status">{ i18n.T(ctx, "Status inicial") }</label>
						@Select("status", "t-status", vm.StatusOptions, false)
					</div>
					if len(vm.ProjectOptions) > 1 {
						<div class="field">
							<label for="t-proj">{ i18n.T(ctx, "Projeto") }</label>
							@Select("project", "t-proj", vm.ProjectOptions, false)
						</div>
					}
					if len(vm.GoalOptions) > 1 {
						<div class="field">
							<label for="t-goal">{ i18n.T(ctx, "Meta") }</label>
							@Select("goal", "t-goal", vm.GoalOptions, false)
						</div>
					}
				</div>
				<div class="field">
					<label for="t-model">{ i18n.T(ctx, "Modelo (opcional)") }</label>
					<input class="input" id="t-model" name="model" value={ vm.Model } placeholder={ i18n.T(ctx, "vazio = o modelo da persona") } list="t-models" autocomplete="off"/>
					@ModelDatalist("t-models")
					<span class="hint">{ i18n.T(ctx, "Escolha manual: vence o modelo da persona nas execuções desta task.") }</span>
				</div>
				<div class="form-actions">
					<a class="btn ghost" href={ templ.SafeURL(sh.Base() + "/tasks") }>{ i18n.T(ctx, "Cancelar") }</a>
					<button class="btn primary" type="submit">{ i18n.T(ctx, "Criar task") }</button>
				</div>
			</form>
		} else {
			@Alert("warn", i18n.T(ctx, "Seu papel nesta empresa não permite esta ação."))
		}
	}
}

var _ = fmt.Sprint

// TaskSideUpdate is the htmx response to a property change: the side panel plus
// the header chips (out-of-band).
templ TaskSideUpdate(vm TaskVM, base string) {
	@TaskSide(vm, base)
	@TaskChips(vm, true)
}

func oobAttr(oob bool) string {
	if oob {
		return "true"
	}
	return ""
}
