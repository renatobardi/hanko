package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

// Metas (ADR-0028): objetivos mensuráveis. Ler é de qualquer membro; registrar progresso e ligar tasks é de
// member; criar, alterar, abandonar e reabrir é de admin.

templ GoalsPage(sh Shell, vm GoalsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Metas"), vm.Subtitle) {
			if sh.CanAdmin() {
				<a class="btn primary" href={ templ.SafeURL(vm.NewHref) }>
					@Icon("plus")
					{ i18n.T(ctx, "Nova meta") }
				</a>
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="kpis">
			@Kpi("trending-up", fmt.Sprint(vm.Active), i18n.T(ctx, "Metas ativas"), false)
			@Kpi("clock", fmt.Sprint(vm.Overdue), i18n.T(ctx, "Atrasadas"), vm.Overdue > 0)
			@Kpi("circle-check", fmt.Sprint(vm.Achieved), i18n.T(ctx, "Atingidas"), false)
		</div>
		if vm.Empty {
			@EmptyCard("trending-up", i18n.T(ctx, "Você ainda não tem metas."), i18n.T(ctx, "Uma meta é um número a alcançar (seguidores, latência, receita), com prazo. As personas registram o progresso e as tasks se ligam a ela."), true) {
				if sh.CanAdmin() {
					<a class="btn outline" href={ templ.SafeURL(vm.NewHref) }>
						@Icon("plus")
						{ i18n.T(ctx, "Criar meta") }
					</a>
				} else {
					@NeedRole(domain.MemberAdmin)
				}
			}
		} else {
			<div class="toolbar">
				@Tabs(vm.Tabs)
			</div>
			if vm.Project != "" {
				<p class="filter-chip">
					<span class="chip soft">@Icon("layers") { i18n.T(ctx, "Projeto") } <b>{ vm.Project }</b></span>
					<a href={ templ.SafeURL(vm.ClearHref) }>{ i18n.T(ctx, "limpar filtro") }</a>
				</p>
			}
			if len(vm.Rows) == 0 {
				@EmptyCard("trending-up", i18n.T(ctx, "Nenhuma meta aqui."), "", false)
			} else {
				<div class="table-wrap">
					<table class="table goals-table">
						<thead>
							<tr>
								<th>{ i18n.T(ctx, "Meta") }</th>
								<th>{ i18n.T(ctx, "Progresso") }</th>
								<th class="hide-sm">{ i18n.T(ctx, "Prazo") }</th>
								<th class="hide-sm">{ i18n.T(ctx, "Projeto") }</th>
								<th class="num hide-sm">Tasks</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range vm.Rows {
								<tr class="row">
									<td class="ttl">
										<a href={ templ.SafeURL(r.Href) }>{ r.Title }</a>
										@BadgeEl(r.Badge)
										if r.Metric != "" {
											<div class="note">{ r.Metric }</div>
										}
									</td>
									<td class="goal-prog">
										@ProgressBar(r.Progress, i18n.T(ctx, "Progresso"))
										<div class="muted" style="font-size:12.5px"><b>{ r.ProgressTxt }</b> · { r.Values }</div>
									</td>
									<td class="hide-sm">
										if r.Due != "" {
											<span class={ templ.KV("danger-text", r.Overdue) }>{ r.Due }</span>
											if r.Overdue {
												<span class="badge danger">{ i18n.T(ctx, "atrasada") }</span>
											}
										} else {
											<span class="faint">—</span>
										}
									</td>
									<td class="hide-sm">
										if r.Project != "" {
											<a href={ templ.SafeURL(r.ProjectHref) }>{ r.Project }</a>
										} else {
											<span class="faint">—</span>
										}
									</td>
									<td class="num mono hide-sm">{ r.Tasks }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ GoalForm(vm GoalFormVM) {
	<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.Action) } hx-boost="true">
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="field">
			<label for="g-title">{ i18n.T(ctx, "Título") }</label>
			<input class="input" id="g-title" name="title" value={ vm.Title } required maxlength="200" placeholder={ i18n.T(ctx, "Ex.: Chegar a 100 seguidores") }/>
			if e := vm.FieldErr["title"]; e != "" {
				<span class="err">{ e }</span>
			}
		</div>
		<div class="field">
			<label for="g-desc">{ i18n.T(ctx, "Descrição") }</label>
			<textarea class="textarea" id="g-desc" name="description" rows="4" placeholder={ i18n.T(ctx, "Por que esta meta importa e como medir. Markdown.") }>{ vm.Description }</textarea>
		</div>
		<div class="form-grid">
			<div class="field">
				<label for="g-metric">{ i18n.T(ctx, "O que se mede") }</label>
				<input class="input" id="g-metric" name="metric" value={ vm.Metric } maxlength="120" placeholder={ i18n.T(ctx, "usuários ativos") }/>
				if e := vm.FieldErr["metric"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for="g-unit">{ i18n.T(ctx, "Unidade") }</label>
				<input class="input" id="g-unit" name="unit" value={ vm.Unit } maxlength="24" placeholder="ms, %, usuários"/>
				if e := vm.FieldErr["unit"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for="g-start">{ i18n.T(ctx, "Valor inicial") }</label>
				<input class="input mono" id="g-start" name="start" value={ vm.Start } required inputmode="decimal" autocomplete="off" placeholder="0"/>
				if e := vm.FieldErr["start"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for="g-target">{ i18n.T(ctx, "Alvo") }</label>
				<input class="input mono" id="g-target" name="target" value={ vm.Target } required inputmode="decimal" autocomplete="off" placeholder="100"/>
				<span class="hint">{ i18n.T(ctx, "Pode ser menor que o inicial, numa meta de redução.") }</span>
				if e := vm.FieldErr["target"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			if !vm.Edit {
				<div class="field">
					<label for="g-current">{ i18n.T(ctx, "Valor atual (opcional)") }</label>
					<input class="input mono" id="g-current" name="current" value={ vm.Current } inputmode="decimal" autocomplete="off" placeholder={ i18n.T(ctx, "vazio = o inicial") }/>
					if e := vm.FieldErr["current"]; e != "" {
						<span class="err">{ e }</span>
					}
				</div>
			}
			<div class="field">
				<label for="g-due">{ i18n.T(ctx, "Prazo (opcional)") }</label>
				<input class="input" id="g-due" type="date" name="due" value={ vm.Due }/>
				if e := vm.FieldErr["due"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			if len(vm.ProjectOptions) > 1 {
				<div class="field">
					<label for="g-proj">{ i18n.T(ctx, "Projeto") }</label>
					@Select("project", "g-proj", vm.ProjectOptions, false)
				</div>
			}
			<div class="field">
				<label for="g-owner">{ i18n.T(ctx, "Dona") }</label>
				@Select("owner", "g-owner", vm.OwnerOptions, false)
			</div>
		</div>
		<div class="form-actions">
			<a class="btn ghost" href={ templ.SafeURL(vm.CancelHref) }>{ i18n.T(ctx, "Cancelar") }</a>
			<button class="btn primary" type="submit">
				if vm.Edit {
					{ i18n.T(ctx, "Salvar alterações") }
				} else {
					{ i18n.T(ctx, "Criar meta") }
				}
			</button>
		</div>
	</form>
}

templ NewGoalPage(sh Shell, vm GoalFormVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Nova meta"), i18n.T(ctx, "Um número a alcançar, com prazo. As personas registram o progresso.")) {
		}
		if sh.CanAdmin() {
			@GoalForm(vm)
		} else {
			@Alert("warn", i18n.T(ctx, "Seu papel nesta empresa não permite esta ação."))
		}
	}
}

// GoalChart é o histórico de progresso em SVG, calculado no servidor (sem script).
templ GoalChart(c ChartVM) {
	if c.Empty {
		<p class="muted">{ i18n.T(ctx, "Ainda não há registros de progresso.") }</p>
	} else {
		<svg class="goal-chart" viewBox={ fmt.Sprintf("0 0 %d %d", c.Width, c.Height) } role="img" aria-label={ c.Summary }>
			<line class="gc-axis" x1={ c.PlotLeft } y1={ c.PlotBottom } x2={ c.PlotRight } y2={ c.PlotBottom }></line>
			<line class="gc-axis" x1={ c.PlotLeft } y1={ c.PlotTop } x2={ c.PlotLeft } y2={ c.PlotBottom }></line>
			<line class="gc-target" x1={ c.PlotLeft } y1={ c.TargetY } x2={ c.PlotRight } y2={ c.TargetY }></line>
			<text class="gc-lbl" x={ c.PlotRight } y={ c.TargetY } dy="-5" text-anchor="end">{ c.TargetLabel }</text>
			<line class="gc-start" x1={ c.PlotLeft } y1={ c.StartY } x2={ c.PlotRight } y2={ c.StartY }></line>
			<text class="gc-lbl" x={ c.PlotRight } y={ c.StartY } dy="-5" text-anchor="end">{ c.StartLabel }</text>
			if c.Area != "" {
				<polygon class="gc-area" points={ c.Area }></polygon>
			}
			<polyline class="gc-line" points={ c.Polyline } fill="none"></polyline>
			for _, p := range c.Points {
				<circle class="gc-dot" cx={ p.X } cy={ p.Y } r="3.5"><title>{ p.Title }</title></circle>
			}
			<text class="gc-lbl" x={ c.PlotLeft } y={ c.PlotBottom } dy="16">{ c.XFirst }</text>
			<text class="gc-lbl" x={ c.PlotRight } y={ c.PlotBottom } dy="16" text-anchor="end">{ c.XLast }</text>
		</svg>
	}
}

templ GoalPage(sh Shell, vm GoalVM) {
	@Layout(sh) {
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="flow-head">
			<div>
				<h1>{ vm.Title } @BadgeEl(vm.Badge)</h1>
				if vm.Metric != "" {
					<p class="muted" style="margin-top:6px;font-size:13.5px">{ vm.Metric }</p>
				}
			</div>
			<div class="flow-acts">
				if canAdmin(ctx) {
					<form method="post" action={ templ.SafeURL(vm.StatusURL) } hx-post={ vm.StatusURL } hx-swap="none">
						<input type="hidden" name="to" value={ vm.StatusTo }/>
						<button class="btn outline" type="submit">{ vm.StatusLabel }</button>
					</form>
				}
			</div>
		</div>
		<div class="stats4" style="margin-bottom:20px">
			<div class="stat"><div class="l">{ i18n.T(ctx, "Progresso") }</div><div class="v">{ vm.ProgressTxt }</div></div>
			<div class="stat"><div class="l">{ i18n.T(ctx, "Inicial") } → { i18n.T(ctx, "Alvo") }</div><div class="v">{ vm.Start } → { vm.Target }</div></div>
			<div class="stat"><div class="l">{ i18n.T(ctx, "Atual") }</div><div class="v">{ vm.Current }</div></div>
			<div class="stat">
				<div class="l">{ i18n.T(ctx, "Prazo") }</div>
				<div class="v">
					if vm.Due != "" {
						<span class={ templ.KV("danger-text", vm.Overdue) }>{ vm.Due }</span>
					} else {
						<span class="faint">—</span>
					}
				</div>
			</div>
		</div>
		<section class="card pad">
			@ProgressBar(vm.Progress, i18n.T(ctx, "Progresso"))
			<dl class="kv">
				<dt>{ i18n.T(ctx, "Projeto") }</dt>
				<dd>
					if vm.Project != "" {
						<a href={ templ.SafeURL(vm.ProjectHref) }>{ vm.Project }</a>
					} else {
						<span class="faint">—</span>
					}
				</dd>
				<dt>{ i18n.T(ctx, "Dona") }</dt>
				<dd>
					if vm.Owner != "" {
						<a href={ templ.SafeURL(vm.OwnerHref) }>{ vm.Owner }</a>
					} else {
						<span class="faint">{ i18n.T(ctx, "o time (humano)") }</span>
					}
				</dd>
				if vm.Achieved != "" {
					<dt>{ i18n.T(ctx, "Atingida") }</dt><dd>{ vm.Achieved }</dd>
				}
			</dl>
			if vm.Description != "" {
				<div class="md" style="margin-top:12px">@templ.Raw(string(vm.Description))</div>
			}
		</section>
		<div class="grid-2" style="margin-top:20px;align-items:start">
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Histórico de progresso") }</h2></div>
				@GoalChart(vm.Chart)
				if vm.CanProgress && canWrite(ctx) {
					<form class="goal-progress" method="post" action={ templ.SafeURL(vm.ProgressURL) } hx-post={ vm.ProgressURL } hx-swap="none">
						<div class="form-grid" style="margin-top:14px">
							<div class="field">
								<label for="gp-value">{ i18n.T(ctx, "Valor atual") }</label>
								<input class="input mono" id="gp-value" name="value" value={ vm.Value } required inputmode="decimal" autocomplete="off"/>
							</div>
							<div class="field">
								<label for="gp-note">{ i18n.T(ctx, "Nota (opcional)") }</label>
								<input class="input" id="gp-note" name="note" value={ vm.Note } maxlength="500" autocomplete="off"/>
							</div>
						</div>
						<button class="btn primary sm" type="submit">{ i18n.T(ctx, "Registrar progresso") }</button>
					</form>
				} else if vm.CanProgress {
					@NeedRole(domain.MemberMember)
				}
				if len(vm.Updates) > 0 {
					<table class="table mini" style="margin-top:14px">
						<thead><tr><th>{ i18n.T(ctx, "Quando") }</th><th class="num">{ i18n.T(ctx, "Valor") }</th><th class="num">%</th><th>{ i18n.T(ctx, "Nota") }</th></tr></thead>
						<tbody>
							for _, u := range vm.Updates {
								<tr>
									<td class="muted" style="font-size:12.5px">{ u.When } · { u.Author }</td>
									<td class="num mono">{ u.Value }</td>
									<td class="num mono">{ u.Pct }</td>
									<td class="muted">{ u.Note }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Tasks ligadas") }</h2><a class="sub" href={ templ.SafeURL(vm.TasksHref) }>{ i18n.T(ctx, "Ver todas") }</a></div>
				<div class="chips" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
					for _, st := range vm.Statuses {
						<a class="chip soft" href={ templ.SafeURL(st.Href) }>{ st.Label } <b class="mono">{ fmt.Sprint(st.Count) }</b></a>
					}
				</div>
				if len(vm.Tasks) == 0 {
					<p class="muted">{ i18n.T(ctx, "Nenhuma task serve a esta meta ainda.") }</p>
				} else {
					<table class="table mini">
						<tbody>
							for _, r := range vm.Tasks {
								<tr>
									<td class="id">{ r.Key }</td>
									<td class="ttl"><a href={ templ.SafeURL(r.Href) }>{ r.Title }</a></td>
									<td>@BadgeEl(r.Badge)</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if canWrite(ctx) {
					<form method="post" action={ templ.SafeURL(vm.LinkURL) } hx-post={ vm.LinkURL } hx-swap="none" style="display:flex;gap:8px;margin-top:12px">
						<input class="input mono" name="task" value={ vm.LinkTask } placeholder="HNK-12" aria-label={ i18n.T(ctx, "Task a ligar") } required autocomplete="off"/>
						<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Ligar task") }</button>
					</form>
				}
			</section>
		</div>
		<h2 class="side-h" style="margin:28px 0 12px">{ i18n.T(ctx, "Definição") }</h2>
		if canAdmin(ctx) {
			@GoalForm(vm.Form)
		} else {
			@NeedRole(domain.MemberAdmin)
		}
	}
}

// GoalMiniList são as metas do projeto na página dele.
templ GoalMiniList(items []GoalMini, all string) {
	if len(items) == 0 {
		<p class="muted">{ i18n.T(ctx, "Nenhuma meta neste projeto ainda.") }</p>
	} else {
		<div class="goal-mini">
			for _, g := range items {
				<div class="goal-mini-row">
					<div class="t"><a href={ templ.SafeURL(g.Href) }>{ g.Title }</a> @BadgeEl(g.Badge)</div>
					@ProgressBar(g.Progress, i18n.T(ctx, "Progresso"))
					<div class="muted" style="font-size:12.5px">
						<b>{ g.ProgressTxt }</b>
						if g.Due != "" {
							· <span class={ templ.KV("danger-text", g.Overdue) }>{ g.Due }</span>
						}
					</div>
				</div>
			}
		</div>
	}
	if all != "" {
		<p style="margin-top:8px;font-size:13px"><a href={ templ.SafeURL(all) }>{ i18n.T(ctx, "Ver todas") }</a></p>
	}
}
