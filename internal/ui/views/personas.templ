package views

import "fmt"

templ PersonasPage(sh Shell, vm PersonasVM) {
	@Layout(sh) {
		@PageHead("Personas", vm.Subtitle) {
		}
		<div class="kpis">
			@Kpi("bot", fmt.Sprint(vm.Active), "Ativas agora", false)
			@Kpi("activity", fmt.Sprint(vm.Running), "Executando", false)
			@Kpi("alert", fmt.Sprint(vm.Paused), "Pausadas", false)
			@Kpi("shield", fmt.Sprint(vm.Awaiting), "Aguardando gate", vm.Awaiting > 0)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("bot", "Você ainda não tem personas.", "Contrate a primeira, escolha o harness e o modelo e defina o intervalo de verificação.", true) {
				<a class="btn outline" href={ templ.SafeURL(sh.Base() + "/personas/nova") }>@Icon("plus") Contratar persona</a>
			}
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Persona</th>
							<th>Status</th>
							<th class="hide-sm">Harness · modelo</th>
							<th class="num">Tasks</th>
							<th class="hide-sm">Acorda</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							<tr class="row">
								<td>
									<a class="p-name" href={ templ.SafeURL(r.Href) }>
										<span class="mini-avatar">@Icon("bot")</span>
										<span class="pn"><b>{ r.Name }</b><span>{ r.Title }</span></span>
									</a>
								</td>
								<td>@BadgeEl(r.Badge)</td>
								<td class="hide-sm mono" style="font-size:12.5px">{ r.Agent }
									if r.Model != "" {
										<span class="muted"> · { r.Model }</span>
									}
								</td>
								<td class="num mono">{ fmt.Sprint(r.OpenTasks) }</td>
								<td class="hide-sm muted">{ r.Heartbeat }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ HirePersonaPage(sh Shell, vm HirePersonaVM) {
	@Layout(sh) {
		@PageHead("Contratar persona", "Identidade, harness e modelo. A persona é acordada assim que tiver uma task.") {
		}
		<form class="card pad form-card" method="post" action={ templ.SafeURL(sh.Base() + "/personas/nova") } hx-boost="true">
			if vm.Error != "" {
				@Alert("danger", vm.Error)
			}
			<div class="form-grid">
				<div class="field">
					<label for="p-name">Nome</label>
					<input class="input" id="p-name" name="name" value={ vm.Name } required maxlength="80" placeholder="Ada" autofocus/>
					if e := vm.FieldErr["name"]; e != "" {
						<span class="err">{ e }</span>
					}
				</div>
				<div class="field">
					<label for="p-title">Cargo</label>
					<input class="input" id="p-title" name="title" value={ vm.Title } maxlength="120" placeholder="Chief of staff"/>
				</div>
			</div>
			<div class="field">
				<span class="lbl">Harness</span>
				<div class="radio-cards">
					<label>
						<input type="radio" name="agent" value="claude" checked?={ vm.Agent == "claude" }/>
						<span class="rc"><b>@Icon("bot") Claude Code</b><span>Local · sessão preservada · skills nativas</span></span>
					</label>
					<label>
						<input type="radio" name="agent" value="codex" checked?={ vm.Agent == "codex" }/>
						<span class="rc"><b>@Icon("bot") Codex</b><span>Local · OpenAI · exec em JSONL</span></span>
					</label>
					<label>
						<input type="radio" name="agent" value="fake" checked?={ vm.Agent == "fake" }/>
						<span class="rc"><b>@Icon("bot") Simulado</b><span>Sem processo e sem custo · demo e testes</span></span>
					</label>
				</div>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="p-model">Modelo</label>
					<input class="input" id="p-model" name="model" value={ vm.Model } placeholder="claude-sonnet (vazio = padrão do harness)" list="models"/>
					<datalist id="models">
						<option value="claude-sonnet"></option>
						<option value="claude-opus"></option>
						<option value="claude-haiku"></option>
						<option value="gpt-5"></option>
					</datalist>
					<span class="hint">Lista sugerida · ou informe um ID manual.</span>
				</div>
				<div class="field">
					<label for="p-hb">Acordar a cada (min)</label>
					<input class="input" id="p-hb" name="heartbeat" type="number" min="0" max="1440" value={ vm.Heartbeat } inputmode="numeric"/>
					<span class="hint">Intervalo de verificação: de quanto em quanto tempo a persona é acordada por task. 0 = só manual.</span>
				</div>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="p-reports">Reporta a</label>
					@Select("reports_to", "p-reports", vm.ReportsTo, false)
					<span class="hint">Define o organograma. Uma persona só delega tasks para si e para quem reporta a ela.</span>
				</div>
				<div class="field">
					<span class="lbl">Revisão</span>
					<label class="check">
						<input type="checkbox" name="require_review" value="1" checked?={ vm.RequireReview }/>
						<span>Exige revisão</span>
					</label>
					<span class="hint">Ao dar uma task como concluída, ela passa por um gate de revisão antes de fechar.</span>
				</div>
			</div>
			<div class="field">
				<label for="p-instr">Instruções</label>
				<textarea class="textarea mono" id="p-instr" name="instructions" rows="8" placeholder="Você é a Ada, Chief of staff. Receba a meta, delegue e conclua com evidência.">{ vm.Instructions }</textarea>
				<span class="hint">Vira o prompt de sistema da persona em cada execução.</span>
			</div>
			<div class="form-actions">
				<a class="btn ghost" href={ templ.SafeURL(sh.Base() + "/personas") }>Cancelar</a>
				<button class="btn primary" type="submit">Contratar</button>
			</div>
		</form>
	}
}

templ PersonaPage(sh Shell, vm PersonaVM) {
	@Layout(sh) {
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.LastError != "" {
			@Alert("danger", personaErrorText(vm))
		}
		<div class="persona-head">
			<span class="mini-avatar">@Icon("bot")</span>
			<div>
				<h1>{ vm.Name } @BadgeEl(vm.Badge)</h1>
				<p class="muted" style="margin-top:4px;font-size:13.5px">{ vm.Title } · <span class="mono" style="font-size:12.5px">{ vm.Agent }</span>
					if vm.Model != "" {
						<span class="mono" style="font-size:12.5px"> · { vm.Model }</span>
					}
					· intervalo de verificação: { vm.Heartbeat }
				</p>
			</div>
		</div>
		if len(vm.Controls) > 0 {
			<div class="persona-controls" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px">
				for _, c := range vm.Controls {
					<form method="post" action={ templ.SafeURL(c.Href) } hx-post={ c.Href } hx-swap="none">
						<button class="btn outline sm" type="submit" title={ c.Hint }>@Icon(c.Icon) <span>{ c.Label }</span></button>
					</form>
				}
			</div>
		}
		<div class="tabs" style="margin-bottom:22px">
			<a href="#visao" aria-current="page">Visão geral</a>
			<a href="#execucoes">Execuções</a>
		</div>
		<div class="grid-2" id="visao" style="align-items:start">
			<section class="card pad">
				<div class="card-head"><h2>Identidade</h2></div>
				<dl class="dl">
					<dt>Nome</dt><dd>{ vm.Name }</dd>
					<dt>Cargo</dt><dd>{ vm.Title }</dd>
					<dt>Slug</dt><dd class="mono">{ vm.Slug }</dd>
					<dt>Harness</dt><dd class="mono">{ vm.Agent }</dd>
					<dt>Modelo</dt><dd class="mono">
						if vm.Model != "" {
							{ vm.Model }
						} else {
							<span class="faint">padrão do harness</span>
						}
					</dd>
					<dt>Intervalo de verificação</dt><dd>{ vm.Heartbeat }</dd>
					<dt>Reporta a</dt><dd>
						if vm.ReportsHref != "" {
							<a href={ templ.SafeURL(vm.ReportsHref) } style="text-decoration:underline;text-underline-offset:2px">{ vm.ReportsTo }</a>
						} else {
							<span>Você (dono)</span>
						}
					</dd>
					<dt>Exige revisão</dt><dd>
						if vm.RequireReview {
							<span class="badge warn">Sim</span>
						} else {
							<span class="muted">Não</span>
						}
					</dd>
					if len(vm.Reports) > 0 {
						<dt>Equipe</dt><dd>
							for i, r := range vm.Reports {
								if i > 0 {
									<span>, </span>
								}
								<a href={ templ.SafeURL(r.Href) } style="text-decoration:underline;text-underline-offset:2px">{ r.Name }</a>
							}
						</dd>
					}
					<dt>Contratada</dt><dd>{ vm.Hired }</dd>
				</dl>
			</section>
			<section class="card pad">
				<div class="card-head"><h2>Instruções</h2></div>
				if vm.Instructions == "" {
					<p class="muted">Sem instruções.</p>
				} else {
					<div class="instr">{ vm.Instructions }</div>
				}
			</section>
		</div>
		<section class="card pad" id="organizacao" style="margin-top:20px">
			<div class="card-head"><div><h2>Organização</h2><p class="sub">Quem esta persona reporta e se o trabalho dela passa por revisão antes de concluir.</p></div></div>
			<form method="post" action={ templ.SafeURL(vm.OrgAction) } hx-post={ vm.OrgAction } hx-swap="none" class="org-form">
				<div class="field">
					<label for="o-reports">Reporta a</label>
					@Select("reports_to", "o-reports", vm.OrgOptions, false)
				</div>
				<div class="field">
					<label class="check">
						<input type="checkbox" name="require_review" value="1" checked?={ vm.RequireReview }/>
						<span>Exige revisão</span>
					</label>
				</div>
				<div class="form-actions" style="margin-top:0"><button class="btn primary sm" type="submit">Salvar organização</button></div>
			</form>
		</section>
		<h2 class="side-h" style="margin:28px 0 12px">Tasks atribuídas</h2>
		if len(vm.Tasks) == 0 {
			@EmptyCard("list", "Nenhuma task atribuída.", "Atribua uma task a esta persona para ela começar a trabalhar.", false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<tbody>
						for _, r := range vm.Tasks {
							<tr class="row">
								<td style="width:36px;padding-right:0">@PrioIcon(r.Priority, r.PriorityLabel)</td>
								<td class="id">{ r.Key }</td>
								<td class="ttl"><a href={ templ.SafeURL(r.Href) }>{ r.Title }</a></td>
								<td>@BadgeEl(r.Badge)</td>
								<td class="when">{ r.Updated }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2 class="side-h" id="execucoes" style="margin:28px 0 12px">Execuções recentes</h2>
		@RunsTable(vm.Runs, false)
	}
}

func personaErrorText(vm PersonaVM) string {
	msg := "Última execução falhou"
	if vm.LastErrorAt != "" {
		msg += " em " + vm.LastErrorAt
	}
	if vm.Failures > 1 {
		msg += " (" + fmt.Sprint(vm.Failures) + " falhas seguidas)"
	}
	return msg + ": " + vm.LastError
}
