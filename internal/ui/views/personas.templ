package views

import (
	"context"
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ PersonasPage(sh Shell, vm PersonasVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Personas"), vm.Subtitle) {
			<a class="btn outline" href={ templ.SafeURL(sh.Base() + "/personas/catalogo") }>@Icon("layers") { i18n.T(ctx, "Catálogo de times") }</a>
		}
		@PersonasTabs(sh.Base(), false)
		<div class="kpis">
			@Kpi("bot", fmt.Sprint(vm.Active), i18n.T(ctx, "Ativas agora"), false)
			@Kpi("activity", fmt.Sprint(vm.Running), i18n.T(ctx, "Executando"), false)
			@Kpi("alert", fmt.Sprint(vm.Paused), i18n.T(ctx, "Pausadas"), false)
			@Kpi("shield", fmt.Sprint(vm.Awaiting), i18n.T(ctx, "Aguardando gate"), vm.Awaiting > 0)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("bot", i18n.T(ctx, "Você ainda não tem personas."), i18n.T(ctx, "Contrate a primeira, escolha o harness e o modelo e defina o intervalo de verificação."), true) {
				if sh.CanAdmin() {
					<a class="btn outline" href={ templ.SafeURL(sh.Base() + "/personas/nova") }>
						@Icon("plus")
						{ i18n.T(ctx, "Contratar persona") }
					</a>
					<a class="btn primary" href={ templ.SafeURL(sh.Base() + "/personas/catalogo") }>
						@Icon("layers")
						{ i18n.T(ctx, "Instalar um time pronto") }
					</a>
				} else {
					@NeedRole(domain.MemberAdmin)
				}
			}
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Persona</th>
							<th>{ i18n.T(ctx, "Status") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Harness · modelo") }</th>
							<th class="num">Tasks</th>
							<th class="hide-sm">{ i18n.T(ctx, "Acorda") }</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							<tr class="row">
								<td>
									<a class="p-name" href={ templ.SafeURL(r.Href) }>
										<span class="mini-avatar">@PersonaGlyph(r.Name)</span>
										<span class="pn"><b>{ r.Name }</b><span>{ r.Title }</span></span>
									</a>
									@TagChips(r.Tags)
								</td>
								<td>@BadgeEl(r.Badge)</td>
								<td class="hide-sm mono text-xs">{ r.Agent }
									if r.Model != "" {
										<span class="muted"> · { r.Model }</span>
									}
								</td>
								<td class="num mono">{ fmt.Sprint(r.OpenTasks) }</td>
								<td class="hide-sm muted">{ r.Heartbeat }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ HirePersonaPage(sh Shell, vm HirePersonaVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Contratar persona"), i18n.T(ctx, "Identidade, harness e modelo. A persona é acordada assim que tiver uma task.")) {
		}
		if sh.CanAdmin() {
			<form class="card pad form-card" method="post" action={ templ.SafeURL(sh.Base() + "/personas/nova") } hx-boost="true">
				if vm.Error != "" {
					@Alert("danger", vm.Error)
				}
				<div class="form-grid">
					<div class="field">
						<label for="p-name">{ i18n.T(ctx, "Nome") }</label>
						<input class="input" id="p-name" name="name" value={ vm.Name } required maxlength="80" placeholder={ i18n.T(ctx, "Ada") } autofocus/>
						if e := vm.FieldErr["name"]; e != "" {
							<span class="err">{ e }</span>
						}
					</div>
					<div class="field">
						<label for="p-title">{ i18n.T(ctx, "Cargo") }</label>
						<input class="input" id="p-title" name="title" value={ vm.Title } maxlength="120" placeholder={ i18n.T(ctx, "Chief of staff") }/>
					</div>
				</div>
				<div class="field">
					<span class="lbl">{ i18n.T(ctx, "Ícone") }</span>
					@IconPicker(vm.Icon)
					if e := vm.FieldErr["icon"]; e != "" {
						<span class="err">{ e }</span>
					}
				</div>
				<div class="field">
					<span class="lbl">Harness</span>
					<div class="radio-cards rc2">
						<label>
							<input type="radio" name="agent" value="claude" checked?={ vm.Agent == "claude" }/>
							<span class="rc"><b>@Icon("bot") Claude Code</b><span>{ i18n.T(ctx, "Local · sessão preservada · skills nativas") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="codex" checked?={ vm.Agent == "codex" }/>
							<span class="rc"><b>@Icon("bot") Codex</b><span>{ i18n.T(ctx, "Local · OpenAI · exec em JSONL") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="acp" checked?={ vm.Agent == "acp" }/>
							<span class="rc"><b>@Icon("bot") ACP</b><span>{ i18n.T(ctx, "Local · qualquer harness que fale ACP · você informa o comando") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="devin" checked?={ vm.Agent == "devin" }/>
							<span class="rc"><b>@Icon("bot") Devin CLI</b><span>{ i18n.T(ctx, "Local · Devin via ACP · o executável é do operador") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="pi" checked?={ vm.Agent == "pi" }/>
							<span class="rc"><b>@Icon("bot") Pi</b><span>{ i18n.T(ctx, "Local · saída JSON · tools do Hanko pela CLI") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="cursor" checked?={ vm.Agent == "cursor" }/>
							<span class="rc"><b>@Icon("bot") Cursor CLI</b><span>{ i18n.T(ctx, "Local · stream-json · tools do Hanko pela CLI") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="http" checked?={ vm.Agent == "http" }/>
							<span class="rc"><b>@Icon("bot") HTTP</b><span>{ i18n.T(ctx, "Sem CLI · endpoint compatível com chat completions · tools do Hanko") }</span></span>
						</label>
						<label>
							<input type="radio" name="agent" value="fake" checked?={ vm.Agent == "fake" }/>
							<span class="rc"><b>
								@Icon("bot")
								{ i18n.T(ctx, "Simulado") }
							</b><span>{ i18n.T(ctx, "Sem processo e sem custo · demo e testes") }</span></span>
						</label>
					</div>
				</div>
				<div class="acp-only">
					<div class="form-grid">
						<div class="field">
							<label for="p-acp-cmd">{ i18n.T(ctx, "Comando do harness ACP") }</label>
							<input class="input mono" id="p-acp-cmd" name="acp_command" value={ vm.AcpCommand } maxlength="500" placeholder="meu-comando-acp" autocomplete="off" spellcheck="false"/>
							if e := vm.FieldErr["acp_command"]; e != "" {
								<span class="err">{ e }</span>
							}
							<span class="hint">{ i18n.T(ctx, "Só o executável, que fala ACP por stdio e precisa estar instalado no servidor. Argumentos vão no campo abaixo; variáveis de ambiente extras, pela API ou pela CLI.") }</span>
						</div>
						<div class="field">
							<label for="p-acp-preset">{ i18n.T(ctx, "Ou uma ferramenta conhecida") }</label>
							<select class="select" id="p-acp-preset" name="acp_preset">
								<option value="">—</option>
								<option value="gemini" selected?={ vm.AcpPreset == "gemini" }>Gemini CLI</option>
								<option value="opencode" selected?={ vm.AcpPreset == "opencode" }>opencode</option>
							</select>
							<span class="hint">{ i18n.T(ctx, "Preenche o comando e os argumentos da ferramenta; deixe o comando em branco.") }</span>
						</div>
					</div>
					<div class="field">
						<label for="p-acp-args">{ i18n.T(ctx, "Argumentos do comando (um por linha)") }</label>
						<textarea class="textarea mono" id="p-acp-args" name="acp_args" rows="3" spellcheck="false">{ vm.AcpArgs }</textarea>
					</div>
				</div>
				<div class="perm-only">
					<div class="field">
						<label for="p-acp-perm">{ i18n.T(ctx, "Permissões do harness") }</label>
						@Select("acp_permission", "p-acp-perm", vm.AcpPermission, false)
						<span class="hint">{ i18n.T(ctx, "Somente leitura aprova leitura e busca e recusa edição e execução. Permitir tudo aprova qualquer pedido do harness.") }</span>
					</div>
				</div>
				<div class="http-only">
					<div class="form-grid">
						<div class="field">
							<label for="p-http-base">{ i18n.T(ctx, "Endpoint compatível com chat completions") }</label>
							<input class="input mono" id="p-http-base" name="http_base_url" value={ vm.HttpBaseURL } maxlength="500" autocomplete="off" spellcheck="false" placeholder="https://openrouter.ai/api/v1"/>
							if e := vm.FieldErr["http_base_url"]; e != "" {
								<span class="err">{ e }</span>
							}
							<span class="hint">{ i18n.T(ctx, "O Hanko roda o loop de tool-use: o modelo pede as tools do Hanko e o Hanko as executa. Informe o modelo no campo abaixo.") }</span>
						</div>
						<div class="field">
							<label for="p-http-key">{ i18n.T(ctx, "Chave (segredo da empresa)") }</label>
							<input class="input mono" id="p-http-key" name="http_key_ref" value={ vm.HttpKeyRef } maxlength="200" autocomplete="off" spellcheck="false" placeholder="${secret:openrouter}"/>
							if e := vm.FieldErr["http_key_ref"]; e != "" {
								<span class="err">{ e }</span>
							}
							<span class="hint">{ i18n.T(ctx, "Referência a um segredo criado em Configurações › Segredos. Vazio para um endpoint local sem chave.") }</span>
						</div>
					</div>
				</div>
				<div class="form-grid">
					<div class="field">
						<label for="p-model">{ i18n.T(ctx, "Modelo") }</label>
						@ModelPicker(vm.ModelPicker)
						<span class="hint">{ i18n.T(ctx, "Catálogo do harness, da tabela de preços e do que os testes e as execuções já viram · ou escolha Outro e informe o ID.") }</span>
					</div>
					<div class="field">
						<label for="p-hb">{ i18n.T(ctx, "Acordar a cada (min)") }</label>
						<input class="input" id="p-hb" name="heartbeat" type="number" min="0" max="1440" value={ vm.Heartbeat } inputmode="numeric"/>
						<span class="hint">{ i18n.T(ctx, "Intervalo de verificação: de quanto em quanto tempo a persona é acordada por task. 0 = só manual.") }</span>
					</div>
				</div>
				<div class="form-grid">
					<div class="field">
						<label for="p-reports">{ i18n.T(ctx, "Reporta a") }</label>
						@Select("reports_to", "p-reports", vm.ReportsTo, false)
						<span class="hint">{ i18n.T(ctx, "Define o organograma. Uma persona só delega tasks para si e para quem reporta a ela.") }</span>
					</div>
					<div class="field">
						<span class="lbl">{ i18n.T(ctx, "Revisão") }</span>
						<label class="check">
							<input type="checkbox" name="require_review" value="1" checked?={ vm.RequireReview }/>
							<span>{ i18n.T(ctx, "Exige revisão") }</span>
						</label>
						<span class="hint">{ i18n.T(ctx, "Ao dar uma task como concluída, ela passa por um gate de revisão antes de fechar.") }</span>
					</div>
				</div>
				<div class="field">
					<label for="p-instr">{ i18n.T(ctx, "Instruções") }</label>
					<textarea class="textarea mono" id="p-instr" name="instructions" rows="8" placeholder={ i18n.T(ctx, "Você é a Ada, Chief of staff. Receba a meta, delegue e conclua com evidência.") }>{ vm.Instructions }</textarea>
					<span class="hint">{ i18n.T(ctx, "Vira o prompt de sistema da persona em cada execução.") }</span>
				</div>
				<div class="form-actions">
					<a class="btn ghost" href={ templ.SafeURL(sh.Base() + "/personas") }>{ i18n.T(ctx, "Cancelar") }</a>
					<button class="btn primary" type="submit">{ i18n.T(ctx, "Contratar") }</button>
				</div>
			</form>
		} else {
			@Alert("warn", i18n.T(ctx, "Seu papel nesta empresa não permite esta ação."))
		}
	}
}

templ PersonaPage(sh Shell, vm PersonaVM) {
	@Layout(sh) {
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		for _, w := range vm.ReachWarnings {
			@Alert("warn", w)
		}
		if vm.LastError != "" {
			@Alert("danger", personaErrorText(ctx, vm))
		}
		<div class="persona-head">
			<span class="mini-avatar">@Icon(iconOrDefault(vm.Icon))</span>
			<div>
				<h1>{ vm.Name } @BadgeEl(vm.Badge)</h1>
				<p class="muted mt-1 text-sm">{ vm.Title } · <span class="mono text-xs">{ vm.Agent }</span>
					if vm.Model != "" {
						<span class="mono text-xs"> · { vm.Model }</span>
					}
					· { i18n.T(ctx, "intervalo de verificação:") } { vm.Heartbeat }
				</p>
			</div>
		</div>
		if len(vm.Controls) > 0 && sh.CanAdmin() {
			<div class="persona-controls d-flex wrap gap-2 mb-4">
				for _, c := range vm.Controls {
					<form method="post" action={ templ.SafeURL(c.Href) } hx-post={ c.Href } hx-swap="none">
						<button class="btn outline sm" type="submit" title={ c.Hint }>@Icon(c.Icon) <span>{ c.Label }</span></button>
					</form>
				}
			</div>
		}
		@PluginWidgetsSlot(sh.Base(), "persona", vm.Slug)
		<div class="tabs mb-6">
			<a href="#visao" aria-current="page">{ i18n.T(ctx, "Visão geral") }</a>
			<a href="#execucoes">{ i18n.T(ctx, "Execuções") }</a>
		</div>
		<div class="grid-2 items-start" id="visao">
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Identidade") }</h2></div>
				<dl class="dl">
					<dt>{ i18n.T(ctx, "Nome") }</dt><dd>{ vm.Name }</dd>
					<dt>{ i18n.T(ctx, "Cargo") }</dt><dd>{ vm.Title }</dd>
					<dt>Slug</dt><dd class="mono">{ vm.Slug }</dd>
					<dt>Harness</dt><dd class="mono">{ vm.Agent }</dd>
					<dt>{ i18n.T(ctx, "Modelo") }</dt><dd class="mono">
						if vm.Model != "" {
							{ vm.Model }
						} else {
							<span class="faint">{ i18n.T(ctx, "padrão do harness") }</span>
						}
					</dd>
					<dt>{ i18n.T(ctx, "Intervalo de verificação") }</dt><dd>{ vm.Heartbeat }</dd>
					<dt>{ i18n.T(ctx, "Reporta a") }</dt><dd>
						if vm.ReportsHref != "" {
							<a class="link-u" href={ templ.SafeURL(vm.ReportsHref) }>{ vm.ReportsTo }</a>
						} else {
							<span>{ i18n.T(ctx, "Você (dono)") }</span>
						}
					</dd>
					<dt>{ i18n.T(ctx, "Exige revisão") }</dt><dd>
						if vm.RequireReview {
							<span class="badge warn">{ i18n.T(ctx, "Sim") }</span>
						} else {
							<span class="muted">{ i18n.T(ctx, "Não") }</span>
						}
					</dd>
					<dt>{ i18n.T(ctx, "Revisor") }</dt><dd>
						if vm.Reviewer.Summary == "" {
							<span class="muted">{ i18n.T(ctx, "Sem revisor") }</span>
						} else if vm.Reviewer.Href != "" {
							<a class="link-u" href={ templ.SafeURL(vm.Reviewer.Href) }>{ vm.Reviewer.Summary }</a>
						} else {
							<span class="mono">{ vm.Reviewer.Summary }</span>
						}
					</dd>
					if len(vm.Reports) > 0 {
						<dt>{ i18n.T(ctx, "Equipe") }</dt><dd>
							for i, r := range vm.Reports {
								if i > 0 {
									<span>, </span>
								}
								<a class="link-u" href={ templ.SafeURL(r.Href) }>{ r.Name }</a>
							}
						</dd>
					}
					<dt>{ i18n.T(ctx, "Contratada") }</dt><dd>{ vm.Hired }</dd>
				</dl>
			</section>
			<section class="card pad">
				<div class="card-head">
					<h2>{ i18n.T(ctx, "Instruções") }</h2>
					if vm.InstructionsHref != "" {
						<a class="sub" href={ templ.SafeURL(vm.InstructionsHref) }>{ i18n.Tf(ctx, "revisão %d · histórico e edição", vm.InstructionRevision) }</a>
					}
				</div>
				if vm.Instructions == "" {
					<p class="muted">{ i18n.T(ctx, "Sem instruções.") }</p>
				} else {
					<div class="instr">{ vm.Instructions }</div>
				}
			</section>
		</div>
		@PersonaPlusCard(vm.Plus)
		if canAdmin(ctx) {
			<section class="card pad mt-6" id="identidade">
				<div class="card-head"><div><h2>{ i18n.T(ctx, "Ícone") }</h2><p class="sub">{ i18n.T(ctx, "Identifica a persona em listas, chats e execuções.") }</p></div></div>
				<form method="post" action={ templ.SafeURL(vm.IconAction) } hx-boost="true" class="icon-form">
					@IconPicker(vm.Icon)
					<div class="form-actions mt-0"><button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar ícone") }</button></div>
				</form>
			</section>
		}
		@PersonaTagsCard(vm.Tags)
		<section class="card pad mt-6" id="organizacao">
			<div class="card-head"><div><h2>{ i18n.T(ctx, "Organização") }</h2><p class="sub">{ i18n.T(ctx, "Quem esta persona reporta e se o trabalho dela passa por revisão antes de concluir.") }</p></div></div>
			if canAdmin(ctx) {
				<form method="post" action={ templ.SafeURL(vm.OrgAction) } hx-post={ vm.OrgAction } hx-swap="none" class="org-form">
					<div class="field">
						<label for="o-reports">{ i18n.T(ctx, "Reporta a") }</label>
						@Select("reports_to", "o-reports", vm.OrgOptions, false)
					</div>
					<div class="field">
						<label class="check">
							<input type="checkbox" name="require_review" value="1" checked?={ vm.RequireReview }/>
							<span>{ i18n.T(ctx, "Exige revisão") }</span>
						</label>
					</div>
					<div class="form-actions mt-0"><button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar organização") }</button></div>
				</form>
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		</section>
		<section class="card pad mt-6" id="revisor">
			<div class="card-head"><div><h2>{ i18n.T(ctx, "Revisor") }</h2><p class="sub">{ i18n.T(ctx, "Quem faz a revisão automática antes do gate humano: outra persona, ou este mesmo papel rodando em outro harness ou modelo.") }</p></div></div>
			if canAdmin(ctx) {
				<form method="post" action={ templ.SafeURL(vm.Reviewer.Action) } hx-boost="true" class="org-form">
					if vm.Reviewer.Error != "" {
						@Alert("danger", vm.Reviewer.Error)
					}
					<div class="field">
						<span class="lbl">{ i18n.T(ctx, "Modo") }</span>
						<label class="check"><input type="radio" name="mode" value="none" checked?={ vm.Reviewer.Mode == "none" }/><span>{ i18n.T(ctx, "Sem revisor") }</span></label>
						<label class="check"><input type="radio" name="mode" value="persona" checked?={ vm.Reviewer.Mode == "persona" }/><span>{ i18n.T(ctx, "Outra persona") }</span></label>
						<label class="check"><input type="radio" name="mode" value="harness" checked?={ vm.Reviewer.Mode == "harness" }/><span>{ i18n.T(ctx, "Mesmo papel com outro harness ou modelo") }</span></label>
					</div>
					<div class="field">
						<label for="rv-persona">{ i18n.T(ctx, "Persona revisora") }</label>
						@Select("reviewer_persona", "rv-persona", vm.Reviewer.Persona, false)
					</div>
					<div class="field">
						<label for="rv-agent">Harness</label>
						@Select("reviewer_agent", "rv-agent", vm.Reviewer.Agent, false)
					</div>
					<div class="field">
						<label for="rv-model">{ i18n.T(ctx, "Modelo do revisor") }</label>
						<input class="input" id="rv-model" name="reviewer_model" value={ vm.Reviewer.Model } placeholder={ i18n.T(ctx, "vazio = padrão do harness") } list="rv-models" autocomplete="off"/>
						@ModelDatalist("rv-models")
						<span class="hint">{ i18n.T(ctx, "Harness e modelo valem só no modo mesmo papel e precisam diferir dos da persona.") }</span>
					</div>
					<div class="form-actions mt-0"><button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar revisor") }</button></div>
				</form>
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		</section>
		<section class="card pad mt-6" id="assinatura">
			<div class="card-head"><div><h2>{ i18n.T(ctx, "Assinatura") }</h2><p class="sub">{ i18n.T(ctx, "Plano que cobre as execuções desta persona: a mensalidade é rateada no custo pago e a trava semanal vale para ela.") }</p></div><a class="more" href={ templ.SafeURL(sh.Base() + "/custos#assinaturas") }>{ i18n.T(ctx, "Custos") }</a></div>
			if canAdmin(ctx) {
				<form method="post" action={ templ.SafeURL(vm.SubAction) } hx-post={ vm.SubAction } hx-swap="none" class="org-form">
					<div class="field">
						<label for="o-sub">{ i18n.T(ctx, "Assinatura") }</label>
						@Select("subscription", "o-sub", vm.SubOptions, false)
					</div>
					<div class="form-actions mt-0"><button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar assinatura") }</button></div>
				</form>
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		</section>
		if vm.Budget != nil {
			<section class={ "card pad budget-card mt-6", "b-" + vm.Budget.State }>
				<div class="card-head"><h2>{ i18n.T(ctx, "Orçamento do mês") }</h2><a class="more" href={ templ.SafeURL(vm.Budget.Href) }>{ i18n.T(ctx, "Custos") }</a></div>
				@BudgetMeter(*vm.Budget)
				@BudgetForm(*vm.Budget, "persona-budget")
			</section>
		}
		@PersonaEnvironmentSlot(vm)
		@PersonaVarsCard(vm.Vars)
		@PersonaReadinessSlot(vm.ReadinessHref)
		@PersonaExtras(vm.Extras)
		@EffectiveToolsSlot(sh.Base(), vm.Slug)
		<h2 class="side-h sec-h">{ i18n.T(ctx, "Tasks atribuídas") }</h2>
		if len(vm.Tasks) == 0 {
			@EmptyCard("list", i18n.T(ctx, "Nenhuma task atribuída."), i18n.T(ctx, "Atribua uma task a esta persona para ela começar a trabalhar."), false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<tbody>
						for _, r := range vm.Tasks {
							<tr class="row">
								<td class="col-prio">@PrioIcon(r.Priority, r.PriorityLabel)</td>
								<td class="id">{ r.Key }</td>
								<td class="ttl"><a href={ templ.SafeURL(r.Href) }>{ r.Title }</a></td>
								<td>@BadgeEl(r.Badge)</td>
								<td class="when">{ r.Updated }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2 class="side-h sec-h" id="conversas">{ i18n.T(ctx, "Conversas") }</h2>
		if len(vm.Chats) == 0 {
			@EmptyCard("message-square", i18n.T(ctx, "Nenhuma conversa com esta persona."), i18n.T(ctx, "Converse direto com ela, fora de uma task."), false) {
				if vm.NewChatHref != "" {
					<a class="btn outline sm" href={ templ.SafeURL(vm.NewChatHref) }>{ i18n.T(ctx, "Nova conversa") }</a>
				}
			}
		} else {
			@ChatRows(vm.Chats)
			if vm.NewChatHref != "" {
				<p class="mt-3"><a class="btn outline sm" href={ templ.SafeURL(vm.NewChatHref) }>{ i18n.T(ctx, "Nova conversa") }</a></p>
			}
		}
		@RoomList(vm.Rooms)
		<h2 class="side-h sec-h" id="execucoes">{ i18n.T(ctx, "Execuções recentes") }</h2>
		@RunsTable(vm.Runs, false)
	}
}

func personaErrorText(ctx context.Context, vm PersonaVM) string {
	msg := i18n.T(ctx, "Última execução falhou")
	if vm.LastErrorAt != "" {
		msg += " " + i18n.Tf(ctx, "em %s", vm.LastErrorAt)
	}
	if vm.Failures > 1 {
		msg += " (" + i18n.Tf(ctx, "%d falhas seguidas", vm.Failures) + ")"
	}
	return msg + ": " + vm.LastError
}

// PersonaVarsCard é a seção de variáveis de ambiente: nome e referência, nunca o valor (#117 fatia 3).
templ PersonaVarsCard(vm PersonaVarsVM) {
	<section class="card pad mt-6" id="variaveis">
		<div class="card-head"><div><h2>{ i18n.T(ctx, "Variáveis de ambiente") }</h2><p class="sub">{ i18n.T(ctx, "Chegam ao processo da persona. Cada valor é uma referência a segredo; o valor em si nunca aparece aqui.") }</p></div></div>
		if len(vm.Rows) == 0 {
			<p class="muted">{ i18n.T(ctx, "Nenhuma variável.") }</p>
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Nome") }</th>
							<th>{ i18n.T(ctx, "Referência") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							@personaVarRow(r, vm.Admin)
						}
					</tbody>
				</table>
			</div>
		}
		if vm.Admin {
			<form class="inline-form mt-3" method="post" action={ templ.SafeURL(vm.SetHref) } hx-boost="true">
				<input class="input mono" name="nome" required maxlength="64" autocomplete="off" spellcheck="false" aria-label={ i18n.T(ctx, "Nome") }/>
				<input class="input mono" name="referencia" required maxlength="300" autocomplete="off" spellcheck="false" aria-label={ i18n.T(ctx, "Referência") }/>
				<button class="btn primary sm" type="submit">{ i18n.T(ctx, "Salvar variável") }</button>
			</form>
			<p class="hint">{ i18n.T(ctx, "Use ${secret:NOME#campo} ou, para campo arquivo, ${secretfile:NOME#campo}. O segredo precisa existir na empresa.") }</p>
		} else {
			@NeedRole(domain.MemberAdmin)
		}
	</section>
}

templ personaVarRow(r PersonaVarRow, admin bool) {
	<tr class="row">
		<td><code class="mono">{ r.Name }</code></td>
		<td>
			if r.Masked {
				<span class="badge warn">{ i18n.T(ctx, "valor em claro") }</span> <code class="mono">***</code>
				<div class="note muted">{ i18n.T(ctx, "Troque por uma referência a segredo, com o mesmo nome, no formulário abaixo.") }</div>
			} else {
				<code class="mono">{ r.Ref }</code>
			}
		</td>
		<td>
			if admin {
				<form method="post" action={ templ.SafeURL(r.RemoveHref) } hx-boost="true">
					<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Remover") }</button>
				</form>
			}
		</td>
	</tr>
}
