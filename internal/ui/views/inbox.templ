package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ InboxPage(sh Shell, vm InboxVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Caixa de entrada"), vm.Subtitle) {
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="toolbar">
			@Tabs(vm.Tabs)
			if vm.CanMarkAll {
				<form method="post" action={ templ.SafeURL(vm.StateURL) } hx-post={ vm.StateURL } hx-swap="none">
					<input type="hidden" name="action" value="read_all"/>
					<button class="btn ghost sm" type="submit">{ i18n.T(ctx, "Marcar tudo como lido") }</button>
				</form>
			}
		</div>
		<div class="inbox-grid">
			<div class="stack">
				if len(vm.Goals) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("trending-up")
							{ i18n.T(ctx, "Metas atingidas") }
						<span class="cnt">{ fmt.Sprint(len(vm.Goals)) }</span></div>
						for _, g := range vm.Goals {
							<div class="inbox-row">
								@InboxItemCtl(g.Ctl)
								<span class="mini-avatar">@Icon("circle-check")</span>
								<div class="main">
									<div class="t">
										<a href={ templ.SafeURL(g.Href) }>{ g.Title }</a>
										<span class="badge done">{ i18n.T(ctx, "Atingida") }</span>
									</div>
									<p class="x">{ g.Text }</p>
									<div class="s">{ g.When }</div>
								</div>
								<div class="inbox-act">
									<a class="btn ghost sm" href={ templ.SafeURL(g.Href) }>{ i18n.T(ctx, "Abrir") }</a>
								</div>
							</div>
						}
					</section>
				}
				if len(vm.Mentions) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("message-square")
							{ i18n.T(ctx, "Menções") }
						<span class="cnt">{ fmt.Sprint(len(vm.Mentions)) }</span></div>
						for _, m := range vm.Mentions {
							<div class="inbox-row">
								@InboxItemCtl(m.Ctl)
								<span class="mini-avatar">@Icon("message-square")</span>
								<div class="main">
									<div class="t">
										<a class="mono id" href={ templ.SafeURL(m.Href) }>{ m.Key }</a>
										<a href={ templ.SafeURL(m.Href) }>{ m.Title }</a>
										<span class="badge soft">{ i18n.T(ctx, "Menção") }</span>
									</div>
									<p class="x">{ m.Excerpt }</p>
									<div class="s">{ m.Author } · { m.When }</div>
								</div>
								<div class="inbox-act">
									<a class="btn outline sm" href={ templ.SafeURL(m.Href) }>{ i18n.T(ctx, "Responder") }</a>
								</div>
							</div>
						}
					</section>
				}
				if vm.Total == 0 {
					@EmptyCard("circle-check", i18n.T(ctx, "Você está em dia."), i18n.T(ctx, "Nada espera por você: sem gates, bloqueios, execuções que falharam, personas com erro ou alertas."), true)
				}
				if len(vm.Alerts) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("alert")
							{ i18n.T(ctx, "Alertas operacionais") }
						<span class="cnt">{ fmt.Sprint(len(vm.Alerts)) }</span></div>
						for _, a := range vm.Alerts {
							<div class="inbox-row">
								@InboxItemCtl(a.Ctl)
								<span class="mini-avatar">@Icon("alert")</span>
								<div class="main">
									<div class="t">
										{ a.Message }
										if a.Critical {
											<span class="badge danger">{ i18n.T(ctx, "Crítico") }</span>
										} else {
											<span class="badge warn">{ i18n.T(ctx, "Atenção") }</span>
										}
									</div>
									<div class="s">{ a.KindText } · { i18n.T(ctx, "aberto") } { a.When } · { i18n.T(ctx, "fecha sozinho quando a condição some") }</div>
								</div>
								if a.Href != "" {
									<form class="inbox-act" method="get" action={ templ.SafeURL(a.Href) }>
										<a class="btn outline sm" href={ templ.SafeURL(a.Href) }>{ a.Link }</a>
									</form>
								}
							</div>
						}
					</section>
				}
				if len(vm.Gates) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("shield")
							{ i18n.T(ctx, "Precisa de você · gates") }
						<span class="cnt">{ fmt.Sprint(len(vm.Gates)) }</span></div>
						for _, g := range vm.Gates {
							<div class="inbox-row gate">
								@InboxItemCtl(g.Ctl)
								<span class="mini-avatar gate">@Icon("shield")</span>
								<div class="main">
									<div class="t">
										if g.TaskKey != "" {
											<a class="mono id" href={ templ.SafeURL(g.TaskHref) }>{ g.TaskKey }</a>
										}
										<a href={ templ.SafeURL(g.Href) }>{ g.Title }</a>
										<span class="badge warn">{ g.KindLabel }</span>
										if g.Aged {
											<span class="badge outline">{ i18n.T(ctx, "há mais de 24 h") }</span>
										}
										if g.Review != nil {
											@BadgeEl(g.Review.Badge)
										}
									</div>
									if g.Excerpt != "" {
										<p class="x">{ g.Excerpt }</p>
									}
									<div class="s">
										if g.Persona != "" {
											{ i18n.T(ctx, "pedido por") } { g.Persona } ·
										}
										{ g.Created }
									</div>
								</div>
								@GateDecideForm(g, "caixa", true)
							</div>
						}
					</section>
				}
				if len(vm.Reviewing) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">@Icon("shield") <span>{ i18n.T(ctx, "Revisão em andamento") }</span> <span class="cnt">{ fmt.Sprint(len(vm.Reviewing)) }</span></div>
						for _, rv := range vm.Reviewing {
							<div class="inbox-row">
								<span class="mini-avatar">@Icon("shield")</span>
								<div class="main">
									<div class="t">
										<a class="mono id" href={ templ.SafeURL(rv.Href) }>{ rv.Key }</a>
										<a href={ templ.SafeURL(rv.Href) }>{ rv.Title }</a>
										<span class="badge outline">{ i18n.T(ctx, "Em revisão") }</span>
									</div>
									<div class="s">
										if rv.Waiting {
											{ i18n.Tf(ctx, "%s vai revisar a entrega de %s assim que ela terminar", rv.Reviewer, rv.Persona) } · { rv.When }
										} else {
											{ i18n.Tf(ctx, "%s revisa a entrega de %s", rv.Reviewer, rv.Persona) } · { rv.When }
										}
										· { i18n.T(ctx, "o gate abre quando a revisão terminar") }
									</div>
								</div>
							</div>
						}
					</section>
				}
				if len(vm.Held) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("alert")
							{ i18n.T(ctx, "Tasks pausadas") }
						<span class="cnt">{ fmt.Sprint(len(vm.Held)) }</span></div>
						for _, t := range vm.Held {
							<div class="inbox-row">
								@InboxItemCtl(t.Ctl)
								<span class="mini-avatar">@Icon("list")</span>
								<div class="main">
									<div class="t">
										<a class="mono id" href={ templ.SafeURL(t.Href) }>{ t.Key }</a>
										<a href={ templ.SafeURL(t.Href) }>{ t.Title }</a>
										<span class="badge warn">{ i18n.T(ctx, "Pausada") }</span>
									</div>
									<p class="x">{ t.Reason }</p>
									<div class="s">
										if t.Persona != "" {
											{ t.Persona } ·
										}
										{ t.By } · { t.When } · { i18n.T(ctx, "vale também para as subtasks") }
									</div>
								</div>
								if canWrite(ctx) {
									<form class="inbox-act" method="post" action={ templ.SafeURL(t.ResumeHref) } hx-post={ t.ResumeHref } hx-swap="none">
										<a class="btn ghost sm" href={ templ.SafeURL(t.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Retomar") }</button>
									</form>
								} else {
									<div class="inbox-act">
										<a class="btn ghost sm" href={ templ.SafeURL(t.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										@NeedRole(domain.MemberMember)
									</div>
								}
							</div>
						}
					</section>
				}
				if len(vm.Blocked) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("alert")
							{ i18n.T(ctx, "Tasks bloqueadas") }
						<span class="cnt">{ fmt.Sprint(len(vm.Blocked)) }</span></div>
						for _, t := range vm.Blocked {
							<div class="inbox-row">
								@InboxItemCtl(t.Ctl)
								<span class="mini-avatar">@Icon("list")</span>
								<div class="main">
									<div class="t">
										<a class="mono id" href={ templ.SafeURL(t.Href) }>{ t.Key }</a>
										<a href={ templ.SafeURL(t.Href) }>{ t.Title }</a>
										<span class="badge danger">{ i18n.T(ctx, "Bloqueada") }</span>
									</div>
									<div class="s">
										if t.Persona != "" {
											{ t.Persona } ·
										}
										{ t.When } · { i18n.T(ctx, "sem gate pendente: alguém precisa destravar") }
									</div>
								</div>
								if canWrite(ctx) {
									<form class="inbox-act" method="post" action={ templ.SafeURL(t.ActionHref) } hx-post={ t.ActionHref } hx-swap="none">
										<a class="btn ghost sm" href={ templ.SafeURL(t.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										<button class="btn outline sm" type="submit">{ t.ActionLabel }</button>
									</form>
								} else {
									<div class="inbox-act">
										<a class="btn ghost sm" href={ templ.SafeURL(t.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										@NeedRole(domain.MemberMember)
									</div>
								}
							</div>
						}
					</section>
				}
				if len(vm.Failed) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("activity")
							{ i18n.T(ctx, "Execuções que falharam") }
						<span class="cnt">{ fmt.Sprint(len(vm.Failed)) }</span></div>
						for _, r := range vm.Failed {
							<div class="inbox-row">
								@InboxItemCtl(r.Ctl)
								<span class="mini-avatar">@Icon("activity")</span>
								<div class="main">
									<div class="t">
										<a class="mono id" href={ templ.SafeURL(r.TaskHref) }>{ r.TaskKey }</a>
										<a href={ templ.SafeURL(r.Href) }>{ r.TaskTitle }</a>
										<span class="badge danger">{ i18n.T(ctx, "Falhou") }</span>
									</div>
									if r.Error != "" {
										<p class="x">{ r.Error }</p>
									}
									<div class="s">{ r.Persona } · { i18n.T(ctx, "execução") }
										if r.Name != "" {
											{ r.Name }
										}
										<span class="mono">{ r.Short }</span> · { r.When }</div>
								</div>
								if r.ActionHref == "" {
									<div class="inbox-act">
										<a class="btn ghost sm" href={ templ.SafeURL(r.Href) }>{ i18n.T(ctx, "Ver log") }</a>
										<a class="btn outline sm" href={ templ.SafeURL(r.TaskHref) }>{ i18n.T(ctx, "Abrir conversa") }</a>
									</div>
								} else if canWrite(ctx) {
									<form class="inbox-act" method="post" action={ templ.SafeURL(r.ActionHref) } hx-post={ r.ActionHref } hx-swap="none">
										<a class="btn ghost sm" href={ templ.SafeURL(r.Href) }>{ i18n.T(ctx, "Ver log") }</a>
										<button class="btn outline sm" type="submit">
											@Icon("zap")
											{ i18n.T(ctx, "Acordar de novo") }
										</button>
									</form>
								} else {
									<div class="inbox-act">
										<a class="btn ghost sm" href={ templ.SafeURL(r.Href) }>{ i18n.T(ctx, "Ver log") }</a>
										@NeedRole(domain.MemberMember)
									</div>
								}
							</div>
						}
					</section>
				}
				if len(vm.Subs) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("shield")
							{ i18n.T(ctx, "Assinaturas travadas") }
						<span class="cnt">{ fmt.Sprint(len(vm.Subs)) }</span></div>
						for _, s := range vm.Subs {
							<div class="inbox-row">
								@InboxItemCtl(s.Ctl)
								<span class="mini-avatar gate">@Icon("shield")</span>
								<div class="main">
									<div class="t">
										<a href={ templ.SafeURL(s.Href) }>{ s.Name }</a>
										<span class="badge danger">{ i18n.T(ctx, "Trava semanal") }</span>
									</div>
									<p class="x">{ i18n.Tf(ctx, "Uso estimado de %s de %s (%s) passou da trava de %s%%: novas execuções cobertas por esta assinatura ficam bloqueadas.", s.Usage, s.Limit, s.Percent, fmt.Sprint(s.Guard)) }</p>
									<div class="s">{ i18n.Tf(ctx, "semana de %s · libera na virada da semana ou ao subir o teto", s.Week) }</div>
								</div>
								if canAdmin(ctx) {
									<form class="inbox-act" method="get" action={ templ.SafeURL(s.Href) }>
										<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Ajustar teto") }</button>
									</form>
								} else {
									<div class="inbox-act">
										@NeedRole(domain.MemberAdmin)
									</div>
								}
							</div>
						}
					</section>
				}
				if len(vm.Personas) > 0 {
					<section class="card inbox-sec">
						<div class="inbox-h">
							@Icon("bot")
							{ i18n.T(ctx, "Personas com erro") }
						<span class="cnt">{ fmt.Sprint(len(vm.Personas)) }</span></div>
						for _, p := range vm.Personas {
							<div class="inbox-row">
								@InboxItemCtl(p.Ctl)
								<span class="mini-avatar">@PersonaGlyph(p.Name)</span>
								<div class="main">
									<div class="t">
										<a href={ templ.SafeURL(p.Href) }>{ p.Name }</a>
										<span class="badge danger">{ i18n.T(ctx, "Erro") }</span>
									</div>
									if p.Error != "" {
										<p class="x">{ p.Error }</p>
									}
									<div class="s">
										{ p.Title }
										if p.Failures > 0 {
											· { i18n.Tf(ctx, "%d falhas seguidas", p.Failures) }
										}
										if p.When != "" {
											· { p.When }
										}
									</div>
								</div>
								if canAdmin(ctx) {
									<form class="inbox-act" method="post" action={ templ.SafeURL(p.ActionHref) } hx-post={ p.ActionHref } hx-swap="none">
										<a class="btn ghost sm" href={ templ.SafeURL(p.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Reativar") }</button>
									</form>
								} else {
									<div class="inbox-act">
										<a class="btn ghost sm" href={ templ.SafeURL(p.Href) }>{ i18n.T(ctx, "Abrir") }</a>
										@NeedRole(domain.MemberAdmin)
									</div>
								}
							</div>
						}
					</section>
				}
			</div>
			<aside class="stack">
				<section class="card pad">
					<h2>{ i18n.T(ctx, "Decisões") }</h2>
					<p class="sub">{ i18n.T(ctx, "Gates esperam por um humano. Nada anda sem a sua resposta.") }</p>
					<dl class="inbox-stats">
						<div><dt>{ i18n.T(ctx, "Aguardando") }</dt><dd class="mono">{ fmt.Sprint(vm.Pending) }</dd></div>
						<div><dt>{ i18n.T(ctx, "Envelhecendo (> 24 h)") }</dt><dd class="mono">{ fmt.Sprint(vm.Aged) }</dd></div>
						<div><dt>{ i18n.T(ctx, "Decididas hoje") }</dt><dd class="mono">{ fmt.Sprint(vm.DecidedToday) }</dd></div>
					</dl>
					<div class="d-grid gap-2 mt-4">
						<a class="btn outline block" href={ templ.SafeURL(vm.GatesURL) }>{ i18n.T(ctx, "Abrir gates") }</a>
						<a class="btn ghost block" href={ templ.SafeURL(vm.DecisionsURL) }>{ i18n.T(ctx, "Histórico de decisões") }</a>
					</div>
				</section>
			</aside>
		</div>
	}
}

// InboxItemCtl são os controles de um item da Caixa (ADR-0042): marcar lido/não lido e arquivar/desarquivar. Só a
// pessoa autenticada tem estado; sem ela (modo trusted) nada aparece.
templ InboxItemCtl(c InboxCtl) {
	if c.Show {
		<div class="inbox-ctl">
			if c.Unread {
				<span class="unread-dot" title={ i18n.T(ctx, "Não lido") } aria-label={ i18n.T(ctx, "Não lido") }></span>
			}
			if c.Archived {
				<form method="post" action={ templ.SafeURL(c.Action) } hx-post={ c.Action } hx-swap="none">
					<input type="hidden" name="item" value={ c.Ref }/>
					<input type="hidden" name="action" value="unarchive"/>
					<button class="icon-btn" type="submit" title={ i18n.T(ctx, "Devolver à Caixa") } aria-label={ i18n.T(ctx, "Devolver à Caixa") }>@Icon("inbox")</button>
				</form>
			} else {
				<form method="post" action={ templ.SafeURL(c.Action) } hx-post={ c.Action } hx-swap="none">
					<input type="hidden" name="item" value={ c.Ref }/>
					if c.Unread {
						<input type="hidden" name="action" value="read"/>
						<button class="icon-btn" type="submit" title={ i18n.T(ctx, "Marcar como lida") } aria-label={ i18n.T(ctx, "Marcar como lida") }>@Icon("circle-check")</button>
					} else {
						<input type="hidden" name="action" value="unread"/>
						<button class="icon-btn" type="submit" title={ i18n.T(ctx, "Marcar como não lida") } aria-label={ i18n.T(ctx, "Marcar como não lida") }>@Icon("mail")</button>
					}
				</form>
				<form method="post" action={ templ.SafeURL(c.Action) } hx-post={ c.Action } hx-swap="none">
					<input type="hidden" name="item" value={ c.Ref }/>
					<input type="hidden" name="action" value="archive"/>
					<button class="icon-btn" type="submit" title={ i18n.T(ctx, "Arquivar: sai da sua Caixa, a task e o gate seguem como estão") } aria-label={ i18n.T(ctx, "Arquivar") }>@Icon("archive")</button>
				</form>
			}
		</div>
	}
}
