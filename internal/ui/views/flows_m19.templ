package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/i18n"
)

// Variáveis, gatilhos, revisões e arquivar de um fluxo (ADR-0047).

templ FlowRunCard(vm FlowRunVM) {
	<form id="rodar" class="card pad form-card flow-run mb-6" method="post" action={ templ.SafeURL(vm.Href) } hx-boost="true">
		<h2 class="side-h mb-3">{ i18n.T(ctx, "Rodar agora") }</h2>
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="form-grid">
			for _, f := range vm.Fields {
				<div class="field">
					<label for={ "rv-" + f.Name }>
						{ flowVarLabel(f) }
						if f.Required {
							<span class="req" title={ i18n.T(ctx, "Obrigatória") }>*</span>
						}
					</label>
					<input class="input" id={ "rv-" + f.Name } name={ "var_" + f.Name } value={ f.Value } required?={ f.Required && f.Default == "" } maxlength="2000" placeholder={ f.Default } autocomplete="off"/>
				</div>
			}
		</div>
		<div class="form-actions">
			<button class="btn primary" type="submit">
				@Icon("play")
				{ i18n.T(ctx, "Rodar agora") }
			</button>
		</div>
	</form>
}

func flowVarLabel(f RunVarField) string {
	if f.Label != "" {
		return f.Label + " · " + f.Name
	}
	return f.Name
}

templ FlowArchiveBar(vm FlowM19VM) {
	if vm.Archived {
		@Alert("warn", i18n.Tf(ctx, "Este fluxo está arquivado desde %s: não dispara por nenhum caminho e não pode ser editado.", vm.ArchivedWhen))
		if canAdmin(ctx) {
			<form method="post" action={ templ.SafeURL(vm.ArchiveHref) } hx-boost="true" class="mb-6">
				<input type="hidden" name="acao" value="desarquivar"/>
				<button class="btn outline" type="submit">{ i18n.T(ctx, "Desarquivar") }</button>
			</form>
		}
	}
}

templ FlowTriggersCard(vm FlowTriggersVM, archived bool) {
	<h2 class="side-h sec-h" id="gatilhos">{ i18n.Tf(ctx, "Gatilhos · %s", fmt.Sprint(len(vm.Rows))) }</h2>
	<p class="muted text-sm mb-3">{ i18n.T(ctx, "Além da agenda, um fluxo dispara por webhook assinado (HMAC) ou por um evento do próprio sistema. Cada disparo cria uma task, com as variáveis tiradas da carga ou do evento.") }</p>
	if vm.SecretOnce != "" {
		<div class="alert warn" role="status">
			@Icon("alert")
			<div>
				<b>{ i18n.Tf(ctx, "Gatilho %s criado.", vm.SecretOnceName) }</b>
				<div>{ i18n.T(ctx, "Segredo HMAC (guarde agora, não será mostrado de novo):") } <code>{ vm.SecretOnce }</code></div>
				<div>{ i18n.T(ctx, "Envie POST para") } <code>{ vm.SecretOnceURL }</code> { i18n.T(ctx, "com o cabeçalho") } <code>X-Hanko-Signature: t=&lt;unix&gt;,v1=&lt;hmac-sha256 de "&lt;t&gt;.&lt;corpo&gt;"&gt;</code></div>
			</div>
		</div>
	}
	if vm.Error != "" {
		@Alert("danger", vm.Error)
	}
	if len(vm.Rows) == 0 {
		@EmptyCard("zap", i18n.T(ctx, "Nenhum gatilho."), i18n.T(ctx, "Sem gatilhos, o fluxo só dispara pela agenda ou pelo Rodar agora."), false)
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "Gatilho") }</th>
						<th>{ i18n.T(ctx, "Tipo") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Alvo") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Por minuto") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Último") }</th>
						<th class="act-col"></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range vm.Rows {
						<tr class={ "row", templ.KV("is-off", !r.Enabled) }>
							<td class="ttl">
								{ r.Name }
								if r.Detail != "" {
									<div class="note">{ r.Detail }</div>
								}
							</td>
							<td><span class="chip soft">{ r.KindLabel }</span></td>
							<td class="hide-sm"><code class="break">{ r.Target }</code>
								if r.Secret != "" {
									<div class="note">{ i18n.T(ctx, "segredo") } <code>{ r.Secret }</code></div>
								}
							</td>
							<td class="hide-sm muted">{ fmt.Sprint(r.Rate) }</td>
							<td class="hide-sm muted">{ r.Last }</td>
							<td class="act-col">
								if canAdmin(ctx) && !archived {
									<div class="row-acts">
										<form method="post" action={ templ.SafeURL(r.ToggleHref) } hx-boost="true">
											<button class="btn outline sm" type="submit">
												if r.Enabled {
													{ i18n.T(ctx, "Desligar") }
												} else {
													{ i18n.T(ctx, "Ligar") }
												}
											</button>
										</form>
										<form method="post" action={ templ.SafeURL(r.DeleteHref) } hx-boost="true" hx-confirm={ i18n.T(ctx, "Remover este gatilho?") }>
											<button class="btn ghost sm" type="submit">{ i18n.T(ctx, "Remover") }</button>
										</form>
									</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	if canAdmin(ctx) && !archived {
		<form class="card pad form-card mt-4" method="post" action={ templ.SafeURL(vm.AddHref) } hx-boost="true">
			<h3 class="side-h mb-3">{ i18n.T(ctx, "Novo gatilho") }</h3>
			<div class="form-grid">
				<div class="field">
					<label for="tg-kind">{ i18n.T(ctx, "Tipo") }</label>
					<select class="select" id="tg-kind" name="kind">
						<option value="webhook" selected?={ vm.FormKind != "event" }>{ i18n.T(ctx, "Webhook (HMAC)") }</option>
						<option value="event" selected?={ vm.FormKind == "event" }>{ i18n.T(ctx, "Evento interno") }</option>
					</select>
				</div>
				<div class="field">
					<label for="tg-name">{ i18n.T(ctx, "Nome") }</label>
					<input class="input" id="tg-name" name="name" value={ vm.FormName } required maxlength="80" placeholder="github"/>
				</div>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="tg-verb">{ i18n.T(ctx, "Evento (só para evento interno)") }</label>
					<input class="input mono" id="tg-verb" name="event_verb" value={ vm.FormVerb } maxlength="80" placeholder="task.created ou gate.*" autocomplete="off"/>
				</div>
				<div class="field">
					<label for="tg-rate">{ i18n.T(ctx, "Entregas por minuto") }</label>
					<input class="input" id="tg-rate" name="rate" value={ vm.FormRate } inputmode="numeric" placeholder="30"/>
				</div>
			</div>
			<div class="field">
				<label for="tg-filter">{ i18n.T(ctx, "Filtro do evento (uma condição caminho=valor por linha)") }</label>
				<textarea class="textarea mono" id="tg-filter" name="filter" rows="2" placeholder="data.priority=high">{ vm.FormFilter }</textarea>
			</div>
			<div class="field">
				<label for="tg-map">{ i18n.T(ctx, "Variáveis (uma por linha: variável=caminho.na.carga)") }</label>
				<textarea class="textarea mono" id="tg-map" name="mapping" rows="2" placeholder="repo=repository.full_name">{ vm.FormMapping }</textarea>
				<span class="hint">{ i18n.T(ctx, "Sem mapeamento, a variável lê a chave de mesmo nome da carga. No evento, use data.<campo>, subject_id, verb ou actor.id.") }</span>
			</div>
			<div class="field">
				<label for="tg-secret">{ i18n.T(ctx, "Segredo do webhook (opcional)") }</label>
				<input class="input mono" id="tg-secret" name="secret_ref" value={ vm.FormSecret } maxlength="120" placeholder="${secret:meu-hmac}" autocomplete="off"/>
				<span class="hint">{ i18n.T(ctx, "Em branco, o servidor gera um segredo e mostra o valor uma vez.") }</span>
			</div>
			<div class="form-actions">
				<button class="btn primary" type="submit">{ i18n.T(ctx, "Criar gatilho") }</button>
			</div>
		</form>
	}
}

templ FlowRevisionsCard(rows []RevisionRow, archived bool) {
	<h2 class="side-h sec-h" id="revisoes">{ i18n.Tf(ctx, "Revisões · %s", fmt.Sprint(len(rows))) }</h2>
	if len(rows) == 0 {
		@EmptyCard("clock", i18n.T(ctx, "Nenhuma revisão."), i18n.T(ctx, "Cada mudança da definição guarda uma revisão que não se altera."), false)
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "Revisão") }</th>
						<th>{ i18n.T(ctx, "Quando") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Origem") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Autor") }</th>
						<th>{ i18n.T(ctx, "O que mudou") }</th>
						<th class="act-col"></th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr class="row">
							<td class="id">
								#{ fmt.Sprint(r.N) }
								if r.Current {
									<span class="badge run">{ i18n.T(ctx, "vigente") }</span>
								}
							</td>
							<td class="muted">{ r.When }</td>
							<td class="hide-sm muted">{ r.Origin }</td>
							<td class="hide-sm muted">{ r.Actor }</td>
							<td class="muted">{ r.Summary }</td>
							<td class="act-col">
								if canAdmin(ctx) && !archived && !r.Current {
									<form method="post" action={ templ.SafeURL(r.RestoreHref) } hx-boost="true" hx-confirm={ i18n.T(ctx, "Restaurar esta revisão? A definição volta a ela como uma edição nova (os gatilhos não mudam).") }>
										<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Restaurar") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ FlowArchiveAction(vm FlowM19VM) {
	if canAdmin(ctx) && !vm.Archived {
		<form method="post" action={ templ.SafeURL(vm.ArchiveHref) } hx-boost="true" class="mt-4" hx-confirm={ i18n.T(ctx, "Arquivar este fluxo? Ele some da lista e não dispara mais; as tasks e o histórico ficam.") }>
			<input type="hidden" name="acao" value="arquivar"/>
			<button class="btn ghost" type="submit">{ i18n.T(ctx, "Arquivar fluxo") }</button>
		</form>
	}
}
