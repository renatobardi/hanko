package views

import "fmt"

// BudgetMeter is the spend-versus-ceiling bar. The tinted red state is reserved
// for an exceeded budget (hard stop); the warning state is amber.
templ BudgetMeter(b BudgetBox) {
	<div class={ "meter", "m-" + b.State }>
		<div class="meter-top">
			<span class="meter-spent mono">{ b.Spent }</span>
			if b.Limit != "" {
				<span class="muted">de <span class="mono">{ b.Limit }</span></span>
				<span class="meter-pct mono">{ b.PercentTxt }</span>
			} else {
				<span class="muted">sem limite definido</span>
			}
		</div>
		if b.Limit != "" {
			<div class="progress meter-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ fmt.Sprint(b.Percent) } aria-label={ b.Label }><i style={ pct(b.Percent) }></i></div>
		}
		if b.StateText != "" {
			<p class="meter-note">{ b.StateText }</p>
		}
	</div>
}

templ BudgetForm(b BudgetBox, id string) {
	<form class="budget-form" method="post" action={ templ.SafeURL(b.Action) }>
		<label class="sr-only" for={ id }>Limite mensal em dólares</label>
		<span class="usd-field">
			<span class="pre mono">US$</span>
			<input class="input sm mono" id={ id } name="budget" inputmode="decimal" value={ b.Value } placeholder="sem limite" autocomplete="off"/>
		</span>
		<button class="btn outline sm" type="submit">Salvar limite</button>
	</form>
}

templ DayChartEl(c DayChart) {
	<div class="chart">
		if !c.HasData {
			<p class="muted chart-empty">Nenhum gasto no período.</p>
		} else {
			<svg class="chart-svg" viewBox={ fmt.Sprintf("0 0 %d %d", c.W, c.H) } preserveAspectRatio="none" role="img" aria-label={ "Gasto por dia, " + c.Peak }>
				<line class="grid" x1="0" x2={ fmt.Sprint(c.W) } y1={ fmt.Sprint(c.H - 1) } y2={ fmt.Sprint(c.H - 1) }></line>
				<line class="grid dash" x1="0" x2={ fmt.Sprint(c.W) } y1={ fmt.Sprint(c.H / 2) } y2={ fmt.Sprint(c.H / 2) }></line>
				for _, b := range c.Bars {
					<g>
						<title>{ b.Title }</title>
						if b.H > 0 {
							<rect class={ "bar", templ.KV("peak", b.Peak) } x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.Y) } width={ fmt.Sprint(b.W) } height={ fmt.Sprint(b.H) } rx="1.5"></rect>
						}
						if b.EH > 0 {
							<rect class="bar est" x={ fmt.Sprint(b.X) } y={ fmt.Sprint(b.EY) } width={ fmt.Sprint(b.W) } height={ fmt.Sprint(b.EH) } rx="1.5"></rect>
						}
					</g>
				}
			</svg>
			<div class="chart-axis"><span>{ c.First }</span><span class="hide-sm">{ c.Mid }</span><span>{ c.Last }</span></div>
			<div class="chart-legend"><span><i class="sw rep"></i>Reportado pelo harness</span><span><i class="sw est"></i>Estimado pela tabela de preços</span></div>
		}
	</div>
}

templ CostTable(t CostTableVM) {
	<section class="card pad">
		<div class="card-head"><h2>{ t.Title }</h2></div>
		if len(t.Rows) == 0 {
			<p class="muted">Sem dados no período.</p>
		} else {
			<table class="table mini">
				<thead>
					<tr><th>{ t.Title }</th><th class="num" title="Real + estimado">Gasto</th><th class="num hide-sm" title="Tokens × preço de tabela vigente">Lista</th><th class="num hide-sm" title="Rateio da mensalidade das assinaturas">Pago</th><th class="num hide-sm">Execuções</th><th class="num hide-sm">Tokens</th></tr>
				</thead>
				<tbody>
					for _, r := range t.Rows {
						<tr>
							<td>
								if r.Href != "" {
									<a href={ templ.SafeURL(r.Href) }>{ r.Label }</a>
								} else {
									{ r.Label }
								}
								<span class="share"><i style={ pct(r.Share) }></i></span>
							</td>
							<td class="num mono">
								{ r.Cost }
								if r.Estimated {
									<span class="est-mark" title="Inclui valor estimado pela tabela de preços">est.</span>
								}
							</td>
							<td class="num mono hide-sm">{ r.List }</td>
							<td class="num mono hide-sm">{ r.Paid }</td>
							<td class="num mono hide-sm">{ r.Runs }</td>
							<td class="num mono hide-sm">{ r.Tokens }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

// CostLegend explains the four costs of a run.
templ CostLegend() {
	<section class="card pad cost-legend" style="margin-top:20px">
		<div class="card-head"><h2>Os quatro custos</h2></div>
		<dl class="kv">
			<dt>Real</dt><dd>Valor informado pelo harness ao fim da execução. É o que conta no orçamento.</dd>
			<dt>Estimado</dt><dd>Tokens × tabela de preços, usado quando o harness não informa o valor. Também conta no orçamento.</dd>
			<dt>Lista</dt><dd>Tokens × preço de tabela vigente quando a execução terminou, sempre calculado. Mostra quanto custaria sem assinatura.</dd>
			<dt>Pago</dt><dd>Mensalidade da assinatura ÷ dias do mês, dividida entre as execuções do dia em proporção ao custo de lista. Dia sem uso aparece como "sem uso".</dd>
		</dl>
	</section>
}

templ DayCostTable(days []DayCostVM) {
	<section class="card pad" style="margin-top:20px">
		<div class="card-head"><h2>Custos por dia</h2></div>
		<table class="table mini">
			<thead><tr><th>Dia</th><th class="num">Real</th><th class="num">Estimado</th><th class="num hide-sm">Lista</th><th class="num">Pago</th></tr></thead>
			<tbody>
				for _, d := range days {
					<tr>
						<td>{ d.Label }</td>
						<td class="num mono">{ d.Real }</td>
						<td class="num mono">{ d.Estimated }</td>
						<td class="num mono hide-sm">{ d.List }</td>
						<td class="num mono">
							if d.Unused {
								<span class="muted" title={ "Mensalidade do dia sem uso: " + d.Idle }>sem uso</span>
							} else {
								{ d.Paid }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

templ SubscriptionsSection(vm CostsVM) {
	<section class="card pad" id="assinaturas" style="margin-top:20px">
		<div class="card-head">
			<div>
				<h2>Assinaturas</h2>
				<p class="sub">Plano de um harness: a mensalidade é rateada nas execuções (custo pago). Quando o uso estimado da semana chega ao percentual de trava do teto semanal, novas execuções cobertas ficam bloqueadas.</p>
			</div>
		</div>
		if len(vm.Subs) == 0 {
			<p class="muted">Nenhuma assinatura. Cadastre abaixo e vincule personas a ela na página da persona.</p>
		} else {
			<table class="table mini pb-table">
				<thead><tr><th>Assinatura</th><th class="num">Mensalidade</th><th class="hide-sm">Uso da semana</th><th class="num hide-sm">Pago no período</th><th>Ajustes</th></tr></thead>
				<tbody>
					for i, s := range vm.Subs {
						<tr class={ templ.KV("b-exceeded", s.Blocked) }>
							<td>
								<b>{ s.Name }</b>
								<div class="sub-line">{ s.Agent } · { s.Models }
									if !s.Active {
										· <span class="badge outline">desligada</span>
									}
									if s.Blocked {
										· <span class="badge danger">travada</span>
									}
								</div>
							</td>
							<td class="num mono">{ s.Monthly }</td>
							<td class="hide-sm">
								if s.WeekLimit != "" {
									<div class={ "pb-use", templ.KV("m-exceeded", s.Blocked) }><div class="progress meter-bar"><i style={ pct(s.WeekPercent) }></i></div><span class="mono">{ s.WeekPctTxt }</span></div>
									<div class="meter-note">{ s.WeekUsage } de { s.WeekLimit } · trava em { fmt.Sprint(s.GuardPct) }%</div>
								} else {
									<span class="muted">sem trava semanal</span>
								}
							</td>
							<td class="num mono hide-sm">{ s.Paid }<div class="meter-note">sem uso: { s.Idle }</div></td>
							<td>
								<form class="budget-form" method="post" action={ templ.SafeURL(s.UpdateAction) } style="flex-wrap:wrap;gap:6px">
									<label class="sr-only" for={ fmt.Sprintf("sub-monthly-%d", i) }>Mensalidade em dólares</label>
									<span class="usd-field"><span class="pre mono">US$</span><input class="input sm mono" id={ fmt.Sprintf("sub-monthly-%d", i) } name="monthly" inputmode="decimal" value={ s.MonthlyValue } autocomplete="off" title="Mensalidade"/></span>
									<label class="sr-only" for={ fmt.Sprintf("sub-limit-%d", i) }>Teto semanal em dólares</label>
									<span class="usd-field"><span class="pre mono">sem.</span><input class="input sm mono" id={ fmt.Sprintf("sub-limit-%d", i) } name="weekly_limit" inputmode="decimal" value={ s.LimitValue } placeholder="sem trava" autocomplete="off" title="Teto semanal"/></span>
									<label class="sr-only" for={ fmt.Sprintf("sub-guard-%d", i) }>Trava em %</label>
									<span class="usd-field"><input class="input sm mono" id={ fmt.Sprintf("sub-guard-%d", i) } name="guard_pct" inputmode="numeric" value={ fmt.Sprint(s.GuardPct) } autocomplete="off" title="Trava em % do teto semanal" style="width:56px"/><span class="pre mono">%</span></span>
									<label class="sr-only" for={ fmt.Sprintf("sub-models-%d", i) }>Prefixos de modelo cobertos</label>
									<input class="input sm" id={ fmt.Sprintf("sub-models-%d", i) } name="models" value={ s.ModelsValue } placeholder="todos os modelos" autocomplete="off" title="Prefixos de modelo cobertos, separados por vírgula"/>
									<label class="check"><input type="checkbox" name="active" value="1" checked?={ s.Active }/><span>Ligada</span></label>
									<button class="btn outline sm" type="submit">Salvar</button>
								</form>
								if s.CanDelete {
									<form method="post" action={ templ.SafeURL(s.DeleteAction) } style="margin-top:6px"><button class="btn ghost sm" type="submit">Remover</button></form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<h3 class="side-h" style="margin:22px 0 10px">Nova assinatura</h3>
		<form class="budget-form" method="post" action={ templ.SafeURL(vm.SubCreate) } style="flex-wrap:wrap;gap:8px">
			<label class="sr-only" for="sub-new-name">Nome</label>
			<input class="input sm" id="sub-new-name" name="name" required maxlength="120" placeholder="Nome (ex.: Claude Max)" autocomplete="off"/>
			<label class="sr-only" for="sub-new-agent">Harness</label>
			@Select("agent", "sub-new-agent", vm.AgentOpts, true)
			<label class="sr-only" for="sub-new-monthly">Mensalidade em dólares</label>
			<span class="usd-field"><span class="pre mono">US$</span><input class="input sm mono" id="sub-new-monthly" name="monthly" inputmode="decimal" required placeholder="mensalidade" autocomplete="off"/></span>
			<label class="sr-only" for="sub-new-limit">Teto semanal em dólares</label>
			<span class="usd-field"><span class="pre mono">sem.</span><input class="input sm mono" id="sub-new-limit" name="weekly_limit" inputmode="decimal" placeholder="teto semanal" autocomplete="off"/></span>
			<label class="sr-only" for="sub-new-guard">Trava em %</label>
			<span class="usd-field"><input class="input sm mono" id="sub-new-guard" name="guard_pct" inputmode="numeric" value="90" autocomplete="off" style="width:56px"/><span class="pre mono">%</span></span>
			<label class="sr-only" for="sub-new-models">Prefixos de modelo cobertos</label>
			<input class="input sm" id="sub-new-models" name="models" placeholder="modelos cobertos (prefixos, vírgula)" autocomplete="off"/>
			<button class="btn primary sm" type="submit">Criar assinatura</button>
		</form>
	</section>
}

templ CostsPage(sh Shell, vm CostsVM) {
	@Layout(sh) {
		@PageHead("Custos e orçamentos", vm.Subtitle) {
			@Tabs(vm.Tabs)
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="kpis">
			@Kpi("database", vm.Total, vm.TotalNote, false)
			@Kpi("trending-up", vm.BudgetKpi, vm.BudgetNote, vm.Company.State == "exceeded")
			@Kpi("clock", vm.Estimated, vm.EstNote, false)
			@Kpi("shield", vm.Paid, vm.PaidNote, false)
		</div>
		@CostLegend()
		<section class={ "card pad budget-card", "b-" + vm.Company.State }>
			<div class="card-head">
				<div>
					<h2>Orçamento da empresa · { vm.Month }</h2>
					<p class="sub">Ao chegar em 100% do limite, nenhuma persona abre execução nova até o limite subir ou o mês virar.</p>
				</div>
			</div>
			@BudgetMeter(vm.Company)
			@BudgetForm(vm.Company, "company-budget")
		</section>
		<div class="costs-grid">
			<section class="card pad">
				<div class="card-head"><h2>Gasto por dia</h2><span class="sub">{ vm.Chart.Peak }</span></div>
				@DayChartEl(vm.Chart)
			</section>
		</div>
		if len(vm.Days) > 0 {
			@DayCostTable(vm.Days)
		}
		@SubscriptionsSection(vm)
		<section class="card pad" style="margin-top:20px">
			<div class="card-head"><h2>Orçamento por persona</h2><span class="sub">{ vm.Month }</span></div>
			if len(vm.Personas) == 0 {
				<p class="muted">Nenhuma persona contratada.</p>
			} else {
				<table class="table mini pb-table">
					<thead><tr><th>Persona</th><th class="num">Gasto</th><th class="hide-sm">Uso do limite</th><th>Limite mensal</th></tr></thead>
					<tbody>
						for i, p := range vm.Personas {
							<tr class={ "b-" + p.State }>
								<td><a href={ templ.SafeURL(p.Href) }><b>{ p.Label }</b></a></td>
								<td class="num mono">{ p.Spent }</td>
								<td class="hide-sm">
									if p.Limit != "" {
										<div class={ "pb-use", "m-" + p.State }><div class="progress meter-bar"><i style={ pct(p.Percent) }></i></div><span class="mono">{ p.PercentTxt }</span></div>
										if p.StateText != "" {
											<div class="meter-note">{ p.StateText }</div>
										}
									} else {
										<span class="muted">sem limite</span>
									}
								</td>
								<td>@BudgetForm(p, fmt.Sprintf("persona-budget-%d", i))</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
		<div class="grid-2 costs-tables">
			for _, t := range vm.Tables {
				@CostTable(t)
			}
		</div>
	}
}
