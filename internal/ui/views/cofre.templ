package views

import (
	"fmt"
	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ fieldRow(f SecretFieldRowVM, canWrite bool) {
	<tr class="row">
		<td>
			<b>{ f.Name }</b>
			<div class="sub-line"><code class="mono">{ f.Reference }</code></div>
		</td>
		<td><span class="badge outline">{ f.Kind }</span></td>
		<td>
			if f.Sensitive {
				<span class="badge warn">{ i18n.T(ctx, "secreto") }</span>
			} else {
				<span class="badge done">{ i18n.T(ctx, "visível") }</span>
			}
		</td>
		<td class="num">{ fmt.Sprint(f.Version) }</td>
		<td class="hide-sm">
			if f.Kind == "file" {
				<code class="mono">{ f.FileName }</code> <span class="muted">{ f.FileSize }</span>
			} else if f.Sensitive {
				if f.Revealed {
					<span class="muted">{ i18n.T(ctx, "sim") }</span>
				} else {
					<span class="muted">{ i18n.T(ctx, "não") }</span>
				}
			} else {
				<code class="mono">{ f.VisibleText }</code>
			}
		</td>
		<td>
			if canWrite {
				<details class="sec-actions">
					<summary class="btn outline sm">{ i18n.T(ctx, "Ações") }</summary>
					if f.Kind == "file" {
						<form method="post" action={ templ.SafeURL(f.ReplaceHref) } enctype="multipart/form-data" hx-boost="true" class="mt-2">
							<p class="muted text-sm">{ i18n.T(ctx, "Troca o conteúdo pelo arquivo novo. O conteúdo anterior é substituído: ele não fica no histórico e não volta à tela.") }</p>
							<input class="input" name="arquivo" type="file" aria-label={ i18n.T(ctx, "Arquivo novo") }/>
							<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Trocar arquivo") }</button>
						</form>
						<form method="post" action={ templ.SafeURL(f.DeleteHref) } hx-boost="true" class="mt-2">
							<p class="muted text-sm">{ i18n.T(ctx, "Apagar o campo apaga também o arquivo dele.") }</p>
							<input class="input" name="senha" type="password" autocomplete="current-password" maxlength="256" placeholder={ i18n.T(ctx, "senha da conta (se o servidor pedir)") } aria-label={ i18n.T(ctx, "senha da conta (se o servidor pedir)") }/>
							<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Apagar campo") }</button>
						</form>
					} else {
					<form method="post" action={ templ.SafeURL(f.ValueHref) } hx-boost="true" class="mt-2">
						<input class="input mono" name="value" type="password" autocomplete="new-password" placeholder={ i18n.T(ctx, "novo valor") } maxlength="8192"/>
						<label class="check-line"><input type="checkbox" name="generate" value="1"/><span>{ i18n.T(ctx, "gerar") }</span></label>
						@genOptionsFields()
						<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Trocar valor") }</button>
					</form>
					<form method="post" action={ templ.SafeURL(f.MetaHref) } hx-boost="true" class="mt-2">
						if f.Kind == "text" {
							<select class="select" name="visibilidade" aria-label={ i18n.T(ctx, "Visibilidade") }>
								<option value="secreto" selected?={ f.Sensitive }>{ i18n.T(ctx, "secreto") }</option>
								<option value="visivel" selected?={ !f.Sensitive }>{ i18n.T(ctx, "visível") }</option>
							</select>
							<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Mudar marca") }</button>
						}
					</form>
					}
				</details>
			}
		</td>
	</tr>
}

templ SecretFieldsPage(sh Shell, vm SecretFieldsVM) {
	@Layout(sh) {
		@PageHead(vm.Name, i18n.T(ctx, "Campos do segredo. Campo visível mostra o texto; campo secreto nunca volta para a tela.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar aos segredos") }</a></p>
		@flashAlerts(vm.Notice, vm.Error)
		if vm.Reveal != nil {
			@revealBox(vm.Reveal.Name, vm.Reveal.Reference, vm.Reveal.Value)
		}
		if len(vm.Fields) == 0 {
			@EmptyCard("lock", i18n.T(ctx, "Nenhum campo."), i18n.T(ctx, "Um segredo pode ter vários campos, como usuário e senha, cada um com a sua marca de visível ou secreto."), false)
		} else {
			<div class="table-wrap mb-6">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Nome") }</th>
							<th>{ i18n.T(ctx, "Tipo") }</th>
							<th>{ i18n.T(ctx, "Visibilidade") }</th>
							<th class="num">{ i18n.T(ctx, "Versão") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Valor / revelado") }</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, f := range vm.Fields {
							@fieldRow(f, vm.CanWrite)
						}
					</tbody>
				</table>
			</div>
		}
		<p class="muted text-sm mb-3">{ i18n.T(ctx, "Revelar um campo secreto, ver o histórico de versões e restaurar uma versão: requer reautenticação (fatia 2, #57).") }</p>
		if vm.CanWrite {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Novo campo") }</h2>
			<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.CreateHref) } enctype="multipart/form-data" hx-boost="true">
				<div class="form-grid">
					<div class="field">
						<label for="fld-name">{ i18n.T(ctx, "Nome") }</label>
						<input class="input mono" id="fld-name" name="name" value={ vm.NewName } required maxlength="64" autocomplete="off" spellcheck="false"/>
					</div>
					<div class="field">
						<label for="fld-kind">{ i18n.T(ctx, "Tipo") }</label>
						<select class="select" id="fld-kind" name="kind">
							<option value="text" selected?={ vm.NewKind != "totp" && vm.NewKind != "file" }>text</option>
							<option value="totp" selected?={ vm.NewKind == "totp" }>totp</option>
							<option value="file" selected?={ vm.NewKind == "file" }>file</option>
						</select>
					</div>
					<div class="field">
						<label for="fld-vis">{ i18n.T(ctx, "Visibilidade") }</label>
						<select class="select" id="fld-vis" name="visibilidade">
							<option value="secreto" selected?={ !vm.NewVisible }>{ i18n.T(ctx, "secreto") }</option>
							<option value="visivel" selected?={ vm.NewVisible }>{ i18n.T(ctx, "visível") }</option>
						</select>
					</div>
				</div>
				<div class="field">
					<label for="fld-val">{ i18n.T(ctx, "Valor") }</label>
					<input class="input mono" id="fld-val" name="value" type="password" value="" autocomplete="new-password" spellcheck="false" maxlength="8192"/>
					<span class="hint">{ i18n.T(ctx, "O valor é cifrado. Campo secreto nunca volta para a tela; em branco com a opção abaixo, o Hanko gera um e o mostra uma única vez.") }</span>
				</div>
				<div class="field">
					<label for="fld-file">{ i18n.T(ctx, "Arquivo (só para o tipo file)") }</label>
					<input class="input" id="fld-file" name="arquivo" type="file"/>
					<span class="hint">{ i18n.T(ctx, "Até 1 MiB. Campo arquivo é sempre secreto e o conteúdo nunca volta para a tela; a persona o recebe por ${secretfile:…}.") }</span>
				</div>
				<label class="check-line">
					<input type="checkbox" name="generate" value="1" checked?={ vm.NewGenerate }/>
					<span>{ i18n.T(ctx, "Gerar o valor e mostrá-lo uma vez") }</span>
				</label>
				@genOptionsFields()
				<div class="form-actions">
					<button class="btn primary" type="submit">{ i18n.T(ctx, "Adicionar campo") }</button>
				</div>
			</form>
		} else {
			@NeedRole(domain.MemberAdmin)
		}
		if vm.User && vm.CanWrite {
			@delegationSection(vm)
		}
	}
}

// delegationSection lista e cria as delegações deste segredo pessoal (ADR-0068 §6). Mostra alvo, prazo e estado; o
// valor do segredo nunca entra aqui.
templ delegationSection(vm SecretFieldsVM) {
	<h2 class="side-h sec-h">{ i18n.T(ctx, "Delegações deste segredo") }</h2>
	<p class="muted text-sm mb-3">{ i18n.T(ctx, "Vale pelo prazo escolhido (padrão 24 h, máximo 7 dias) ou até ser revogada. Só o trabalho que você pediu pode recebê-la; a run usa o segredo sem mostrar o valor.") }</p>
	if len(vm.Delegations) == 0 {
		<p class="muted mb-3">{ i18n.T(ctx, "Nenhuma delegação deste segredo.") }</p>
	} else {
		<div class="table-wrap mb-6">
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "Alvo") }</th>
						<th>{ i18n.T(ctx, "Expira em") }</th>
						<th>{ i18n.T(ctx, "Estado") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, d := range vm.Delegations {
						@delegationRow(d)
					}
				</tbody>
			</table>
		</div>
	}
	<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.DelegateHref) } hx-boost="true">
		<div class="form-grid">
			<div class="field">
				<label for="del-type">{ i18n.T(ctx, "Tipo do alvo") }</label>
				<select class="select" id="del-type" name="alvo_tipo">
					<option value="task" selected?={ vm.DelegateType != "conversation" && vm.DelegateType != "run" }>task</option>
					<option value="conversation" selected?={ vm.DelegateType == "conversation" }>conversation</option>
					<option value="run" selected?={ vm.DelegateType == "run" }>run</option>
				</select>
			</div>
			<div class="field">
				<label for="del-target">{ i18n.T(ctx, "ID do alvo") }</label>
				<input class="input mono" id="del-target" name="alvo" value={ vm.DelegateTarget } required maxlength="36" autocomplete="off" spellcheck="false"/>
				<span class="hint">{ i18n.T(ctx, "Id da task ou da conversa que você pediu, ou de uma run em curso dela.") }</span>
			</div>
			<div class="field">
				<label for="del-exp">{ i18n.T(ctx, "Validade") }</label>
				<select class="select" id="del-exp" name="prazo">
					<option value="3600">{ i18n.T(ctx, "1 hora") }</option>
					<option value="86400" selected>{ i18n.T(ctx, "24 horas (padrão)") }</option>
					<option value="604800">{ i18n.T(ctx, "7 dias (máximo)") }</option>
				</select>
			</div>
		</div>
		<div class="form-actions">
			<button class="btn primary" type="submit">{ i18n.T(ctx, "Delegar") }</button>
		</div>
	</form>
}

templ delegationRow(d DelegationRowVM) {
	<tr class="row">
		<td><code class="mono">{ d.Target }</code></td>
		<td>{ d.ExpiresAt }</td>
		<td><span class="badge outline">{ d.State }</span></td>
		<td>
			if d.Active {
				<form method="post" action={ templ.SafeURL(d.RevokeHref) } hx-boost="true">
					<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Revogar") }</button>
				</form>
			}
		</td>
	</tr>
}

templ CollectionsPage(sh Shell, vm CollectionsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Coleções de segredos"), i18n.T(ctx, "Agrupam segredos para dar acesso e cobrar a rotação de uma vez.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar aos segredos") }</a></p>
		@flashAlerts(vm.Notice, vm.Error)
		<div class="table-wrap mb-6">
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "Nome") }</th>
						<th>{ i18n.T(ctx, "Padrão") }</th>
						<th class="num">{ i18n.T(ctx, "Segredos") }</th>
						<th class="hide-sm">{ i18n.T(ctx, "Prazo de rotação (dias)") }</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range vm.Rows {
						<tr class="row">
							<td>
								<a href={ templ.SafeURL(r.Href) }><b>{ r.Name }</b></a>
								if r.Description != "" {
									<div class="sub-line">{ r.Description }</div>
								}
							</td>
							<td>
								if r.IsDefault {
									<span class="badge done">{ i18n.T(ctx, "padrão") }</span>
								}
							</td>
							<td class="num">{ fmt.Sprint(r.Secrets) }</td>
							<td class="hide-sm muted">{ r.RotateDays }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if vm.CanAdmin {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Nova coleção") }</h2>
			<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.CreateHref) } hx-boost="true">
				<div class="form-grid">
					<div class="field">
						<label for="col-name">{ i18n.T(ctx, "Nome") }</label>
						<input class="input" id="col-name" name="name" value={ vm.NewName } required maxlength="64"/>
					</div>
					<div class="field">
						<label for="col-desc">{ i18n.T(ctx, "Descrição (opcional)") }</label>
						<input class="input" id="col-desc" name="description" value={ vm.NewDesc } maxlength="300"/>
					</div>
					<div class="field">
						<label for="col-days">{ i18n.T(ctx, "Prazo de rotação (dias)") }</label>
						<input class="input" id="col-days" name="rotate_after_days" type="number" min="1" max="3650" value={ vm.NewDays }/>
					</div>
				</div>
				<div class="form-actions">
					<button class="btn primary" type="submit">{ i18n.T(ctx, "Criar coleção") }</button>
				</div>
			</form>
		}
	}
}

templ CollectionPage(sh Shell, vm CollectionVM) {
	@Layout(sh) {
		@PageHead(vm.Name, vm.Desc) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar às coleções") }</a></p>
		@flashAlerts(vm.Notice, vm.Error)
		if vm.IsDefault {
			<p class="mb-3"><span class="badge done">{ i18n.T(ctx, "padrão") }</span></p>
		}
		if vm.RotateDays != "" {
			<p class="muted text-sm mb-3">{ i18n.Tf(ctx, "Prazo de rotação: %s dias.", vm.RotateDays) }</p>
		}
		if len(vm.Secrets) == 0 {
			@EmptyCard("lock", i18n.T(ctx, "Nenhum segredo nesta coleção."), "", false)
		} else {
			<div class="table-wrap mb-6">
				<table class="table">
					<thead><tr><th>{ i18n.T(ctx, "Nome") }</th><th></th></tr></thead>
					<tbody>
						for _, s := range vm.Secrets {
							<tr class="row">
								<td><b>{ s.Name }</b></td>
								<td>
									if vm.CanAdmin {
										<form method="post" action={ templ.SafeURL(s.RemoveHref) } hx-boost="true">
											<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Tirar da coleção") }</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<p class="muted text-sm mb-3">{ i18n.Tf(ctx, "Concessões da coleção: %d. Conceder e revogar: requer reautenticação (fatia 2, #57).", vm.GrantCount) }</p>
		if vm.CanAdmin {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Pôr um segredo na coleção") }</h2>
			<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.AddHref) } hx-boost="true">
				<div class="field">
					<label for="col-add">{ i18n.T(ctx, "Nome do segredo") }</label>
					<input class="input mono" id="col-add" name="secret" required maxlength="64" autocomplete="off" spellcheck="false"/>
				</div>
				<div class="form-actions">
					<button class="btn primary" type="submit">{ i18n.T(ctx, "Pôr na coleção") }</button>
				</div>
			</form>
			if !vm.IsDefault {
				<form method="post" action={ templ.SafeURL(vm.DeleteHref) } hx-boost="true" class="mt-4">
					<button class="btn outline sm danger" type="submit">{ i18n.T(ctx, "Apagar coleção") }</button>
				</form>
			}
		}
	}
}

// revealBox mostra o valor revelado uma vez (criação gerada, rotação ou revelar), com a referência para citar.
templ revealBox(name, reference, value string) {
	<div class="alert warn secret-box" role="status">
		@Icon("alert")
		<div>
			<b>{ i18n.Tf(ctx, "Valor de %s: copie agora, ele não será mostrado de novo.", name) }</b>
			<div><code class="mono secret-val">{ value }</code></div>
			<div class="sub-line">{ i18n.T(ctx, "Referência:") } <code class="mono">{ reference }</code></div>
		</div>
	</div>
}

// flashAlerts mostra o aviso e o erro de uma tela do cofre.
templ flashAlerts(notice, errMsg string) {
	if notice != "" {
		@Alert("warn", notice)
	}
	if errMsg != "" {
		@Alert("danger", errMsg)
	}
}

// genOptionsFields é o bloco do gerador (ADR-0068 §7.1): tamanho, classes ou frase-senha. Tudo em branco é o padrão de
// sempre (32 bytes aleatórios). Sem id nos campos: o bloco se repete por linha em algumas tabelas.
templ genOptionsFields() {
	<details class="gen-opts">
		<summary>{ i18n.T(ctx, "Opções do gerador") }</summary>
		<label class="field">
			<span>{ i18n.T(ctx, "Tamanho (8 a 128 caracteres)") }</span>
			<input class="input mono" name="gen_length" type="number" min="8" max="128" inputmode="numeric"/>
		</label>
		<fieldset class="field">
			<legend>{ i18n.T(ctx, "Classes de caractere") }</legend>
			<label class="check-line"><input type="checkbox" name="gen_class" value="lower"/><span>{ i18n.T(ctx, "minúsculas") }</span></label>
			<label class="check-line"><input type="checkbox" name="gen_class" value="upper"/><span>{ i18n.T(ctx, "maiúsculas") }</span></label>
			<label class="check-line"><input type="checkbox" name="gen_class" value="digits"/><span>{ i18n.T(ctx, "dígitos") }</span></label>
			<label class="check-line"><input type="checkbox" name="gen_class" value="symbols"/><span>{ i18n.T(ctx, "símbolos") }</span></label>
		</fieldset>
		<label class="field">
			<span>{ i18n.T(ctx, "Frase-senha (palavras, 3 a 12)") }</span>
			<input class="input" name="gen_words" type="number" min="3" max="12" inputmode="numeric"/>
			<span class="hint">{ i18n.T(ctx, "Frase-senha não combina com tamanho nem classes.") }</span>
		</label>
	</details>
}

// SecretsHealthPage mostra o relatório de saúde dos segredos da empresa (ADR-0068 §7.2): contagem por categoria e a
// lista de achados. Nenhum valor de campo nem HMAC aparece.
templ SecretsHealthPage(sh Shell, vm SecretsHealthVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Saúde dos segredos"), i18n.T(ctx, "Repetidos, velhos, sem uso, órfãos e fracos. Calculado aqui, sem chamada a serviço externo.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar aos segredos") }</a></p>
		@flashAlerts("", vm.Error)
		<div class="table-wrap mb-6">
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "Categoria") }</th>
						<th class="num">{ i18n.T(ctx, "Achados") }</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range vm.Counts {
						<tr class="row">
							<td>{ c.Label }</td>
							<td class="num">{ c.Count }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(vm.Rows) == 0 {
			<p class="muted">{ i18n.T(ctx, "Nenhum achado.") }</p>
		} else {
			<div class="table-wrap mb-6">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Categoria") }</th>
							<th>{ i18n.T(ctx, "Segredo") }</th>
							<th>{ i18n.T(ctx, "Campo") }</th>
							<th>{ i18n.T(ctx, "Detalhe") }</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							<tr class="row">
								<td>{ r.Kind }</td>
								<td><code class="mono">{ r.Secret }</code></td>
								<td>{ r.Field }</td>
								<td>{ r.Detail }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// EnvImportPage importa um .env para o cofre (ADR-0068 §8.1): cola o conteúdo, vê a prévia do mapeamento e dos
// conflitos, e só então grava. A prévia mostra nomes de segredo e de campo, nunca valores.
templ EnvImportPage(sh Shell, vm EnvImportVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Importar .env"), i18n.T(ctx, "Cada variável vira um segredo, ou todas viram campos de um segredo só. Veja a prévia antes de gravar.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar aos segredos") }</a></p>
		@flashAlerts("", vm.Error)
		if vm.Plan != nil {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Prévia") }</h2>
			<p class="muted mb-3">{ i18n.T(ctx, "Coleção de destino") }: <code class="mono">{ vm.Plan.Collection }</code></p>
			<div class="table-wrap mb-3">
				<table class="table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Segredo") }</th>
							<th>{ i18n.T(ctx, "Campos") }</th>
							<th>{ i18n.T(ctx, "Situação") }</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Plan.Rows {
							<tr class="row">
								<td><code class="mono">{ r.Secret }</code></td>
								<td>{ r.Fields }</td>
								<td>
									if r.Exists {
										{ i18n.T(ctx, "já existe") }
									} else {
										{ i18n.T(ctx, "novo") }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(vm.Plan.Skipped) > 0 {
				<p class="muted">{ i18n.T(ctx, "Linhas ignoradas:") }</p>
				<ul class="mb-3">
					for _, sk := range vm.Plan.Skipped {
						<li>{ sk }</li>
					}
				</ul>
			}
		}
		if vm.NeedPassword {
			@ReauthHost(vm.Version, vm.Firebase)
		}
		<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.PostHref) } autocomplete="off">
			<div class="field">
				<label for="env-content">{ i18n.T(ctx, "Conteúdo do .env") }</label>
				<textarea class="input mono" id="env-content" name="content" rows="10" required maxlength="262144" spellcheck="false" autocomplete="off">{ vm.Content }</textarea>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="env-mode">{ i18n.T(ctx, "Como importar") }</label>
					<select class="select" id="env-mode" name="mode">
						<option value="items" selected?={ vm.Mode != "single_item" }>{ i18n.T(ctx, "Um segredo por variável") }</option>
						<option value="single_item" selected?={ vm.Mode == "single_item" }>{ i18n.T(ctx, "Um segredo só, com um campo por variável") }</option>
					</select>
				</div>
				<div class="field">
					<label for="env-item">{ i18n.T(ctx, "Nome do segredo (só no modo de um segredo)") }</label>
					<input class="input mono" id="env-item" name="item_name" value={ vm.ItemName } maxlength="64" autocomplete="off" spellcheck="false"/>
				</div>
				<div class="field">
					<label for="env-col">{ i18n.T(ctx, "Coleção") }</label>
					<select class="select" id="env-col" name="collection">
						<option value="" selected?={ vm.Collection == "" }>{ i18n.T(ctx, "padrão") }</option>
						for _, c := range vm.Collections {
							<option value={ c } selected?={ vm.Collection == c }>{ c }</option>
						}
					</select>
				</div>
			</div>
			<label class="check-line"><input type="checkbox" name="overwrite" value="1" checked?={ vm.Overwrite }/><span>{ i18n.T(ctx, "Rotacionar o que já existe (sem marcar, o que existe é pulado)") }</span></label>
			if vm.Plan != nil {
				<div class="field">
					<label for="env-pass">{ i18n.T(ctx, "Senha da conta, para confirmar (se o servidor pedir)") }</label>
					<input class="input" id="env-pass" name="senha" type="password" autocomplete="current-password" maxlength="256" autofocus?={ vm.NeedPassword }/>
				</div>
			}
			<div class="form-actions">
				<button class="btn outline" type="submit" name="etapa" value="previa">{ i18n.T(ctx, "Ver prévia") }</button>
				if vm.Plan != nil {
					<button class="btn primary" type="submit" name="etapa" value="gravar">{ i18n.T(ctx, "Gravar") }</button>
				}
			</div>
		</form>
	}
}

// VaultFilePage exporta o cofre cifrado com a senha do arquivo e importa um .hkv de outra instância (ADR-0068 §8.2 e
// §8.3). Os dois pedem a senha da conta quando o servidor pede reautenticação; senha nenhuma volta ao HTML.
templ VaultFilePage(sh Shell, vm VaultFileVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Cofre cifrado (.hkv)"), i18n.T(ctx, "Exporte o cofre com uma senha para importar em outra instância, ou importe um arquivo exportado. Os valores ficam dentro do arquivo cifrado.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<p class="mb-3"><a href={ templ.SafeURL(vm.BackHref) }>{ i18n.T(ctx, "Voltar aos segredos") }</a></p>
		@flashAlerts("", vm.Error)
		if vm.ReauthFor != "" {
			@ReauthHost(vm.Version, vm.Firebase)
		}
		<form class="card pad form-card mb-6" method="post" action={ templ.SafeURL(vm.ExportHref) } autocomplete="off">
			<h2 class="side-h">{ i18n.T(ctx, "Exportar o cofre") }</h2>
			<p class="muted mb-3">{ i18n.T(ctx, "Gera um arquivo .hkv com segredos, campos, coleções e concessões. Ele é cifrado com a senha abaixo; nenhum valor fica em claro.") }</p>
			<div class="field">
				<label for="vault-export-pass">{ i18n.T(ctx, "Senha do arquivo (mínimo de 12 caracteres)") }</label>
				<input class="input" id="vault-export-pass" name="senha_arquivo" type="password" minlength="12" maxlength="256" autocomplete="new-password" required/>
			</div>
			if vm.ReauthFor == "exportar" {
				<div class="field">
					<label for="vault-export-account">{ i18n.T(ctx, "Senha da conta, para confirmar") }</label>
					<input class="input" id="vault-export-account" name="senha" type="password" maxlength="256" autocomplete="current-password" autofocus/>
				</div>
			}
			<div class="form-actions">
				<button class="btn primary" type="submit">{ i18n.T(ctx, "Baixar o arquivo .hkv") }</button>
			</div>
		</form>
		<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.ImportHref) } enctype="multipart/form-data" autocomplete="off">
			<h2 class="side-h">{ i18n.T(ctx, "Importar um arquivo .hkv") }</h2>
			<p class="muted mb-3">{ i18n.T(ctx, "Grava tudo o que o arquivo leva, ou nada. Segredo que já existe aqui não é trocado. Senha errada não grava nada.") }</p>
			<div class="field">
				<label for="vault-import-file">{ i18n.T(ctx, "Arquivo .hkv") }</label>
				<input class="input" id="vault-import-file" name="arquivo" type="file" accept=".hkv" required/>
			</div>
			<div class="field">
				<label for="vault-import-pass">{ i18n.T(ctx, "Senha do arquivo") }</label>
				<input class="input" id="vault-import-pass" name="senha_arquivo" type="password" maxlength="256" autocomplete="off" required/>
			</div>
			if vm.ReauthFor == "importar" {
				<div class="field">
					<label for="vault-import-account">{ i18n.T(ctx, "Senha da conta, para confirmar") }</label>
					<input class="input" id="vault-import-account" name="senha" type="password" maxlength="256" autocomplete="current-password" autofocus/>
				</div>
			}
			<div class="form-actions">
				<button class="btn primary" type="submit">{ i18n.T(ctx, "Importar o arquivo") }</button>
			</div>
		</form>
	}
}
