package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/i18n"
)

// GateDecideForm answers a pending gate. compact (inbox, dashboard) has no note field and
// no "Pedir mudanças" (that one needs a note). next says where to go afterwards.
templ GateDecideForm(g GateRow, next string, compact bool) {
	if g.Kind == "question" {
		if compact {
			<div class="gate-ro"><a class="btn primary sm" href={ templ.SafeURL(g.Href) }>{ i18n.T(ctx, "Responder") }</a></div>
		} else {
			@GateQuestionForm(g, next)
		}
	} else if !canDecide(ctx, g.Kind) {
		<div class="gate-ro">
			if compact {
				<a class="btn ghost sm" href={ templ.SafeURL(g.Href) }>{ i18n.T(ctx, "Abrir") }</a>
			}
			@NeedRole(decideNeed(g.Kind))
		</div>
	} else {
		<form
			class={ "gate-decide", templ.KV("compact", compact) }
			method="post"
			action={ templ.SafeURL(g.DecideHref) }
			hx-post={ g.DecideHref }
			hx-swap="none"
		>
			<input type="hidden" name="next" value={ next }/>
			if !compact {
				<textarea class="textarea" name="note" rows="3" aria-label={ i18n.T(ctx, "Nota da decisão") } placeholder={ i18n.T(ctx, "Nota para a persona e para o registro (obrigatória ao pedir mudanças). Markdown.") }></textarea>
			}
			<div class="gate-actions">
				if compact {
					<a class="btn ghost sm" href={ templ.SafeURL(g.Href) }>{ i18n.T(ctx, "Abrir") }</a>
				}
				if !compact {
					<button class="btn outline sm" type="submit" name="decision" value="changes_requested">{ i18n.T(ctx, "Pedir mudanças") }</button>
				}
				<button class="btn outline sm" type="submit" name="decision" value="rejected">{ i18n.T(ctx, "Rejeitar") }</button>
				if g.Kind == "tool" && g.Persona != "" && canAdmin(ctx) {
					<button class="btn outline sm" type="submit" name="decision" value="approved_always" title={ i18n.T(ctx, "Aprova e grava uma política de permitir para esta persona e esta tool: as próximas chamadas passam direto.") }>
						{ i18n.T(ctx, "Aprovar e sempre permitir") }
					</button>
				}
				if g.Kind == "connection" && g.ConnectHref != "" {
					<a class="btn primary sm" href={ templ.SafeURL(g.ConnectHref) }>
						@Icon("plug")
						{ i18n.T(ctx, "Autorizar conexão") }
					</a>
				} else {
					<button class="btn primary sm" type="submit" name="decision" value="approved">
						@Icon("check")
						{ i18n.T(ctx, "Aprovar") }
					</button>
				}
			</div>
		</form>
	}
}

// GateBanner is the amber notice on a task that waits for a human decision.
templ GateBanner(g GateRow) {
	<section class="gate-banner" aria-label={ i18n.T(ctx, "Decisão pendente") }>
		<div class="gate-head">
			@Icon("shield")
			<b>{ i18n.T(ctx, "Gate pendente") }</b>
			<span class="badge warn">{ g.KindLabel }</span>
			<span class="gate-when">
				if g.Persona != "" {
					{ i18n.T(ctx, "pedido por") } { g.Persona } ·
				}
				{ g.Created }
			</span>
		</div>
		<h3><a href={ templ.SafeURL(g.Href) }>{ g.Title }</a></h3>
		if g.Review != nil {
			<p class="gate-excerpt">@BadgeEl(g.Review.Badge) <span>{ g.Review.Reviewer }</span></p>
		}
		if g.Excerpt != "" {
			<p class="gate-excerpt">{ g.Excerpt }</p>
		}
		@GateDecideForm(g, "task", false)
	</section>
}

templ GateRows(rows []GateRow, empty string) {
	if len(rows) == 0 {
		@EmptyCard("shield", i18n.T(ctx, "Nenhum gate aqui."), empty, true)
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Gate</th>
						<th class="hide-sm">{ i18n.T(ctx, "Pedido por") }</th>
						<th class="hide-sm">Task</th>
						<th>{ i18n.T(ctx, "Status") }</th>
						<th class="num hide-sm">{ i18n.T(ctx, "Quando") }</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr class="row">
							<td class="ttl">
								<a href={ templ.SafeURL(r.Href) }>{ r.Title }</a>
								<div class="sub-line">{ r.KindLabel } · <span class="mono">{ r.Short }</span></div>
							</td>
							<td class="hide-sm">
								if r.Persona != "" {
									@PersonaChip(r.Persona)
								} else {
									<span class="faint">—</span>
								}
							</td>
							<td class="hide-sm">
								if r.TaskKey != "" {
									<a class="mono link-u text-xs" href={ templ.SafeURL(r.TaskHref) }>{ r.TaskKey }</a>
								} else {
									<span class="faint">—</span>
								}
							</td>
							<td>@BadgeEl(r.Badge)</td>
							<td class="when hide-sm">
								if r.Pending {
									{ r.Created }
								} else {
									{ r.Decided }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ GatesPage(sh Shell, vm GatesVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Gates"), vm.Subtitle) {
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="toolbar">
			@Tabs(vm.Status)
			<span class="grow"></span>
			@Tabs(vm.Kinds)
		</div>
		if vm.MineHref != "" {
			<p class="filter-chip">
				<a class={ "chip", templ.KV("soft", !vm.Mine) } href={ templ.SafeURL(vm.MineHref) } aria-pressed?={ vm.Mine }>
					@Icon("user")
					{ i18n.T(ctx, "Minha audiência") }
				</a>
				if vm.Mine {
					<span class="muted text-sm">{ i18n.T(ctx, "Gates que você pediu ou decidiu, ou de tasks em que você participa.") }</span>
				}
			</p>
		}
		@GateRows(vm.Rows, vm.Empty)
	}
}

templ GatePage(sh Shell, vm GateVM) {
	@Layout(sh) {
		<div class="detail">
			<div class="detail-main">
				<div class="eyebrow">
					<span class="mono">{ vm.Row.Short }</span>
					<span>·</span>
					<span>{ vm.Row.KindLabel }</span>
					<span>·</span>
					<span>{ i18n.T(ctx, "pedido") } { vm.Created }</span>
				</div>
				<h1>{ vm.Row.Title }</h1>
				<div class="chips mt-1">
					@BadgeEl(vm.Row.Badge)
					if vm.Row.Review != nil {
						@BadgeEl(vm.Row.Review.Badge)
					}
					if vm.Row.Persona != "" {
						<a class="chip" href={ templ.SafeURL(vm.Row.PersonaHref) }>@PersonaGlyph(vm.Row.Persona)<span>{ vm.Row.Persona }</span></a>
					}
					if vm.Row.TaskKey != "" {
						<a class="chip" href={ templ.SafeURL(vm.Row.TaskHref) }><span class="mono">{ vm.Row.TaskKey }</span></a>
					}
				</div>
				if vm.Notice != "" {
					<div class="mt-4">@Alert("warn", vm.Notice)</div>
				}
				if vm.Row.Review != nil {
					<div class="mt-4">
						if vm.Row.Review.Rejected {
							@Alert("warn", i18n.Tf(ctx, "Reprovado pelo revisor %s. A decisão continua sendo sua.", vm.Row.Review.Reviewer))
						}
						if vm.Row.Review.Justification != "" {
							<p class="gate-excerpt">{ vm.Row.Review.Justification }</p>
						}
						if vm.Row.Review.SHA != "" {
							<p class="faint mono text-xs">{ i18n.T(ctx, "sha256 revisado:") } { vm.Row.Review.SHA }</p>
						}
					</div>
				}
				<div class="brief mt-6">
					<div class="side-h">{ i18n.T(ctx, "Pedido") }</div>
					if vm.HasBody {
						<div class="md">@templ.Raw(string(vm.Body))</div>
					} else {
						<p class="muted">{ i18n.T(ctx, "Sem detalhes além do título.") }</p>
					}
				</div>
				if vm.Hire != nil {
					@GateHireCard(*vm.Hire)
				}
				if vm.History != nil {
					@GateHistoryCard(*vm.History)
				}
				@GateAnswerCard(vm.Row)
				if vm.Row.Pending {
					<section class="gate-banner mt-6" aria-label={ i18n.T(ctx, "Decidir") }>
						<div class="gate-head">@Icon("shield") <b>{ i18n.T(ctx, "Sua decisão") }</b> <span class="gate-when">{ i18n.T(ctx, "a persona fica parada até você responder") }</span></div>
						@GateDecideForm(vm.Row, "gate", false)
					</section>
				} else if vm.Row.Kind != "question" || vm.Row.Question == nil || !vm.Row.Question.Dismissed {
					<section class="card pad mt-6">
						<div class="card-head"><h2>{ i18n.T(ctx, "Decisão") }</h2></div>
						<p>
							@BadgeEl(vm.Row.Badge)
							<span class="muted"> { i18n.Tf(ctx, "por %s", vm.Row.DecidedBy) } · { vm.Decided }</span>
						</p>
						if vm.Row.Note != "" {
							<blockquote class="gate-note">{ vm.Row.Note }</blockquote>
						} else {
							<p class="muted mt-2">{ i18n.T(ctx, "Sem nota.") }</p>
						}
						if vm.Example != nil {
							@SaveExampleForm(*vm.Example)
						}
					</section>
				}
			</div>
			<aside class="detail-side">
				<div class="side-sec">
					<div class="side-h">{ i18n.T(ctx, "Propriedades") }</div>
					<div class="props">
						<div class="prop"><span>{ i18n.T(ctx, "Tipo") }</span><span>{ vm.Row.KindLabel }</span></div>
						<div class="prop"><span>{ i18n.T(ctx, "Status") }</span><span>@BadgeEl(vm.Row.Badge)</span></div>
						<div class="prop"><span>Task</span><span>
							if vm.Row.TaskKey != "" {
								<a class="mono link-u text-xs" href={ templ.SafeURL(vm.Row.TaskHref) }>{ vm.Row.TaskKey }</a>
							} else {
								<span class="faint">—</span>
							}
						</span></div>
						<div class="prop"><span>{ i18n.T(ctx, "Execução") }</span><span>
							if vm.RunHref != "" {
								<a class="mono link-u text-xs" href={ templ.SafeURL(vm.RunHref) }>{ vm.RunShort }</a>
							} else {
								<span class="faint">—</span>
							}
						</span></div>
						<div class="prop"><span>{ i18n.T(ctx, "Pedido em") }</span><span class="mono text-xs">{ vm.Created }</span></div>
						if vm.Row.Revision > 1 {
							<div class="prop"><span>{ i18n.T(ctx, "Revisão") }</span><span class="mono text-xs">{ fmt.Sprint(vm.Row.Revision) }</span></div>
						}
						if vm.Row.Audience != "" {
							<div class="prop"><span>{ i18n.T(ctx, "Audiência") }</span><span class="text-xs">{ vm.Row.Audience }</span></div>
						}
						if !vm.Row.Pending {
							<div class="prop"><span>{ i18n.T(ctx, "Decidido em") }</span><span class="mono text-xs">{ vm.Decided }</span></div>
						}
					</div>
				</div>
				<div class="side-sec">
					<div class="side-h">{ i18n.T(ctx, "O que acontece") }</div>
					<p class="muted text-sm">{ i18n.T(ctx, "Aprovar ou pedir mudanças devolve a task a Em andamento; rejeitar a devolve a A fazer com a sua nota. Em todos os casos a persona é acordada e a decisão vira memória da empresa.") }</p>
				</div>
			</aside>
		</div>
	}
}

templ DecisionsPage(sh Shell, vm DecisionsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Decisões"), vm.Subtitle) {
			<a class="btn outline" href={ templ.SafeURL(sh.Base() + "/gates") }>
				@Icon("shield")
				{ i18n.T(ctx, "Ver gates") }
			</a>
		}
		<div class="toolbar">
			@Tabs(vm.Tabs)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("circle-check", i18n.T(ctx, "Nenhuma decisão ainda."), i18n.T(ctx, "Cada gate que você aprovar, rejeitar ou devolver com mudanças fica aqui, com a sua nota."), true)
		} else {
			<div class="dec-list">
				for _, r := range vm.Rows {
					<article class="dec-card">
						<div class="dec-top">
							@BadgeEl(r.Badge)
							<span class="chip soft">{ r.KindLabel }</span>
							<span class="dec-when">{ r.DecidedBy } · { r.Decided }</span>
						</div>
						<h3><a href={ templ.SafeURL(r.Href) }>{ r.Title }</a></h3>
						<div class="dec-meta">
							if r.Persona != "" {
								<span>{ i18n.T(ctx, "pedido por") } { r.Persona }</span>
							}
							if r.TaskKey != "" {
								<a class="mono" href={ templ.SafeURL(r.TaskHref) }>{ r.TaskKey }</a>
							}
						</div>
						if r.Note != "" {
							<blockquote class="gate-note">{ r.Note }</blockquote>
						}
					</article>
				}
			</div>
		}
	}
}

// PendingGatesCard is the "Decisões pendentes" block of the Painel.
templ PendingGatesCard(rows []GateRow, base string) {
	<section class="card pad gate-card">
		<div class="card-head">
			<div>
				<h2>{ i18n.T(ctx, "Decisões pendentes") }</h2>
				<p class="sub">{ i18n.Tf(ctx, "%s esperando por você · as personas ficam paradas até a resposta", fmt.Sprint(len(rows))) }</p>
			</div>
			<a class="more" href={ templ.SafeURL(base + "/gates") }>{ i18n.T(ctx, "Ver todos") }</a>
		</div>
		<div class="gate-mini-list">
			for _, g := range rows {
				<div class="gate-mini">
					<span class="mini-avatar gate">@Icon("shield")</span>
					<div class="gm-main">
						<a class="gm-t" href={ templ.SafeURL(g.Href) }>{ g.Title }</a>
						<div class="gm-s">
							<span class="badge warn">{ g.KindLabel }</span>
							if g.TaskKey != "" {
								<span class="mono">{ g.TaskKey }</span>
							}
							if g.Persona != "" {
								<span>{ g.Persona }</span>
							}
							<span>{ g.Created }</span>
						</div>
					</div>
					@GateDecideForm(g, "painel", true)
				</div>
			}
		</div>
	</section>
}
