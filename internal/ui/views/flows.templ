package views

import "fmt"

templ FlowSwitch(on bool, href, name string) {
	<form method="post" action={ templ.SafeURL(href) } hx-post={ href } hx-swap="none" class="switch-form">
		<button class={ "switch", templ.KV("on", on) } type="submit" role="switch" aria-checked={ fmt.Sprint(on) } aria-label={ "Fluxo " + name + (map[bool]string{true: ": ativo", false: ": desativado"})[on] }>
			<i></i>
		</button>
	</form>
}

templ FlowsPage(sh Shell, vm FlowsVM) {
	@Layout(sh) {
		@PageHead("Fluxos", vm.Subtitle) {
			<a class="btn primary" href={ templ.SafeURL(vm.NewHref) }>@Icon("plus") Novo fluxo</a>
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="kpis">
			@Kpi("workflow", fmt.Sprint(vm.Active), "Fluxos ativos", false)
			@Kpi("alert", fmt.Sprint(vm.Disabled), "Desativados", false)
			@Kpi("clock", vm.Next, "Próximo disparo", false)
			@Kpi("zap", vm.Last, "Último disparo", false)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("workflow", "Você ainda não tem fluxos.", "Um fluxo é um trabalho recorrente definido uma vez: a cada ocorrência da agenda ele cria uma task para a persona escolhida.", true) {
				<a class="btn outline" href={ templ.SafeURL(vm.NewHref) }>@Icon("plus") Criar fluxo</a>
			}
		} else {
			<div class="table-wrap">
				<table class="table flows-table">
					<thead>
						<tr>
							<th>Fluxo</th>
							<th class="hide-sm">Responsável</th>
							<th class="hide-sm">Projeto</th>
							<th class="hide-sm">Agenda</th>
							<th class="hide-sm">Último</th>
							<th>Próximo</th>
							<th class="act-col"></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							<tr class={ "row", templ.KV("is-off", !r.Enabled) }>
								<td class="ttl">
									<a href={ templ.SafeURL(r.Href) }>{ r.Name }</a>
									if r.Description != "" {
										<div class="note">{ r.Description }</div>
									}
								</td>
								<td class="hide-sm"><span class="who"><span class="mini-avatar">@Icon("bot")</span>{ r.Persona }</span></td>
								<td class="hide-sm muted">{ dash(r.Project) }</td>
								<td class="hide-sm"><span class="chip soft" title={ r.Cron }>@Icon("clock") <span>{ r.Schedule }</span></span></td>
								<td class="hide-sm muted">{ r.Last }</td>
								<td class="muted">
									if r.Enabled {
										{ r.Next }
									} else {
										<span class="badge soft">Desativado</span>
									}
								</td>
								<td class="act-col">
									<div class="row-acts">
										@FlowSwitch(r.Enabled, r.ToggleHref, r.Name)
										<form method="post" action={ templ.SafeURL(r.RunHref) } hx-post={ r.RunHref } hx-swap="none">
											<button class="btn outline sm" type="submit">@Icon("play") Rodar agora</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

templ CronHint(h CronHintVM) {
	<div id="cron-hint" class="cron-hint" aria-live="polite">
		if h.Error != "" {
			<span class="err">{ h.Error }</span>
		} else if h.Human != "" {
			<b>{ h.Human }</b>
			if len(h.Next) > 0 {
				<span class="muted">· próximas: 
					for i, n := range h.Next {
						if i > 0 {
							,&nbsp;
						}
						{ n }
					}
				</span>
			}
		}
	</div>
}

templ FlowForm(vm FlowFormVM) {
	<form class="card pad form-card flow-form" method="post" action={ templ.SafeURL(vm.Action) } hx-boost="true">
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="form-grid">
			<div class="field">
				<label for="f-name">Nome</label>
				<input class="input" id="f-name" name="name" value={ vm.Name } required maxlength="120" placeholder="Digest semanal de fontes"/>
				if e := vm.FieldErr["name"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for="f-persona">Persona responsável</label>
				@Select("persona", "f-persona", vm.PersonaOptions, false)
				if e := vm.FieldErr["persona"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
		</div>
		<div class="field">
			<label for="f-desc">Descrição</label>
			<input class="input" id="f-desc" name="description" value={ vm.Description } maxlength="300" placeholder="Para que serve este fluxo"/>
		</div>
		<div class="field">
			<span class="lbl">Agenda</span>
			<div class="cron-row">
				<select class="select sm" aria-label="Modelos de agenda" data-cron-preset="f-cron">
					for _, o := range vm.Presets {
						<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
					}
				</select>
				<input class="input sm mono" id="f-cron" name="cron" value={ vm.Cron } required placeholder="0 7 * * 5" autocomplete="off" spellcheck="false" aria-label="Expressão cron de 5 campos"
					hx-get={ vm.HintHref } hx-trigger="input changed delay:300ms, change" hx-include="#f-cron, #f-tz" hx-target="#cron-hint" hx-swap="outerHTML"/>
				<input class="input sm" id="f-tz" name="timezone" value={ vm.Timezone } list="tzs" aria-label="Fuso horário" placeholder="America/Sao_Paulo"
					hx-get={ vm.HintHref } hx-trigger="change" hx-include="#f-cron, #f-tz" hx-target="#cron-hint" hx-swap="outerHTML"/>
				<datalist id="tzs">
					<option value="America/Sao_Paulo"></option>
					<option value="UTC"></option>
					<option value="America/New_York"></option>
					<option value="Europe/Lisbon"></option>
				</datalist>
			</div>
			@CronHint(vm.Hint)
			if e := vm.FieldErr["cron"]; e != "" {
				<span class="err">{ e }</span>
			}
			<span class="hint">Cinco campos: minuto, hora, dia do mês, mês e dia da semana, no fuso indicado.</span>
		</div>
		<div class="form-grid">
			<div class="field">
				<label for="f-project">Projeto</label>
				@Select("project", "f-project", vm.ProjectOptions, false)
			</div>
			<div class="field">
				<label for="f-prio">Prioridade</label>
				@Select("priority", "f-prio", vm.PriorityOptions, false)
			</div>
		</div>
		<div class="field">
			<label for="f-title">Título da task gerada</label>
			<input class="input" id="f-title" name="task_title" value={ vm.TaskTitle } maxlength="200" placeholder="Digest semanal · {{data}}"/>
			<span class="hint">Variáveis: <code>&#123;&#123;data&#125;&#125;</code> (data da ocorrência) e <code>&#123;&#123;n&#125;&#125;</code> (número do disparo).</span>
		</div>
		<div class="field">
			<label for="f-tdesc">Pedido à persona</label>
			<textarea class="textarea" id="f-tdesc" name="task_description" rows="6" placeholder="O que a task gerada pede à persona. Suporta as mesmas variáveis.">{ vm.TaskDescription }</textarea>
		</div>
		<label class="check-line">
			<input type="checkbox" name="enabled" value="1" checked?={ vm.Enabled }/>
			<span>Fluxo ativo: dispara na agenda</span>
		</label>
		<div class="form-actions">
			<a class="btn ghost" href={ templ.SafeURL(vm.CancelHref) }>Cancelar</a>
			<button class="btn primary" type="submit">
				if vm.Edit {
					Salvar alterações
				} else {
					Criar fluxo
				}
			</button>
		</div>
	</form>
}

templ NewFlowPage(sh Shell, vm FlowFormVM) {
	@Layout(sh) {
		@PageHead("Novo fluxo", "Defina uma vez; cada disparo vira uma task atribuída à persona, com sua execução.") {
		}
		@FlowForm(vm)
	}
}

templ FlowPage(sh Shell, vm FlowVM) {
	@Layout(sh) {
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="flow-head">
			<div>
				<h1>{ vm.Name } @BadgeEl(vm.Badge)</h1>
				<p class="muted" style="margin-top:6px;font-size:13.5px">{ vm.Meta }</p>
			</div>
			<div class="flow-acts">
				@FlowSwitch(vm.Enabled, vm.ToggleHref, vm.Name)
				<form method="post" action={ templ.SafeURL(vm.RunHref) } hx-post={ vm.RunHref } hx-swap="none">
					<button class="btn primary" type="submit">@Icon("play") Rodar agora</button>
				</form>
			</div>
		</div>
		<div class="stats4" style="margin-bottom:20px">
			<div class="stat"><div class="l">Agenda</div><div class="v">{ vm.Schedule }</div></div>
			<div class="stat"><div class="l">Expressão · fuso</div><div class="v">{ vm.Cron } · { vm.Timezone }</div></div>
			<div class="stat"><div class="l">Próximo disparo</div><div class="v">{ vm.Next }</div></div>
			<div class="stat"><div class="l">Último disparo</div><div class="v">{ vm.Last }</div></div>
		</div>
		<h2 class="side-h" style="margin:8px 0 12px">Definição</h2>
		@FlowForm(vm.Form)
		<h2 class="side-h" style="margin:28px 0 12px">Histórico de disparos · { fmt.Sprint(vm.Fired) }</h2>
		if len(vm.Fires) == 0 {
			@EmptyCard("clock", "Nenhum disparo ainda.", "Os disparos aparecem aqui, cada um com a task que gerou. Use Rodar agora para testar.", false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr><th>Quando</th><th>Task gerada</th><th>Status da task</th></tr>
					</thead>
					<tbody>
						for _, f := range vm.Fires {
							<tr class="row">
								<td class="muted">{ f.When }</td>
								<td class="ttl">
									if f.TaskHref != "" {
										<span class="id">{ f.TaskKey }</span> <a href={ templ.SafeURL(f.TaskHref) }>{ f.Title }</a>
									} else {
										<span class="muted">sem task</span>
									}
								</td>
								<td>@BadgeEl(f.Badge)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
