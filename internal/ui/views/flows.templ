package views

import (
	"context"
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ FlowSwitch(on bool, href, name string) {
	if !canAdmin(ctx) {
		<button class={ "switch", templ.KV("on", on) } type="button" role="switch" disabled aria-checked={ fmt.Sprint(on) } aria-label={ flowSwitchLabel(ctx, name, on) } title={ needText(ctx, domain.MemberAdmin) }>
			<i></i>
		</button>
	} else {
		<form method="post" action={ templ.SafeURL(href) } hx-post={ href } hx-swap="none" class="switch-form">
			<button class={ "switch", templ.KV("on", on) } type="submit" role="switch" aria-checked={ fmt.Sprint(on) } aria-label={ flowSwitchLabel(ctx, name, on) }>
				<i></i>
			</button>
		</form>
	}
}

func flowSwitchLabel(ctx context.Context, name string, on bool) string {
	if on {
		return i18n.Tf(ctx, "Fluxo %s: ativo", name)
	}
	return i18n.Tf(ctx, "Fluxo %s: desativado", name)
}

templ FlowsPage(sh Shell, vm FlowsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Fluxos"), vm.Subtitle) {
			if sh.CanAdmin() {
				<a class="btn primary" href={ templ.SafeURL(vm.NewHref) }>
					@Icon("plus")
					{ i18n.T(ctx, "Novo fluxo") }
				</a>
			} else {
				@NeedRole(domain.MemberAdmin)
			}
		}
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		<div class="kpis">
			@Kpi("workflow", fmt.Sprint(vm.Active), i18n.T(ctx, "Fluxos ativos"), false)
			@Kpi("alert", fmt.Sprint(vm.Disabled), i18n.T(ctx, "Desativados"), false)
			@Kpi("clock", vm.Next, i18n.T(ctx, "Próximo disparo"), false)
			@Kpi("zap", vm.Last, i18n.T(ctx, "Último disparo"), false)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("workflow", i18n.T(ctx, "Você ainda não tem fluxos."), i18n.T(ctx, "Um fluxo é um trabalho recorrente definido uma vez: a cada ocorrência da agenda ele cria uma task para a persona escolhida."), true) {
				if sh.CanAdmin() {
					<a class="btn outline" href={ templ.SafeURL(vm.NewHref) }>
						@Icon("plus")
						{ i18n.T(ctx, "Criar fluxo") }
					</a>
				} else {
					@NeedRole(domain.MemberAdmin)
				}
			}
		} else {
			<div class="table-wrap">
				<table class="table flows-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Fluxo") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Responsável") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Projeto") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Agenda") }</th>
							<th class="hide-sm">{ i18n.T(ctx, "Último") }</th>
							<th>{ i18n.T(ctx, "Próximo") }</th>
							<th class="act-col"></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range vm.Rows {
							<tr class={ "row", templ.KV("is-off", !r.Enabled) }>
								<td class="ttl">
									<a href={ templ.SafeURL(r.Href) }>{ r.Name }</a>
									if r.Description != "" {
										<div class="note">{ r.Description }</div>
									}
								</td>
								<td class="hide-sm"><span class="who"><span class="mini-avatar">@PersonaGlyph(r.Persona)</span>{ r.Persona }</span></td>
								<td class="hide-sm muted">{ dash(r.Project) }</td>
								<td class="hide-sm"><span class="chip soft" title={ r.Cron }>@Icon("clock") <span>{ r.Schedule }</span></span></td>
								<td class="hide-sm muted">{ r.Last }</td>
								<td class="muted">
									if r.Enabled {
										{ r.Next }
									} else {
										<span class="badge soft">{ i18n.T(ctx, "Desativado") }</span>
									}
								</td>
								<td class="act-col">
									<div class="row-acts">
										@FlowSwitch(r.Enabled, r.ToggleHref, r.Name)
										if canAdmin(ctx) {
											<form method="post" action={ templ.SafeURL(r.RunHref) } hx-post={ r.RunHref } hx-swap="none">
												<button class="btn outline sm" type="submit">
													@Icon("play")
													{ i18n.T(ctx, "Rodar agora") }
												</button>
											</form>
										} else {
											@NeedRole(domain.MemberAdmin)
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

templ CronHint(h CronHintVM) {
	<div id="cron-hint" class="cron-hint" aria-live="polite">
		if h.Error != "" {
			<span class="err">{ h.Error }</span>
		} else if h.Human != "" {
			<b>{ h.Human }</b>
			if len(h.Next) > 0 {
				<span class="muted">· { i18n.T(ctx, "próximas:") } 
					for i, n := range h.Next {
						if i > 0 {
							,&nbsp;
						}
						{ n }
					}
				</span>
			}
		}
	</div>
}

templ FlowForm(vm FlowFormVM) {
	<form class="card pad form-card flow-form" method="post" action={ templ.SafeURL(vm.Action) } hx-boost="true">
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="form-grid">
			<div class="field">
				<label for="f-name">{ i18n.T(ctx, "Nome") }</label>
				<input class="input" id="f-name" name="name" value={ vm.Name } required maxlength="120" placeholder={ i18n.T(ctx, "Digest semanal de fontes") }/>
				if e := vm.FieldErr["name"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for="f-persona">{ i18n.T(ctx, "Persona responsável") }</label>
				@Select("persona", "f-persona", vm.PersonaOptions, false)
				if e := vm.FieldErr["persona"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
		</div>
		<div class="field">
			<label for="f-desc">{ i18n.T(ctx, "Descrição") }</label>
			<input class="input" id="f-desc" name="description" value={ vm.Description } maxlength="300" placeholder={ i18n.T(ctx, "Para que serve este fluxo") }/>
		</div>
		<div class="field">
			<span class="lbl">{ i18n.T(ctx, "Agenda") }</span>
			<div class="cron-row">
				<select class="select sm" aria-label={ i18n.T(ctx, "Modelos de agenda") } data-cron-preset="f-cron">
					for _, o := range vm.Presets {
						<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
					}
				</select>
				<input class="input sm mono" id="f-cron" name="cron" value={ vm.Cron } required placeholder="0 7 * * 5" autocomplete="off" spellcheck="false" aria-label={ i18n.T(ctx, "Expressão cron de 5 campos") }
					hx-get={ vm.HintHref } hx-trigger="input changed delay:300ms, change" hx-include="#f-cron, #f-tz" hx-target="#cron-hint" hx-swap="outerHTML"/>
				<input class="input sm" id="f-tz" name="timezone" value={ vm.Timezone } list="tzs" aria-label={ i18n.T(ctx, "Fuso horário") } placeholder={ i18n.T(ctx, "America/Sao_Paulo") }
					hx-get={ vm.HintHref } hx-trigger="change" hx-include="#f-cron, #f-tz" hx-target="#cron-hint" hx-swap="outerHTML"/>
				<datalist id="tzs">
					<option value="America/Sao_Paulo"></option>
					<option value="UTC"></option>
					<option value="America/New_York"></option>
					<option value="Europe/Lisbon"></option>
				</datalist>
			</div>
			@CronHint(vm.Hint)
			if e := vm.FieldErr["cron"]; e != "" {
				<span class="err">{ e }</span>
			}
			<span class="hint">{ i18n.T(ctx, "Cinco campos: minuto, hora, dia do mês, mês e dia da semana, no fuso indicado.") }</span>
		</div>
		<div class="form-grid">
			<div class="field">
				<label for="f-project">{ i18n.T(ctx, "Projeto") }</label>
				@Select("project", "f-project", vm.ProjectOptions, false)
			</div>
			<div class="field">
				<label for="f-prio">{ i18n.T(ctx, "Prioridade") }</label>
				@Select("priority", "f-prio", vm.PriorityOptions, false)
			</div>
		</div>
		<div class="field">
			<label for="f-title">{ i18n.T(ctx, "Título da task gerada") }</label>
			<input class="input" id="f-title" name="task_title" value={ vm.TaskTitle } maxlength="200" placeholder={ i18n.T(ctx, "Digest semanal · {{data}}") }/>
			<span class="hint">{ i18n.T(ctx, "Variáveis:") } <code>&#123;&#123;data&#125;&#125;</code> { i18n.T(ctx, "(data da ocorrência) e") } <code>&#123;&#123;n&#125;&#125;</code> { i18n.T(ctx, "(número do disparo).") }</span>
		</div>
		<div class="field">
			<label for="f-tdesc">{ i18n.T(ctx, "Pedido à persona") }</label>
			<textarea class="textarea" id="f-tdesc" name="task_description" rows="6" placeholder={ i18n.T(ctx, "O que a task gerada pede à persona. Suporta as mesmas variáveis.") }>{ vm.TaskDescription }</textarea>
		</div>
		<label class="check-line">
			<input type="checkbox" name="enabled" value="1" checked?={ vm.Enabled }/>
			<span>{ i18n.T(ctx, "Fluxo ativo: dispara na agenda") }</span>
		</label>
		<div class="form-actions">
			<a class="btn ghost" href={ templ.SafeURL(vm.CancelHref) }>{ i18n.T(ctx, "Cancelar") }</a>
			<button class="btn primary" type="submit">
				if vm.Edit {
					{ i18n.T(ctx, "Salvar alterações") }
				} else {
					{ i18n.T(ctx, "Criar fluxo") }
				}
			</button>
		</div>
	</form>
}

templ NewFlowPage(sh Shell, vm FlowFormVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Novo fluxo"), i18n.T(ctx, "Defina uma vez; cada disparo vira uma task atribuída à persona, com sua execução.")) {
		}
		if sh.CanAdmin() {
			@FlowForm(vm)
		} else {
			@Alert("warn", i18n.T(ctx, "Seu papel nesta empresa não permite esta ação."))
		}
	}
}

templ FlowPage(sh Shell, vm FlowVM) {
	@Layout(sh) {
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		<div class="flow-head">
			<div>
				<h1>{ vm.Name } @BadgeEl(vm.Badge)</h1>
				<p class="muted mt-2 text-sm">{ vm.Meta }</p>
			</div>
			<div class="flow-acts">
				@FlowSwitch(vm.Enabled, vm.ToggleHref, vm.Name)
				if canAdmin(ctx) {
					<form method="post" action={ templ.SafeURL(vm.RunHref) } hx-post={ vm.RunHref } hx-swap="none">
						<button class="btn primary" type="submit">
							@Icon("play")
							{ i18n.T(ctx, "Rodar agora") }
						</button>
					</form>
				} else {
					@NeedRole(domain.MemberAdmin)
				}
			</div>
		</div>
		<div class="stats4 mb-6">
			<div class="stat"><div class="l">{ i18n.T(ctx, "Agenda") }</div><div class="v">{ vm.Schedule }</div></div>
			<div class="stat"><div class="l">{ i18n.T(ctx, "Expressão · fuso") }</div><div class="v">{ vm.Cron } · { vm.Timezone }</div></div>
			<div class="stat"><div class="l">{ i18n.T(ctx, "Próximo disparo") }</div><div class="v">{ vm.Next }</div></div>
			<div class="stat"><div class="l">{ i18n.T(ctx, "Último disparo") }</div><div class="v">{ vm.Last }</div></div>
		</div>
		<h2 class="side-h mt-2 mb-3">{ i18n.T(ctx, "Definição") }</h2>
		if canAdmin(ctx) {
			@FlowForm(vm.Form)
		} else {
			@NeedRole(domain.MemberAdmin)
		}
		<h2 class="side-h sec-h">{ i18n.Tf(ctx, "Histórico de disparos · %s", fmt.Sprint(vm.Fired)) }</h2>
		if len(vm.Fires) == 0 {
			@EmptyCard("clock", i18n.T(ctx, "Nenhum disparo ainda."), i18n.T(ctx, "Os disparos aparecem aqui, cada um com a task que gerou. Use Rodar agora para testar."), false)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr><th>{ i18n.T(ctx, "Quando") }</th><th>{ i18n.T(ctx, "Task gerada") }</th><th>{ i18n.T(ctx, "Status da task") }</th></tr>
					</thead>
					<tbody>
						for _, f := range vm.Fires {
							<tr class="row">
								<td class="muted">{ f.When }</td>
								<td class="ttl">
									if f.TaskHref != "" {
										<span class="id">{ f.TaskKey }</span> <a href={ templ.SafeURL(f.TaskHref) }>{ f.Title }</a>
									} else {
										<span class="muted">{ i18n.T(ctx, "sem task") }</span>
									}
								</td>
								<td>@BadgeEl(f.Badge)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
