package views

import (
	"fmt"
	"strings"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ secretForm(vm SecretFormVM, collections []string, vaultOn bool) {
	<form class="card pad form-card" method="post" action={ templ.SafeURL(vm.Action) } hx-boost="true">
		<div class="form-grid">
			<div class="field">
				<label for={ "sec-name-" + vmKey(vm.User) }>{ i18n.T(ctx, "Nome") }</label>
				<input class="input mono" id={ "sec-name-" + vmKey(vm.User) } name="name" value={ vm.Name } required maxlength="64" pattern="[A-Za-z][A-Za-z0-9_.\-]{0,63}" autocomplete="off" spellcheck="false" placeholder="openrouter-key"/>
				if e := vm.FieldErr["name"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			<div class="field">
				<label for={ "sec-desc-" + vmKey(vm.User) }>{ i18n.T(ctx, "Descrição (opcional)") }</label>
				<input class="input" id={ "sec-desc-" + vmKey(vm.User) } name="description" value={ vm.Description } maxlength="300"/>
			</div>
		</div>
		if !vm.User && len(collections) > 0 {
			<div class="field">
				<label for="sec-col">{ i18n.T(ctx, "Coleção") }</label>
				<select class="select" id="sec-col" name="collection">
					for _, c := range collections {
						<option value={ c } selected?={ c == vm.Collection || vm.Collection == "" && c == domain.DefaultCollectionName }>{ c }</option>
					}
				</select>
				<span class="hint">{ i18n.T(ctx, "Quem alcança a coleção usa o segredo. Sem escolha, o segredo entra na padrão.") }</span>
			</div>
		}
		<div class="field">
			<label for={ "sec-val-" + vmKey(vm.User) }>{ i18n.T(ctx, "Valor") }</label>
			<input class="input mono" id={ "sec-val-" + vmKey(vm.User) } name="value" type="password" value="" autocomplete="new-password" spellcheck="false" maxlength="8192"/>
			<span class="hint">{ i18n.T(ctx, "O valor é cifrado e nunca volta para a tela. Em branco com a opção abaixo, o Hanko gera um e o mostra uma única vez.") }</span>
			if e := vm.FieldErr["value"]; e != "" {
				<span class="err">{ e }</span>
			}
		</div>
		<label class="check-line">
			<input type="checkbox" name="generate" value="1" checked?={ vm.Generate }/>
			<span>{ i18n.T(ctx, "Gerar o valor e mostrá-lo uma vez") }</span>
		</label>
		@genOptionsFields()
		if vaultOn {
			<div class="form-grid">
				<div class="field">
					<label for={ "sec-prov-" + vmKey(vm.User) }>{ i18n.T(ctx, "Onde mora o valor") }</label>
					<select class="select" id={ "sec-prov-" + vmKey(vm.User) } name="provider">
						<option value="local" selected?={ vm.Provider != "vault" }>{ i18n.T(ctx, "Cifrado no Hanko") }</option>
						<option value="vault" selected?={ vm.Provider == "vault" }>{ i18n.T(ctx, "Cofre externo (lido a cada execução)") }</option>
					</select>
				</div>
				<div class="field">
					<label for={ "sec-ext-" + vmKey(vm.User) }>{ i18n.T(ctx, "Referência no cofre (caminho#campo)") }</label>
					<input class="input mono" id={ "sec-ext-" + vmKey(vm.User) } name="external_ref" value={ vm.ExternalRef } maxlength="500" autocomplete="off" spellcheck="false" placeholder="apps/hanko#token"/>
					if e := vm.FieldErr["external_ref"]; e != "" {
						<span class="err">{ e }</span>
					}
				</div>
			</div>
		}
		<div class="form-actions">
			<button class="btn primary" type="submit">{ i18n.T(ctx, "Criar segredo") }</button>
		</div>
	</form>
}

func vmKey(user bool) string {
	if user {
		return "u"
	}
	return "c"
}

templ secretTable(rows []SecretRowVM, admin bool) {
	<div class="table-wrap mb-6">
		<table class="table">
			<thead>
				<tr>
					<th>{ i18n.T(ctx, "Nome") }</th>
					<th class="hide-sm">{ i18n.T(ctx, "Onde mora") }</th>
					<th class="num">{ i18n.T(ctx, "Versão") }</th>
					<th class="hide-sm">{ i18n.T(ctx, "Usado por") }</th>
					<th class="hide-sm">{ i18n.T(ctx, "Último uso") }</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr class="row">
						<td>
							<b>{ r.Name }</b>
							<div class="sub-line"><code class="mono">{ r.Reference }</code></div>
							if r.Description != "" {
								<div class="sub-line">{ r.Description }</div>
							}
						</td>
						<td class="hide-sm">
							if r.Provider == "vault" {
								<span class="badge outline">{ i18n.T(ctx, "cofre externo") }</span>
								<div class="sub-line mono">{ r.ExternalRef }</div>
							} else {
								<span class="badge done">{ i18n.T(ctx, "cifrado") }</span>
							}
						</td>
						<td class="num">{ fmt.Sprint(r.Version) }</td>
						<td class="hide-sm">
							if len(r.UsedBy) == 0 {
								<span class="faint">—</span>
							} else {
								<span class="text-sm">{ strings.Join(r.UsedBy, ", ") }</span>
							}
						</td>
						<td class="hide-sm muted">{ r.LastUsed }</td>
						<td>
							<a class="btn outline sm" href={ templ.SafeURL(r.FieldsHref) }>{ i18n.T(ctx, "Campos") }</a>
							if admin {
								<details class="sec-actions">
									<summary class="btn outline sm">{ i18n.T(ctx, "Ações") }</summary>
									<form method="post" action={ templ.SafeURL(r.RotateHref) } hx-boost="true" class="mt-2">
										<input class="input mono" name="value" type="password" autocomplete="new-password" placeholder={ i18n.T(ctx, "novo valor") } maxlength="8192"/>
										<label class="check-line"><input type="checkbox" name="generate" value="1"/><span>{ i18n.T(ctx, "gerar") }</span></label>
										@genOptionsFields()
										if r.Provider == "vault" {
											<input class="input mono" name="external_ref" value={ r.ExternalRef } maxlength="500"/>
											<input type="hidden" name="provider" value="vault"/>
										}
										<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Rotacionar") }</button>
									</form>
									if r.Provider != "vault" {
										<form method="post" action={ templ.SafeURL(r.RevealHref) } hx-boost="true" class="mt-2">
											<button class="btn outline sm" type="submit" disabled?={ r.Revealed }>{ i18n.T(ctx, "Revelar (uma vez)") }</button>
											if r.Revealed {
												<span class="hint">{ i18n.T(ctx, "Esta versão já foi revelada; rotacione para obter outra.") }</span>
											}
										</form>
									}
									<form method="post" action={ templ.SafeURL(r.DeleteHref) } hx-boost="true" class="mt-2">
										<label class="check-line"><input type="checkbox" name="force" value="1"/><span>{ i18n.T(ctx, "apagar mesmo em uso") }</span></label>
										<button class="btn outline sm danger" type="submit">{ i18n.T(ctx, "Apagar") }</button>
									</form>
								</details>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ SecretsPage(sh Shell, vm SecretsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Segredos"), i18n.T(ctx, "Credenciais cifradas da empresa. Use ${secret:NOME} nos headers e variáveis de integrações e no env da persona: o valor só é lido quando a execução é despachada e nunca aparece em log, atividade, exportação ou briefing.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		if !vm.KeySet {
			@Alert("danger", i18n.T(ctx, "O servidor não tem HANKO_SECRET_KEY: segredos cifrados no Hanko não podem ser criados (segredos de cofre externo ainda valem)."))
		}
		if vm.Reveal != nil {
			@revealBox(vm.Reveal.Name, vm.Reveal.Reference, vm.Reveal.Value)
		}
		<p class="mb-3"><a href={ templ.SafeURL(vm.CollectionsHref) }>{ i18n.T(ctx, "Coleções de segredos") }</a> · <a href={ templ.SafeURL(vm.HealthHref) }>{ i18n.T(ctx, "Saúde dos segredos") }</a>
			if sh.CanAdmin() {
				· <a href={ templ.SafeURL(vm.ImportEnvHref) }>{ i18n.T(ctx, "Importar .env") }</a> · <a href={ templ.SafeURL(vm.VaultFileHref) }>{ i18n.T(ctx, "Cofre cifrado (.hkv)") }</a>
			}
		</p>
		<h2 class="side-h mt-2 mb-3">{ i18n.T(ctx, "Segredos da empresa") }</h2>
		if len(vm.Company) == 0 {
			@EmptyCard("lock", i18n.T(ctx, "Nenhum segredo."), i18n.T(ctx, "Crie um segredo e referencie-o por ${secret:NOME} em vez de colar a credencial em cada integração ou persona."), false)
		} else {
			@secretTable(vm.Company, sh.CanAdmin())
		}
		if sh.CanAdmin() {
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Novo segredo da empresa") }</h2>
			@secretForm(vm.Form, vm.Collections, vm.VaultOn)
		} else {
			@NeedRole(domain.MemberAdmin)
		}
		<h2 class="side-h sec-h">{ i18n.T(ctx, "Seus segredos pessoais") }</h2>
		<p class="muted text-sm mb-3">{ i18n.T(ctx, "Só você vê e usa estes segredos; nem os administradores da empresa os enxergam. Referência: ${secret:user/NOME}.") }</p>
		if !vm.UserOK {
			<p class="muted">{ i18n.T(ctx, "Segredos pessoais exigem uma pessoa autenticada.") }</p>
		} else {
			if len(vm.User) > 0 {
				@secretTable(vm.User, true)
			}
			@secretForm(vm.UForm, nil, vm.VaultOn)
		}
	}
}

templ settingRow(r SettingRowVM) {
	<tr class="row">
		<td>
			<b>{ r.Label }</b>
			<div class="sub-line"><code class="mono">{ r.Key }</code></div>
			if r.Help != "" {
				<div class="sub-line">{ r.Help }</div>
			}
		</td>
		<td>
			if r.Locked {
				<span class="mono">{ r.Value }</span>
				<div class="sub-line"><span class="badge warn">{ i18n.Tf(ctx, "travada por %s", r.Env) }</span></div>
			} else {
				<form method="post" action={ templ.SafeURL(r.Action) } hx-boost="true" class="inline-form">
					if r.Kind == "bool" {
						<select class="select" name="value" aria-label={ r.Label }>
							<option value="true" selected?={ r.BoolOn }>{ i18n.T(ctx, "ligado") }</option>
							<option value="false" selected?={ !r.BoolOn }>{ i18n.T(ctx, "desligado") }</option>
						</select>
					} else {
						<input class="input mono" name="value" value={ r.Input } aria-label={ r.Label } autocomplete="off" spellcheck="false"/>
					}
					<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Salvar") }</button>
				</form>
			}
		</td>
		<td class="hide-sm"><span class="badge outline">{ r.SourceTxt }</span></td>
		<td>
			if r.Stored && !r.Locked {
				<form method="post" action={ templ.SafeURL(r.ClearHref) } hx-boost="true">
					<button class="btn outline sm" type="submit">{ i18n.T(ctx, "Voltar ao padrão") }</button>
				</form>
			}
		</td>
	</tr>
}

templ InstancePage(sh Shell, vm InstanceVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Instância"), i18n.T(ctx, "Configurações da instalação que não são segredos. A variável de ambiente, quando definida, vence o valor daqui e trava o campo. Segredos e chaves só existem no ambiente do servidor.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		if vm.Notice != "" {
			@Alert("warn", vm.Notice)
		}
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		if vm.Forbidden {
			@EmptyCard("lock", i18n.T(ctx, "Só o dono da instalação."), i18n.T(ctx, "Estas configurações valem para a instalação inteira, não para uma empresa."), false)
		} else {
			for _, g := range vm.Groups {
				<h2 class="side-h mt-2 mb-3">{ g.Title }</h2>
				<div class="table-wrap mb-6">
					<table class="table">
						<thead><tr><th>{ i18n.T(ctx, "Configuração") }</th><th>{ i18n.T(ctx, "Valor") }</th><th class="hide-sm">{ i18n.T(ctx, "Origem") }</th><th></th></tr></thead>
						<tbody>
							for _, r := range g.Rows {
								@settingRow(r)
							}
						</tbody>
					</table>
				</div>
			}
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Armazenamento de artefatos") }</h2>
			<p class="muted text-sm mb-3">{ vm.BlobNote }</p>
			<div class="table-wrap mb-6">
				<table class="table mini">
					<thead><tr><th>Driver</th><th class="num">{ i18n.T(ctx, "Versões") }</th><th class="num">{ i18n.T(ctx, "Tamanho") }</th><th></th></tr></thead>
					<tbody>
						for _, b := range vm.Blobs {
							<tr>
								<td class="mono">{ b.Driver }</td>
								<td class="num">{ fmt.Sprint(b.Versions) }</td>
								<td class="num">{ b.Size }</td>
								<td>
									if b.Active {
										<span class="badge done">{ i18n.T(ctx, "ativo") }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<h2 class="side-h sec-h">{ i18n.T(ctx, "Histórico de mudanças") }</h2>
			if len(vm.Audit) == 0 {
				<p class="muted">{ i18n.T(ctx, "Nenhuma mudança registrada.") }</p>
			} else {
				<div class="table-wrap">
					<table class="table mini">
						<thead><tr><th>{ i18n.T(ctx, "Quando") }</th><th>{ i18n.T(ctx, "Chave") }</th><th>{ i18n.T(ctx, "Antes") }</th><th>{ i18n.T(ctx, "Depois") }</th><th class="hide-sm">{ i18n.T(ctx, "Autor") }</th></tr></thead>
						<tbody>
							for _, a := range vm.Audit {
								<tr><td class="muted">{ a.When }</td><td class="mono">{ a.Key }</td><td class="mono">{ a.Old }</td><td class="mono">{ a.New }</td><td class="hide-sm">{ a.Actor }</td></tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}
