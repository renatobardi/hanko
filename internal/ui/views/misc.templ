package views

import (
	"github.com/renatobardi/hanko/internal/i18n"
)

templ OnboardingPage(vm OnboardingVM, version string) {
	@Bare(i18n.T(ctx, "Bem-vindo"), version) {
		<div class="auth wide">
			<div class="mark">
				@Mark(40)
				<b>Hanko</b>
			</div>
			<form class="card" method="post" action="/empresas" hx-boost="true">
				<h1>{ i18n.T(ctx, "Criar empresa") }</h1>
				<p class="sub muted">{ i18n.T(ctx, "A empresa isola personas, tasks e execuções. Dá para criar outras depois.") }</p>
				if vm.Error != "" {
					@Alert("danger", vm.Error)
				}
				<div class="field">
					<label for="c-name">{ i18n.T(ctx, "Nome da empresa") }</label>
					<input class="input" id="c-name" name="name" value={ vm.Name } required maxlength="80" placeholder="Hanko" autofocus/>
				</div>
				<div class="field">
					<label for="c-prefix">{ i18n.T(ctx, "Prefixo das tasks") }</label>
					<input class="input uppercase" id="c-prefix" name="prefix" value={ vm.TaskPrefix } maxlength="10" placeholder={ i18n.T(ctx, "HNK") }/>
					<span class="hint">{ i18n.T(ctx, "As tasks viram HNK-1, HNK-2…") }</span>
				</div>
				<button class="btn primary block" type="submit">{ i18n.T(ctx, "Criar empresa e continuar") }</button>
			</form>
			if cs := switcherFrom(ctx).Companies; len(cs) > 0 {
				<div class="foot co-back">
					<span>{ i18n.T(ctx, "Ou volte para uma empresa:") }</span>
					for _, c := range cs {
						<a href={ templ.SafeURL("/c/" + c.Slug + "/") }>{ c.Name }</a>
					}
				</div>
			}
			<div class="foot"><span>{ i18n.T(ctx, "Hanko · control plane de personas de IA") }</span></div>
			@LangSwitch()
		</div>
	}
}

// NoCompanyPage is what a signed-in person sees when they belong to no company and cannot create one
// (in authenticated mode only the installation owner/admin creates companies).
templ NoCompanyPage(version string) {
	@Bare(i18n.T(ctx, "Bem-vindo"), version) {
		<div class="auth wide">
			<div class="mark">
				@Mark(40)
				<b>Hanko</b>
			</div>
			<div class="card">
				<h1>{ i18n.T(ctx, "Você ainda não participa de nenhuma empresa") }</h1>
				<p class="sub muted">{ i18n.T(ctx, "Peça um convite a quem administra a empresa e abra o link recebido para entrar.") }</p>
				<form method="post" action="/sair">
					<button class="btn outline block" type="submit">{ i18n.T(ctx, "Sair") }</button>
				</form>
			</div>
			<div class="foot"><span>{ i18n.T(ctx, "Hanko · control plane de personas de IA") }</span></div>
			@LangSwitch()
		</div>
	}
}

templ ErrorPage(sh Shell, vm ErrorVM) {
	@Layout(sh) {
		@errorBody(vm)
	}
}

templ ErrorBare(vm ErrorVM, version string) {
	@Bare(vm.Title, version) {
		<div class="w-full maxw-lg">
			@errorBody(vm)
		</div>
	}
}

templ errorBody(vm ErrorVM) {
	<div class="soon-box">
		@EmptyCard("alert", vm.Title, vm.Message, true) {
			if vm.Back != "" {
				<a class="btn outline" href={ templ.SafeURL(vm.Back) }>{ i18n.T(ctx, "Voltar") }</a>
			}
		}
	</div>
}

// ErrorFragment is what htmx requests receive for a failed action.
templ ErrorFragment(vm ErrorVM) {
	<div class="alert danger" role="alert">
		@Icon("alert")
		<div><b>{ vm.Title }</b> { vm.Message }</div>
	</div>
}

templ SoonPage(sh Shell, vm SoonVM) {
	@Layout(sh) {
		<div class="soon-box">
			@EmptyCard("clock", vm.Label+" · "+i18n.T(ctx, "em breve"), vm.Blurb, true) {
				<span class="badge soft">{ i18n.T(ctx, "Previsto para") } { vm.Milestone }</span>
				<a class="btn outline" href={ templ.SafeURL(sh.Base() + "/") }>{ i18n.T(ctx, "Voltar ao painel") }</a>
			}
		</div>
	}
}
