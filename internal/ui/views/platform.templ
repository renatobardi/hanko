package views

import (
	"fmt"
	"strings"

	"github.com/renatobardi/hanko/internal/i18n"
)

templ envCheckRow(c EnvCheck) {
	<li class={ "env-check", templ.KV("ok", c.OK) }>
		<span class="ec-ico">
			if c.OK {
				@Icon("check")
			} else {
				@Icon("x")
			}
		</span>
		<span class="ec-l">{ c.Label }</span>
		<span class="ec-d mono">{ c.Detail }</span>
	</li>
}

templ EnvironmentsPage(sh Shell, vm EnvironmentsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Ambientes de execução"), i18n.T(ctx, "Onde as personas rodam. Nesta instalação, cada execução é um processo filho no próprio servidor, dentro de um workspace.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<div class="grid-2 items-start">
			<section class="card pad">
				<div class="card-head">
					<div><h2>{ i18n.T(ctx, "Local · este servidor") }</h2><p class="sub">{ i18n.Tf(ctx, "%d de %d verificações ok", vm.OK, vm.Total) }</p></div>
					if vm.OK == vm.Total {
						<span class="badge done">{ i18n.T(ctx, "Pronto") }</span>
					} else {
						<span class="badge danger">{ i18n.T(ctx, "Com pendências") }</span>
					}
				</div>
				<ul class="env-checks">
					for _, c := range vm.Checks {
						@envCheckRow(c)
					}
				</ul>
			</section>
			<section class="card pad">
				<div class="card-head"><h2>{ i18n.T(ctx, "Configuração") }</h2></div>
				<dl class="kv">
					for _, f := range vm.Facts {
						<dt>{ f.K }</dt><dd>{ f.V }</dd>
					}
				</dl>
				<p class="muted mt-4 text-xs">{ i18n.T(ctx, "Os valores vêm das variáveis HANKO_* do servidor; mude no .env e reinicie. Ambientes remotos (SSH, sandbox) estão no roadmap.") }</p>
			</section>
		</div>
	}
}

templ AdaptersPage(sh Shell, vm AdaptersVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Adapters e modelos"), i18n.T(ctx, "Como o Hanko fala com cada harness de agente. Toda persona usa um adapter; o modelo vem da persona ou da task.")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<div class="table-wrap mb-6">
			<table class="table">
				<thead><tr><th>Adapter</th><th class="hide-sm">{ i18n.T(ctx, "Tipo") }</th><th>{ i18n.T(ctx, "Estado") }</th><th class="hide-sm">Personas</th></tr></thead>
				<tbody>
					for _, a := range vm.Rows {
						<tr class="row">
							<td>
								<span class="p-name"><span class="mini-avatar">@Icon("bot")</span><span class="pn"><b>{ a.Name }</b><span>{ a.Desc }</span></span></span>
								if a.Extra != "" {
									<div class="sub-line mt-1">{ a.Extra }</div>
								}
							</td>
							<td class="hide-sm"><span class="badge outline">{ a.Kind }</span></td>
							<td>
								<ul class="env-checks compact">
									@envCheckRow(a.Check)
								</ul>
							</td>
							<td class="hide-sm">
								if len(a.Personas) == 0 {
									<span class="faint">—</span>
								} else {
									<span class="text-sm">{ fmt.Sprint(len(a.Personas)) } · { strings.Join(a.Personas, ", ") }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<section class="card pad">
			<div class="card-head"><div><h2>{ i18n.T(ctx, "Tabela de preços") }</h2><p class="sub">{ i18n.T(ctx, "Por milhão de tokens (entrada / saída). Usada para estimar custos quando o harness não informa o valor.") }</p></div></div>
			if len(vm.Prices) == 0 {
				<p class="muted">{ i18n.T(ctx, "Sem preços cadastrados.") }</p>
			} else {
				<table class="table mini">
					<thead><tr><th>{ i18n.T(ctx, "Modelo") }</th><th class="num">{ i18n.T(ctx, "Entrada") }</th><th class="num">{ i18n.T(ctx, "Saída") }</th><th class="num hide-sm">{ i18n.T(ctx, "Desde") }</th></tr></thead>
					<tbody>
						for _, p := range vm.Prices {
							<tr><td class="mono">{ p.Model }</td><td class="num mono">{ p.In }</td><td class="num mono">{ p.Out }</td><td class="num hide-sm muted">{ p.Since }</td></tr>
						}
					</tbody>
				</table>
			}
		</section>
	}
}

templ PluginsPage(sh Shell, vm PluginsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Plugins e extensões"), i18n.T(ctx, "Os pontos de extensão desta instalação e o estado de cada um. Plugins de terceiros ainda não são suportados (roadmap).")) {
		}
		<div class="mb-6">@Tabs(vm.Sections)</div>
		<div class="grid-3 plugin-grid">
			for _, it := range vm.Items {
				<section class="card pad plugin-card">
					<div class="pc-head">
						<span class="mini-avatar lg">@Icon(it.Icon)</span>
						<div class="pc-t"><h2>{ it.Name }</h2><p class="sub">{ it.Desc }</p></div>
					</div>
					<ul class="env-checks compact mt-3">
						for _, c := range it.Checks {
							@envCheckRow(c)
						}
					</ul>
					if it.Href != "" {
						<div class="mt-3"><a class="btn outline sm" href={ templ.SafeURL(it.Href) }>{ i18n.T(ctx, "Abrir") }</a></div>
					}
				</section>
			}
		</div>
	}
}
