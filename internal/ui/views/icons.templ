package views

import "fmt"

// Icon draws a 24x24 line icon (stroke follows currentColor).
templ Icon(name string) {
	<svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
		switch name {
			case "search":
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			case "code":
				<path d="m16 18 6-6-6-6"></path>
				<path d="m8 6-6 6 6 6"></path>
			case "pen-line":
				<path d="M12 20h9"></path>
				<path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path>
			case "shield-check":
				<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
				<path d="m9 12 2 2 4-4"></path>
			case "cpu":
				<rect x="4" y="4" width="16" height="16" rx="2"></rect>
				<rect x="9" y="9" width="6" height="6" rx="1"></rect>
				<path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"></path>
			case "palette":
				<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path>
				<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
				<circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
				<circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
				<circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
			case "megaphone":
				<path d="m3 11 18-5v12L3 14v-3z"></path>
				<path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
			case "scale":
				<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
				<path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
				<path d="M7 21h10"></path>
				<path d="M12 3v18"></path>
				<path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
			case "book-open":
				<path d="M12 7v14"></path>
				<path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
			case "wrench":
				<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
			case "headphones":
				<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path>
			case "rocket":
				<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
				<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
				<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
				<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
			case "briefcase":
				<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
				<rect x="2" y="6" width="20" height="14" rx="2"></rect>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			case "layout-grid":
				<rect x="3" y="3" width="7" height="7" rx="1"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1"></rect>
				<rect x="14" y="14" width="7" height="7" rx="1"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1"></rect>
			case "mail":
				<rect x="2" y="4" width="20" height="16" rx="2"></rect>
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			case "message-square":
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
			case "circle-check":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="m9 12 2 2 4-4"></path>
			case "list":
				<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
			case "layers":
				<path d="m12 2 10 5-10 5L2 7z"></path>
				<path d="m2 17 10 5 10-5"></path>
				<path d="m2 12 10 5 10-5"></path>
			case "workflow":
				<rect x="3" y="3" width="8" height="8" rx="2"></rect>
				<path d="M7 11v4a2 2 0 0 0 2 2h4"></path>
				<rect x="13" y="13" width="8" height="8" rx="2"></rect>
			case "trending-up":
				<path d="m22 7-8.5 8.5-5-5L2 17"></path>
				<path d="M16 7h6v6"></path>
			case "file":
				<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"></path>
				<path d="M14 2v6h6"></path>
			case "git-branch":
				<path d="M6 3v12"></path>
				<circle cx="18" cy="6" r="3"></circle>
				<circle cx="6" cy="18" r="3"></circle>
				<path d="M18 9a9 9 0 0 1-9 9"></path>
			case "bot":
				<path d="M12 8V4H8"></path>
				<rect x="4" y="8" width="16" height="12" rx="2"></rect>
				<path d="M2 14h2M20 14h2M15 13v2M9 13v2"></path>
			case "network":
				<rect x="16" y="16" width="6" height="6" rx="1"></rect>
				<rect x="2" y="16" width="6" height="6" rx="1"></rect>
				<rect x="9" y="2" width="6" height="6" rx="1"></rect>
				<path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3M12 12V8"></path>
			case "sparkles":
				<path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z"></path>
			case "link":
				<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
				<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
			case "shield":
				<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
			case "activity":
				<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path>
			case "database":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
				<path d="M3 12a9 3 0 0 0 18 0"></path>
			case "clock":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 6v6l4 2"></path>
			case "panel-left":
				<rect x="3" y="3" width="18" height="18" rx="2"></rect>
				<path d="M9 3v18"></path>
			case "plus":
				<path d="M5 12h14M12 5v14"></path>
			case "chevron-right":
				<path d="m9 18 6-6-6-6"></path>
			case "chevron-down":
				<path d="m6 9 6 6 6-6"></path>
			case "settings":
				<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "alert":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
				<path d="M12 9v4M12 17h.01"></path>
			case "arrow-up":
				<path d="m5 12 7-7 7 7M12 19V5"></path>
			case "square":
				<rect x="4" y="4" width="16" height="16" rx="2"></rect>
			case "play":
				<path d="M6 3l14 9-14 9z"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "x":
				<path d="M18 6 6 18M6 6l12 12"></path>
			case "user":
				<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
				<circle cx="12" cy="7" r="4"></circle>
			case "lock":
				<rect x="3" y="11" width="18" height="11" rx="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
			case "log-out":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
				<path d="m16 17 5-5-5-5M21 12H9"></path>
			case "key":
				<circle cx="7.5" cy="15.5" r="4.5"></circle>
				<path d="m10.7 12.3 9.3-9.3M17 6l3 3M14 9l2 2"></path>
			case "menu":
				<path d="M4 12h16M4 6h16M4 18h16"></path>
			case "send":
				<path d="m5 12 7-7 7 7M12 19V5"></path>
			case "zap":
				<path d="M13 2 3 14h9l-1 8 10-12h-9z"></path>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}

// Mark is the 5-petal sakura brand mark.
templ Mark(size int) {
	<svg width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } viewBox="0 0 100 100" fill="none" aria-hidden="true" style="display:block;flex-shrink:0">
		for _, a := range []int{0, 72, 144, 216, 288} {
			<path d="M50,50 C38,43 33,27 39,15 C42,8 47,10 50,17 C53,10 58,8 61,15 C67,27 62,43 50,50 Z" transform={ fmt.Sprintf("rotate(%d 50 50)", a) } style="fill:var(--sakura-petal);stroke:var(--sakura-ink)" stroke-width="6" stroke-linejoin="round"></path>
		}
		for _, a := range []int{36, 108, 180, 252, 324} {
			<line x1="50" y1="50" x2="50" y2="34" transform={ fmt.Sprintf("rotate(%d 50 50)", a) } style="stroke:var(--sakura-ink)" stroke-width="3.3" stroke-linecap="round"></line>
			<circle cx="50" cy="33" r="3" transform={ fmt.Sprintf("rotate(%d 50 50)", a) } style="fill:var(--sakura-ink)"></circle>
		}
		<circle cx="50" cy="50" r="5.4" style="fill:var(--sakura-ink)"></circle>
	</svg>
}
