package views

import (
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ ChatRows(rows []ChatRow) {
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr>
					<th>{ i18n.T(ctx, "Conversa") }</th>
					<th class="hide-sm">Persona</th>
					<th>{ i18n.T(ctx, "Status") }</th>
					<th class="hide-sm num">{ i18n.T(ctx, "Custo") }</th>
					<th class="num hide-sm">{ i18n.T(ctx, "Última mensagem") }</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr class="row">
						<td class="ttl"><a href={ templ.SafeURL(r.Href) }>{ r.Title }</a></td>
						<td class="hide-sm"><a href={ templ.SafeURL(r.PersonaHref) }>@PersonaChip(r.Persona)</a></td>
						<td>@BadgeEl(r.Badge)</td>
						<td class="hide-sm num mono">{ r.Cost }</td>
						<td class="when hide-sm">{ r.Last }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ ChatsPage(sh Shell, vm ChatsVM) {
	@Layout(sh) {
		@PageHead(i18n.T(ctx, "Chat"), vm.Subtitle) {
		}
		if sh.CanWrite() {
			if vm.Empty {
				@EmptyCard("bot", i18n.T(ctx, "Nenhuma persona para conversar."), i18n.T(ctx, "Contrate uma persona para abrir uma conversa."), false) {
					<a class="btn primary sm" href={ templ.SafeURL(sh.Base() + "/personas/nova") }>{ i18n.T(ctx, "Contratar persona") }</a>
				}
			} else {
				<form class="card pad form-card mb-6" method="post" action={ templ.SafeURL(vm.NewAction) } hx-boost="true">
					<h2 class="side-h m-0 mb-1">{ i18n.T(ctx, "Nova conversa") }</h2>
					if vm.Error != "" {
						@Alert("danger", vm.Error)
					}
					<div class="field">
						<label for="c-persona">Persona</label>
						@Select("persona", "c-persona", vm.Personas, false)
					</div>
					<div class="field">
						<label for="c-msg">{ i18n.T(ctx, "Primeira mensagem") }</label>
						<textarea class="textarea" id="c-msg" name="message" rows="4" required placeholder={ i18n.T(ctx, "Pergunte ou peça algo à persona. Markdown.") }>{ vm.Message }</textarea>
						<span class="hint">{ i18n.T(ctx, "A persona responde por uma execução: o custo entra no orçamento dela.") }</span>
					</div>
					<div class="form-actions">
						<button class="btn primary" type="submit">
							@Icon("send")
							{ i18n.T(ctx, "Conversar") }
						</button>
					</div>
				</form>
			}
		} else {
			<p class="composer-ro">@NeedRole(domain.MemberMember)</p>
		}
		<div class="toolbar">
			@Tabs(vm.Tabs)
		</div>
		if len(vm.Rows) == 0 {
			@EmptyCard("message-square", i18n.T(ctx, "Nenhuma conversa aqui."), i18n.T(ctx, "As conversas com as personas aparecem aqui."), false)
		} else {
			@ChatRows(vm.Rows)
		}
	}
}

// ChatThread is the message list; while the persona answers it polls itself every two seconds and, once
// idle, is replaced by a version without the trigger.
templ ChatThread(vm ChatVM) {
	<div id="chat-thread" class="thread" aria-live="polite" if vm.Busy { hx-get={ vm.ThreadHref } hx-trigger="every 2s" hx-swap="outerHTML" }>
		if len(vm.Messages) == 0 {
			<p class="thread-empty">{ i18n.T(ctx, "Nenhuma mensagem ainda.") }</p>
		}
		for _, m := range vm.Messages {
			switch m.Kind {
				case "human":
					<div class="msg me">
						<div class="bubble"><div class="md">@templ.Raw(string(m.Body))</div></div>
						<div class="meta"><span>{ m.Author } · <time class="mono">{ m.When }</time></span></div>
					</div>
				case "system":
					<div class="run-sep">
						<span>
							{ m.Body }
							<time class="mono">{ m.When }</time>
							if m.RunHref != "" {
								· <a class="link-u fg" href={ templ.SafeURL(m.RunHref) }>{ i18n.T(ctx, "execução") }</a>
							}
						</span>
					</div>
				default:
					<div class="msg">
						<span class="mini-avatar">@PersonaGlyph(m.Author)</span>
						<div>
							<div class="meta"><b>{ m.Author }</b><time class="mono">{ m.When }</time>
								if m.RunHref != "" {
									<a class="link-u" href={ templ.SafeURL(m.RunHref) }>{ i18n.T(ctx, "execução") }</a>
								}
							</div>
							<div class="body md">@templ.Raw(string(m.Body))</div>
						</div>
					</div>
			}
		}
		if !vm.Busy && vm.Waiting > 0 {
			<div class="run-sep" role="status">
				<span>{ fmt.Sprintf(i18n.T(ctx, "Mensagens esperando resposta: %d. Envie uma nova mensagem para a persona recolhê-las."), vm.Waiting) }</span>
			</div>
		}
		if vm.Busy {
			<div class="msg typing" role="status">
				<span class="mini-avatar">@PersonaGlyph(vm.Persona)</span>
				<div class="meta">
					<b>{ vm.Persona }</b>
					<span class="badge run"><i class="pulse"></i>{ i18n.T(ctx, "pensando…") }</span>
					if vm.RunHref != "" {
						<a class="link-u" href={ templ.SafeURL(vm.RunHref) }>{ i18n.T(ctx, "Inspecionar") }</a>
					}
				</div>
			</div>
		}
	</div>
}

templ ChatComposer(vm ChatVM) {
	if !canWrite(ctx) {
		<p class="composer-ro">@NeedRole(domain.MemberMember)</p>
	} else if vm.Archived {
		<p class="composer-ro">{ i18n.T(ctx, "Conversa arquivada: reabra para continuar.") }</p>
	} else {
		<form
			class="composer"
			method="post"
			action={ templ.SafeURL(vm.SendHref) }
			hx-post={ vm.SendHref }
			hx-target="#chat-thread"
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful){this.reset();}"
		>
			if vm.Blocked != "" {
				@Alert("warn", vm.Blocked)
			}
			<textarea name="message" required placeholder={ i18n.T(ctx, "Escreva uma mensagem (markdown). Se a persona estiver respondendo, ela lê esta junto com a próxima.") } aria-label={ i18n.T(ctx, "Mensagem") }>{ vm.Draft }</textarea>
			<div class="row">
				<span class="hint">{ i18n.T(ctx, "Markdown · HTML é escapado") }</span>
				<button type="submit" class="btn primary sm" disabled?={ vm.Blocked != "" }>
					@Icon("send")
					{ i18n.T(ctx, "Enviar") }
				</button>
			</div>
		</form>
	}
}

templ ChatPage(sh Shell, vm ChatVM) {
	@Layout(sh) {
		@PageHead(vm.Title, "") {
			if canWrite(ctx) {
				<form method="post" action={ templ.SafeURL(vm.StatusHref) }>
					<button class="btn outline sm" type="submit">
						if vm.Archived {
							{ i18n.T(ctx, "Reabrir") }
						} else {
							{ i18n.T(ctx, "Arquivar") }
						}
					</button>
				</form>
			}
		}
		<div class="chips mb-4">
			<a class="chip" href={ templ.SafeURL(vm.PersonaHref) }>@PersonaGlyph(vm.Persona)<span>{ vm.Persona }</span></a>
			@BadgeEl(vm.Badge)
			<span class="chip soft">{ vm.Cost }</span>
		</div>
		if vm.Error != "" {
			@Alert("danger", vm.Error)
		}
		@ChatThread(vm)
		@ChatComposer(vm)
		if vm.Followups != nil {
			@ChatQueue(vm)
		}
	}
}

// ChatQueue is the follow-up queue of a conversation; it refreshes itself while the persona answers, unless an edit
// is open (a swap would throw the text away).
templ ChatQueue(vm ChatVM) {
	<div id="chat-queue" if vm.Busy { hx-get={ vm.QueueHref } hx-trigger="every 4s [!document.querySelector('#chat-queue details[open]')]" hx-swap="outerHTML" }>
		if len(vm.Followups.Items) > 0 || vm.Followups.Steer != nil {
			@FollowupPanel(*vm.Followups)
		}
	</div>
}
