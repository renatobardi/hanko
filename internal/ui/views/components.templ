package views

import (
	"context"
	"fmt"

	"github.com/renatobardi/hanko/internal/domain"
	"github.com/renatobardi/hanko/internal/i18n"
)

templ BadgeEl(b Badge) {
	<span class={ "badge " + b.Class }>
		if b.Live {
			<i class="pulse"></i>
		}
		{ b.Label }
	</span>
}

templ PageHead(title, sub string) {
	<div class="page-head">
		<div>
			<h1>{ title }</h1>
			if sub != "" {
				<p>{ sub }</p>
			}
		</div>
		<div class="tools">
			{ children... }
		</div>
	</div>
}

templ Kpi(icon, num, label string, warn bool) {
	<div class={ "kpi", templ.KV("warn", warn) }>
		<span class="ico">@Icon(icon)</span>
		<div>
			<div class="num">{ num }</div>
			<div class="lbl">{ label }</div>
		</div>
	</div>
}

templ EmptyCard(icon, title, text string, large bool) {
	<div class={ "card empty", templ.KV("lg", large) }>
		<span class="ico">@Icon(icon)</span>
		<h3>{ title }</h3>
		if text != "" {
			<p>{ text }</p>
		}
		<div class="actions">
			{ children... }
		</div>
	</div>
}

templ Alert(kind, text string) {
	<div class={ "alert " + kind } role={ alertRole(kind) }>
		@Icon("alert")
		<div>{ text }</div>
	</div>
}

func alertRole(kind string) string {
	if kind == "danger" {
		return "alert"
	}
	return "status"
}

templ PrioIcon(p, label string) {
	<span class={ "prio " + p } title={ label }>@Icon(prioIcon(p))</span>
}

// PersonaGlyph é o glifo da persona (Kubo DS: glifo de linha monocromático num círculo neutro), resolvido pelo nome.
templ PersonaGlyph(name string) {
	@Icon(personaIcon(ctx, name))
}

// PersonaSprite define um <symbol id="pg-…"> por glifo de persona, para SVGs que desenham a persona com
// <use href="#pg-…"> (organograma estático e a ilha React), sem repetir os desenhos.
templ PersonaSprite() {
	<svg class="svg-sprite" aria-hidden="true" focusable="false">
		for _, ic := range domain.PersonaIcons {
			<symbol id={ "pg-" + ic } viewBox="0 0 24 24">
				@iconPaths(ic)
			</symbol>
		}
	</svg>
}

// IconPicker é o seletor de glifo de persona: um radio por ícone do catálogo.
templ IconPicker(selected string) {
	<div class="icon-pick" role="radiogroup" aria-label={ i18n.T(ctx, "Ícone") }>
		for _, ic := range domain.PersonaIcons {
			<label title={ ic }>
				<input type="radio" name="icon" value={ ic } checked?={ ic == iconOrDefault(selected) } aria-label={ ic }/>
				<span class="ip">@Icon(ic)</span>
			</label>
		}
	</div>
}

templ PersonaChip(name string) {
	<span class="who">
		<span class="mini-avatar">@PersonaGlyph(name)</span>
		<span>{ name }</span>
	</span>
}

templ OwnerCell(name string) {
	if name == "" {
		<span class="who none"><span class="mini-avatar">@Icon("user")</span><span>{ i18n.T(ctx, "Sem dono") }</span></span>
	} else {
		@PersonaChip(name)
	}
}

templ Select(name, id string, opts []Option, small bool) {
	<select name={ name } id={ id } class={ "select", templ.KV("sm", small) }>
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}

templ Tabs(tabs []TabLink) {
	<div class="seg" role="tablist">
		for _, t := range tabs {
			<a href={ templ.SafeURL(t.Href) } aria-current?={ t.On } role="tab">
				{ t.Label }
				if t.Count > 0 {
					<span class="cnt">{ fmt.Sprint(t.Count) }</span>
				}
			</a>
		}
	</div>
}

// TaskTable is the grouped task list; it is also the htmx fragment for search/tabs.
templ TaskTable(vm TasksVM) {
	<div id="tasks-list">
		if vm.Total == 0 {
			@EmptyCard("list", emptyTasksTitle(ctx, vm), emptyTasksText(ctx, vm), true) {
				if canWrite(ctx) {
					<a class="btn outline" href={ templ.SafeURL(vm.NewHref) }>
						@Icon("plus")
						{ i18n.T(ctx, "Nova task") }
					</a>
				} else {
					@NeedRole(domain.MemberMember)
				}
			}
		} else if vm.Board {
			@TaskBoardEl(vm)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th class="hide-sm"></th>
							<th>ID</th>
							<th>{ i18n.T(ctx, "Título") }</th>
							<th class="hide-sm">Persona</th>
							<th class="hide-sm">{ i18n.T(ctx, "Projeto") }</th>
							<th>{ i18n.T(ctx, "Status") }</th>
							<th class="num hide-sm">{ i18n.T(ctx, "Atualizada") }</th>
						</tr>
					</thead>
					<tbody>
						for _, g := range vm.Groups {
							<tr class="group-row">
								<td colspan="7">
									@Icon("chevron-down")
									{ g.Label }<span class="cnt">· { fmt.Sprint(g.Count) }</span>
								</td>
							</tr>
							for _, r := range g.Rows {
								@TaskRowEl(r)
							}
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func emptyTasksTitle(ctx context.Context, vm TasksVM) string {
	if vm.Query != "" {
		return i18n.T(ctx, "Nada encontrado.")
	}
	return i18n.T(ctx, "Nenhuma task aqui.")
}

func emptyTasksText(ctx context.Context, vm TasksVM) string {
	if vm.Query != "" {
		return i18n.Tf(ctx, "Nenhuma task corresponde a “%s”. Tente outro termo.", vm.Query)
	}
	return i18n.T(ctx, "Crie uma task e atribua a uma persona para ver uma execução acontecer.")
}

// TaskBoardEl é o quadro de tasks (Kubo DS: colunas muted/50 em 2xl, cards pequenos, status pelo badge).
templ TaskBoardEl(vm TasksVM) {
	<div class="board" role="list" data-board>
		for _, c := range vm.Columns {
			<section class={ "board-col", "st-" + c.Status } role="listitem" aria-label={ c.Label } data-status={ c.Status }>
				<header class="board-h"><span>{ c.Label }</span><span class="cnt" data-count>{ fmt.Sprint(c.Count) }</span></header>
				<p class={ "board-empty", templ.KV("hidden", len(c.Rows) > 0) }>{ i18n.T(ctx, "Nada aqui.") }</p>
				for _, r := range c.Rows {
					<a class="board-card" href={ templ.SafeURL(r.Href) } draggable={ boolAttr(canWrite(ctx)) } data-task={ r.Key }>
						<span class="bc-top"><span class="id mono">{ r.Key }</span>@PrioIcon(r.Priority, r.PriorityLabel)</span>
						<span class="bc-t">{ r.Title }</span>
						<span class="bc-foot">
							if r.Persona != "" {
								<span class="who"><span class="mini-avatar">@PersonaGlyph(r.Persona)</span><span>{ r.Persona }</span></span>
							} else {
								<span class="who none">{ i18n.T(ctx, "Sem dono") }</span>
							}
							<span class="when">{ r.Updated }</span>
						</span>
					</a>
				}
			</section>
		}
	</div>
}

templ TaskRowEl(r TaskRow) {
	<tr class="row">
		<td class="hide-sm col-prio">@PrioIcon(r.Priority, r.PriorityLabel)</td>
		<td class="id">{ r.Key }</td>
		<td class="ttl">
			<a href={ templ.SafeURL(r.Href) }>{ r.Title }</a>
			if r.Note != "" {
				<span class="note"> · { r.Note }</span>
			}
		</td>
		<td class="hide-sm">@OwnerCell(r.Persona)</td>
		<td class="hide-sm muted">{ r.Project }</td>
		<td>@BadgeEl(r.Badge)</td>
		<td class="when hide-sm">{ r.Updated }</td>
	</tr>
}
