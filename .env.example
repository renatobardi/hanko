# Copie para .env (nunca commitar). Lido por `make dev` e por deploy/compose.yaml.

# --- Hanko ---
HANKO_VERSION=dev
HANKO_DATABASE_URL=postgres://hanko:hanko@127.0.0.1:5432/hanko?sslmode=disable
HANKO_ADDR=127.0.0.1:7420
# HANKO_PUBLIC_URL=http://127.0.0.1:7420   # URL pública (links, cookies, host permitido)
# HANKO_AGENT_URL=http://127.0.0.1:7420    # base que o agente (processo filho) usa para chamar /mcp; vazio = PUBLIC_URL. Em prd: loopback interno
HANKO_MODE=authenticated                    # padrão; trusted só para teste local descartável (ADR-0017)
HANKO_SECRET=                               # openssl rand -hex 32 (mínimo 32 bytes) ; vazio = gerado por boot
# HANKO_ALLOWED_HOSTS=hanko.local,10.0.0.5  # hosts extras aceitos no cabeçalho Host (421 nos demais); localhost e o host de HANKO_PUBLIC_URL já valem
# HANKO_WORKSPACES_ROOT=                    # raiz obrigatória dos workspaces (padrão $HOME/hanko-workspaces)
# HANKO_AGENT_ENV_ALLOW=GOPATH,MY_TOOL_*    # variáveis extras do servidor repassadas aos agentes (HANKO_* nunca passa)
# HANKO_ACP_ALLOW=false                     # liga o harness acp: a persona executa um comando nesta máquina (ADR-0023); padrão desligado
# HANKO_ACP_COMMANDS=meu-agente,/opt/a/agente # csv opcional: só estes executáveis (nome simples ou caminho absoluto)
HANKO_MIGRATE_ON_BOOT=true
HANKO_WORKERS=4
HANKO_RUN_TIMEOUT=30m
HANKO_HEARTBEAT_INTERVAL=1m
HANKO_LOG_LEVEL=info                        # debug | info | warn | error
HANKO_LOG_FORMAT=json                       # json | text
HANKO_CLAUDE_BIN=claude
HANKO_CODEX_BIN=codex
# HANKO_CONFIG=./hanko.yaml

# --- Autenticação (modo authenticated; docs/RUNBOOK.md §5) ---
# Exige HANKO_SECRET >= 32 bytes e HANKO_PUBLIC_URL https (exceto loopback).
HANKO_AUTH_PROVIDER=firebase                # local (e-mail/senha, argon2id) | firebase (Google + e-mail/senha)
HANKO_FIREBASE_PROJECT_ID=oute-sso          # provider firebase (valores públicos do app Web)
HANKO_FIREBASE_API_KEY=AIzaSyCh2NEff6X4ylSY1jtiFvuNe3fESMKZ5VE   # pública (app Web hanko, 1:94091103457:web:4fda1555740d59d0da3ba0)
HANKO_FIREBASE_AUTH_DOMAIN=oute-sso.firebaseapp.com
# HANKO_AUTH_ALLOWED_EMAILS=voce@exemplo.com   # csv; só entra quem estiver nas listas (vale também para sessões já abertas)
# HANKO_AUTH_ALLOWED_DOMAINS=exemplo.com       # csv
HANKO_AUTH_OWNER_EMAIL=renatobardicabral@gmail.com      # firebase: único e-mail que vira dono. Com HANKO_PUBLIC_URL público, lista de admissão OU
#                                              # este e-mail é obrigatório (o boot é recusado sem eles: o primeiro visitante viraria dono)
# HANKO_AUTH_WEB_BOOTSTRAP=false               # local: true libera o formulário "Criar conta de dono" em URL pública (padrão: só em loopback;
#                                              # senão use `hanko auth create-owner`)
# HANKO_TRUSTED_PROXIES=127.0.0.1/32,::1/128   # CIDRs cujo X-Forwarded-For vale (padrão: só loopback). Atrás do Caddy do compose, acrescente
#                                              # a sub-rede docker (docker network inspect <projeto>_hanko), ex.: 127.0.0.1/32,::1/128,172.18.0.0/16
# HANKO_TOKEN=hk_...                        # API key usada pela CLI (hanko auth token create)
# HANKO_OWNER_PASSWORD=                     # senha para `hanko auth create-owner` (ou via stdin)
# HANKO_CADDYFILE=Caddyfile.authenticated   # borda sem basic_auth quando o modo é authenticated

# --- Memória (ADR-0015) ---
HANKO_MEMORY_PROVIDER=ai-memory             # ai-memory | none
HANKO_MEMORY_URL=http://127.0.0.1:49374
HANKO_MEMORY_TOKEN=
# HANKO_MEMORY_READ_TOOL=                    # tool do ai-memory que lê uma página por caminho (diff das propostas de curadoria, ADR-0030)
AI_MEMORY_IMAGE=akitaonrails/ai-memory@sha256:FIXE_O_DIGEST_AQUI
AI_MEMORY_AUTH_TOKEN=                       # mesmo valor de HANKO_MEMORY_TOKEN

# --- OpenTelemetry (ADR-0013) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# --- Postgres do compose ---
POSTGRES_USER=hanko
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=hanko

# --- Borda TLS (profile edge) ---
HANKO_DOMAIN=hanko.oute.pro
# basic_auth da borda no modo trusted (Caddyfile padrão); não use com HANKO_CADDYFILE=Caddyfile.authenticated.
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'SENHA' ; no .env escape cada $ como $$
HANKO_EDGE_USER=
HANKO_EDGE_PASSWORD_HASH=
