# Copie para .env (nunca commitar). Lido por `make dev` e por deploy/compose.yaml.

# --- Hanko ---
HANKO_VERSION=dev
HANKO_DATABASE_URL=postgres://hanko:hanko@127.0.0.1:5432/hanko?sslmode=disable
HANKO_ADDR=127.0.0.1:7420
# HANKO_PUBLIC_URL=http://127.0.0.1:7420   # base que o agente usa para chamar /mcp
HANKO_MODE=trusted                          # trusted | authenticated (authenticated chega no M5)
HANKO_SECRET=                               # openssl rand -hex 32 (mínimo 32 bytes) ; vazio = gerado por boot
# HANKO_ALLOWED_HOSTS=hanko.local,10.0.0.5  # hosts extras aceitos no cabeçalho Host (421 nos demais); localhost e o host de HANKO_PUBLIC_URL já valem
# HANKO_WORKSPACES_ROOT=                    # raiz obrigatória dos workspaces (padrão $HOME/hanko-workspaces)
# HANKO_AGENT_ENV_ALLOW=GOPATH,MY_TOOL_*    # variáveis extras do servidor repassadas aos agentes (HANKO_* nunca passa)
HANKO_MIGRATE_ON_BOOT=true
HANKO_WORKERS=4
HANKO_RUN_TIMEOUT=30m
HANKO_HEARTBEAT_INTERVAL=1m
HANKO_LOG_LEVEL=info                        # debug | info | warn | error
HANKO_LOG_FORMAT=json                       # json | text
HANKO_CLAUDE_BIN=claude
HANKO_CODEX_BIN=codex
# HANKO_CONFIG=./hanko.yaml

# --- Memória (ADR-0015) ---
HANKO_MEMORY_PROVIDER=ai-memory             # ai-memory | none
HANKO_MEMORY_URL=http://127.0.0.1:49374
HANKO_MEMORY_TOKEN=
AI_MEMORY_IMAGE=akitaonrails/ai-memory@sha256:FIXE_O_DIGEST_AQUI
AI_MEMORY_AUTH_TOKEN=                       # mesmo valor de HANKO_MEMORY_TOKEN

# --- OpenTelemetry (ADR-0013) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# --- Postgres do compose ---
POSTGRES_USER=hanko
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=hanko

# --- Borda TLS (profile edge) ---
HANKO_DOMAIN=hanko.oute.pro
# basic_auth da borda até o M5 (obrigatórios com --profile edge).
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'SENHA' ; no .env escape cada $ como $$
HANKO_EDGE_USER=
HANKO_EDGE_PASSWORD_HASH=
